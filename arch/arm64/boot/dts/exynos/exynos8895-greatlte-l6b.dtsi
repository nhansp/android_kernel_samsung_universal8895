/*
 * The five camera CMUs (L6B 4.0) and SysMMUs (4.4); fimc_is is the only master
 * of CAM0/CAM1/ISP/DCP (4.5).
 */
&cmu_cam { status = "okay"; };
&cmu_isphq { status = "okay"; };
&cmu_isplp { status = "okay"; };
&cmu_dcam { status = "okay"; };
&cmu_srdz { status = "okay"; };
&sysmmu_cam0 { status = "okay"; };
&sysmmu_cam1 { status = "okay"; };
&sysmmu_isp { status = "okay"; };
&sysmmu_dcp { status = "okay"; };

/* FDT:8536-8541 and the vender/fimc_is_dvfs children FDT:8543-9130 verbatim (L6B 4.2) */
&fimc_is {
	pinctrl-names = "default", "release";
	pinctrl-0 = <&fimc_is_flash_is &fimc_is_mclk0_out &fimc_is_mclk1_out &fimc_is_mclk2_out &fimc_is_mclk3_out>;
	pinctrl-1;
	chain_config = <1>;
	status = "okay";

		/* FDT:8543-8610 */
		vender {
			rear_sensor_id = <0x20>;
			front_sensor_id = <0x1f>;
			rear_second_sensor_id = <0x21>;
			secure_sensor_id = <0xfe>;
			use_module_check;
			use_ois_hsi2c;
			use_ois;
			check_sensor_vendor;
			f_rom_power = <0x01>;
			max_camera_num = <0x04>;

			camera_info0 {
				isp = <0x00>;
				cal_memory = <0x01>;
				read_version = <0x00>;
				core_voltage = <0x01>;
				upgrade = <0x00>;
				fw_write = <0x00>;
				fw_dump = <0x00>;
				companion = <0x01>;
				ois = <0x01>;
				valid = <0x01>;
				dual_open = <0x00>;
			};

			camera_info1 {
				isp = <0x00>;
				cal_memory = <0x02>;
				read_version = <0x00>;
				core_voltage = <0x00>;
				upgrade = <0x00>;
				fw_write = <0x00>;
				fw_dump = <0x00>;
				companion = <0x01>;
				ois = <0x00>;
				valid = <0x01>;
				dual_open = <0x00>;
			};

			camera_info2 {
				isp = <0x00>;
				cal_memory = <0x01>;
				read_version = <0x00>;
				core_voltage = <0x00>;
				upgrade = <0x00>;
				fw_write = <0x00>;
				fw_dump = <0x00>;
				companion = <0x00>;
				ois = <0x01>;
				valid = <0x01>;
				dual_open = <0x01>;
			};

			camera_info3 {
				isp = <0x02>;
				cal_memory = <0x00>;
				read_version = <0x01>;
				core_voltage = <0x00>;
				upgrade = <0x00>;
				fw_write = <0x00>;
				fw_dump = <0x00>;
				companion = <0x00>;
				ois = <0x00>;
				valid = <0x01>;
				dual_open = <0x00>;
			};
		};
		/* FDT:8612-9130 */
		fimc_is_dvfs {

			table0 {
				desc = "dvfs table v0.0 for 12M/8M";
				default_int_cam = <0xa8750>;
				default_cam = <0xa8750>;
				default_mif = <0x1fefc8>;
				default_int = <0xa2d78>;
				default_i2c = <0x00>;
				default_hpg = <0x01>;
				front_preview_int_cam = <0xa3930>;
				front_preview_cam = <0x9eb10>;
				front_preview_mif = <0xf78f0>;
				front_preview_int = <0x1a1f8>;
				front_preview_i2c = <0x00>;
				front_preview_hpg = <0x01>;
				front_capture_int_cam = <0xa3930>;
				front_capture_cam = <0x9eb10>;
				front_capture_mif = <0xf78f0>;
				front_capture_int = <0x1a1f8>;
				front_capture_i2c = <0x00>;
				front_capture_hpg = <0x01>;
				front_video_int_cam = <0xa3930>;
				front_video_cam = <0x9eb10>;
				front_video_mif = <0xf78f0>;
				front_video_int = <0x1a1f8>;
				front_video_i2c = <0x00>;
				front_video_hpg = <0x01>;
				front_video_whd_int_cam = <0xa3930>;
				front_video_whd_cam = <0x9eb10>;
				front_video_whd_mif = <0xf78f0>;
				front_video_whd_int = <0x1a1f8>;
				front_video_whd_i2c = <0x00>;
				front_video_whd_hpg = <0x01>;
