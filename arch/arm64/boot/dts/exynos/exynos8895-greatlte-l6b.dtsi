		pinctrl-3 = <&comp_rst_out &vtcam_rst_out>;
		pinctrl-4;
		position = <0x01>;
		id = <0x00>;
		mclk_ch = <0x01>;
		sensor_i2c_ch = <0x01>;
		sensor_i2c_addr = <0x6a>;
		use_initial_ae;
		gpio_mclk = <&gpk0 0x01 0x01>;
		gpio_reset = <&gpc0 0x03 0x01>;
		gpio_prep_reset = <&gpc1 0x01 0x01>;
		status = "okay";

		af {
			product_name = <0x10>;
			i2c_addr = <0x18>;
			i2c_ch = <0x04>;
		};

		flash {
			product_name = <0x64>;
		};

		preprocessor {
			product_name = <0x03>;
			spi_channel = <0x01>;
			i2c_addr = <0x7a>;
			i2c_ch = <0x00>;
			dma_ch = <0x02>;
		};

		ois {
			product_name = <0x64>;
		};

		internal_vc {
			vc_list = <0x02 0x02 0x01>;
		};
	};

	/* FDT:11883-11921 */
	fimc-is_sensor_imx320@20 {
		compatible = "samsung,sensor-module-imx320";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_mclk1_out>;
		pinctrl-2 = <&fimc_is_mclk1_fn>;
		pinctrl-3 = <&vtcam_rst_out>;
		pinctrl-4;
		position = <0x01>;
		id = <0x01>;
		mclk_ch = <0x01>;
		sensor_i2c_ch = <0x01>;
