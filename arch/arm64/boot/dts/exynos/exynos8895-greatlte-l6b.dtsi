			i2c_ch = <0x04>;
		};

		flash {
			product_name = <0x64>;
		};

		preprocessor {
			product_name = <0x03>;
			spi_channel = <0x01>;
			i2c_addr = <0x7a>;
			i2c_ch = <0x00>;
			dma_ch = <0x02>;
		};

		ois {
			product_name = <0x64>;
		};

		internal_vc {
