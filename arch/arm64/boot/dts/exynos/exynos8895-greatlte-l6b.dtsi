		};

		flash {
			product_name = <0x64>;
		};

		preprocessor {
			product_name = <0x64>;
		};

		ois {
			product_name = <0x64>;
		};

		internal_vc {
		};
	};

	/* FDT:11923-11961 */
	fimc-is_sensor_3h1@6A {
		compatible = "samsung,sensor-module-3h1";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
