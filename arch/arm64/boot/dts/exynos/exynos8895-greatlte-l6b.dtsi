		pinctrl-3 = <&fimc_is_mclk0_fn>;
		pinctrl-4 = <&ois_rst_out &cam_rst_out &comp_rst_out>;
		pinctrl-5;
		position = <0x00>;
		id = <0x00>;
		mclk_ch = <0x00>;
		sensor_i2c_ch = <0x00>;
		sensor_i2c_addr = <0x5a>;
		gpio_mclk = <&gpk0 0x00 0x01>;
		gpio_reset = <&gpc0 0x04 0x01>;
		gpio_ois_reset = <&gpc1 0x00 0x01>;
		gpio_prep_reset = <&gpc1 0x01 0x01>;
		gpio_cam_af_2p8_en = <&gpf1 0x00 0x01>;
		gpio_camio_1p8_en = <&gpe7 0x07 0x01>;
		power_seq_id = <0x01>;
		status = "okay";

		af {
			product_name = <0x0c>;
			i2c_addr = <0x18>;
			i2c_ch = <0x01>;
		};

		flash {
			product_name = <0x03>;
			flash_first_gpio = <0x01>;
			flash_second_gpio = <0x02>;
		};

		preprocessor {
			product_name = <0x03>;
			spi_channel = <0x01>;
			i2c_addr = <0x7a>;
			i2c_ch = <0x00>;
			dma_ch = <0x02>;
		};

		ois {
			product_name = <0x02>;
			i2c_addr = <0x48>;
			i2c_ch = <0x01>;
		};

		internal_vc {
			vc_list = <0x02 0x02 0x01>;
		};
	};

	/* FDT:11741-11789 */
	fimc-is_sensor_3m3@5A {
		compatible = "samsung,sensor-module-3m3";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
