/*
 * Samsung Galaxy Note 8 (greatlte, SM-N950N) board DT, part "l6b":
 * L6B multimedia: MFC, camera, JPEG, scaler (L6B 4).
 *
 * Included at the end of exynos8895-greatlte.dts, after L0's nodes, in the merge
 * order of FULL_IMAGE_PLAN.md 2.2. Owner: WP-6B; no other work package edits this
 * file (plan 2.3 rule D1). A node that two parts both configure (&usi9, &usi10)
 * is written identically in both files: dtc lets the later file win on a differing
 * value, which gl-verify V-DUP reports as an error. L0's reserved-memory stays in
 * the .dts; carveout additions and flag changes are &label edits here (plan X-8).
 */

/*
 * Multimedia domains: BUS_COMPONENT_DRCG_EN at SYSREG + 0x200 is saved before
 * power-off and restored after power-on by the Exynos8895 PD row of each domain
 * (drivers/pmdomain/samsung/exynos-pm-domains.c exynos8895_pd_extra[]; the row
 * carries the 0x200 offset, the property is the bare phandle of pd-samsung.yaml).
 * Stock: PMUCAL_SAVE_RESTORE entries of S:drivers/soc/samsung/cal-if/exynos8895/
 * pmucal_local_exynos8895.h cam :111, dcam :186, g2d :345, isphq :399,
 * isplp :434, mfc :519, srdz :554 (L6B 4.0, 5.2.3).
 */
&pd_cam { samsung,sysreg = <&syscon_cam>; };
&pd_dcam { samsung,sysreg = <&syscon_dcam>; };
&pd_g2d { samsung,sysreg = <&syscon_g2d>; };
&pd_isphq { samsung,sysreg = <&syscon_isphq>; };
&pd_isplp { samsung,sysreg = <&syscon_isplp>; };
&pd_mfc { samsung,sysreg = <&syscon_mfc>; };
&pd_srdz { samsung,sysreg = <&syscon_srdz>; };

/*
 * CSIS D-PHY resets: bits 0-3 of SYSREG_CAM + 0x1050 (stock dphy_m4s4_csis0
 * "reg = <0x0 0x12C21050 0x4>", S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:
 * 4157-4192), written only from phy_power_on/off while a sensor holds pd_cam
 * (L6B 4.3, 5.2.4).
 */
&mipi_phy { samsung,cam0-sysreg = <&syscon_cam>; };

/* ==== l6b part: FIMC-IS2 camera (L6B 4.2-4.6, 5.6) ==== */

/* camera pin groups (L6B 2.1): stock samsung,pins/pin-function/pin-pud/pin-drv/pin-val of the cited FDT nodes */
&pinctrl_peric0 {
	/* FDT:1538-1546 */
	iris_en_out: iris-en-out-pins {
		samsung,pins = "gpe7-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
		samsung,pin-val = <0>;
	};

	/* FDT:1548-1556 */
	sub_cam_io_out: sub-cam-io-out-pins {
		samsung,pins = "gpe7-7";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
		samsung,pin-val = <0>;
	};

	/* FDT:1565-1573 */
	sub_cam_af_out: sub-cam-af-out-pins {
		samsung,pins = "gpf1-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_OUTPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
		samsung,pin-val = <0>;
	};
};

