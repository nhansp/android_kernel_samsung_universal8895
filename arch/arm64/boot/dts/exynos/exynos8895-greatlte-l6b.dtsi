/*
 * USI9 (hsi2c_24, iris) and USI11 (hsi2c_27/28): stock usi_mode "hsi2c0_hsi2c1"
 * (FDT:5049-5068); USI_MODE_I2C0_1 = 5 (A:include/dt-bindings/soc/
 * samsung,exynos-usi.h:17). USI10 (S2MPB02) is the l6b2 part.
 */
&usi9 { samsung,mode = <USI_MODE_I2C0_1>; status = "okay"; };
&usi11 { samsung,mode = <USI_MODE_I2C0_1>; status = "okay"; };

&hsi2c_1 {	/* FDT:5101-5140 */
	#address-cells = <1>;	/* not set on the ACK bus node */
	#size-cells = <0>;
	pinctrl-names = "default", "on_i2c", "off_i2c";
	pinctrl-0 = <&hsi2c1_bus_in>;
	pinctrl-1 = <&hsi2c1_bus>;
	pinctrl-2 = <&hsi2c1_bus_in>;
	clock-frequency = <400000>;	/* 0x61a80 */
	status = "okay";
	/* FDT:5122-5125 */
	fimc-is-preprocessor@3d {
		compatible = "samsung,fimc_is_i2c0";
		reg = <0x3d>;
	};
	/* FDT:5127-5132 */
	fimc-is-imx333@1a {
		compatible = "samsung,exynos5-fimc-is-cis-imx333";
		reg = <0x1a>;
		id = <0x00>;
		setfile = "setA";
	};
	/* FDT:5134-5139 */
	fimc-is-2l2@2d {
		compatible = "samsung,exynos5-fimc-is-cis-2l2";
		reg = <0x2d>;
		id = <0x00>;
		setfile = "setB";
	};
};

&hsi2c_2 {	/* FDT:5142-5176 */
	#address-cells = <1>;	/* not set on the ACK bus node */
	#size-cells = <0>;
	pinctrl-names = "default", "on_i2c", "off_i2c";
	pinctrl-0 = <&hsi2c2_bus_in>;
	pinctrl-1 = <&hsi2c2_bus>;
	pinctrl-2 = <&hsi2c2_bus_in>;
	clock-frequency = <400000>;	/* 0x61a80 */
	status = "okay";
	/* FDT:5163-5168 */
	fimc-is-actuator@c {
		compatible = "samsung,exynos5-fimc-is-actuator-ak7371";
		reg = <0x0c>;
		id = <0x00>;
		place = <0x00>;
	};
	/* FDT:5170-5175 */
	ois@24 {
		compatible = "samsung,exynos5-fimc-is-ois-rumbaS6";
		product_name = <0x02>;
		reg = <0x24>;
		id = <0x00 0x02>;
	};
};

&hsi2c_3 {	/* FDT:5178-5205 */
	#address-cells = <1>;	/* not set on the ACK bus node */
	#size-cells = <0>;
	pinctrl-names = "default", "on_i2c", "off_i2c";
	pinctrl-0 = <&hsi2c3_bus_in>;
	pinctrl-1 = <&hsi2c3_bus>;
	pinctrl-2 = <&hsi2c3_bus_in>;
	clock-frequency = <400000>;	/* 0x61a80 */
	status = "okay";
	/* FDT:5199-5204 */
	fimc-is-3m3@2d {
		compatible = "samsung,exynos5-fimc-is-cis-3m3";
		reg = <0x2d>;
		id = <0x02>;
		setfile = "default";
	};
};

&hsi2c_4 {	/* FDT:5207-5234 */
	#address-cells = <1>;	/* not set on the ACK bus node */
	#size-cells = <0>;
	pinctrl-names = "default", "on_i2c", "off_i2c";
	pinctrl-0 = <&hsi2c4_bus_in>;
	pinctrl-1 = <&hsi2c4_bus>;
	pinctrl-2 = <&hsi2c4_bus_in>;
	clock-frequency = <400000>;	/* 0x61a80 */
	status = "okay";
	/* FDT:5228-5233 */
	fimc-is-actuator@f {
		compatible = "samsung,exynos5-fimc-is-actuator-ak7371";
		reg = <0x0f>;
		id = <0x02>;
		place = <0x02>;
	};
};

&hsi2c_24 {	/* FDT:5707-5744 */
	#address-cells = <1>;	/* not set on the ACK bus node */
	#size-cells = <0>;
	pinctrl-names = "default";
	pinctrl-0 = <&hsi2c24_bus>;
	clock-frequency = <400000>;	/* 0x61a80 */
	status = "okay";
	/* FDT:5725-5743 */
	fimc-is-secure@10 {
		compatible = "samsung,sensor-module-5e6";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_mclk3_out>;
		pinctrl-2 = <&fimc_is_mclk3_fn>;
		pinctrl-3 = <&iris_en_out &iris_rst_out>;
		pinctrl-4;
		position = <0x01>;
		reg = <0x10>;
		id = <0x03>;
		mclk_ch = <0x03>;
		hw_version = <0x01>;
		power_seq_id = <0x01>;
		gpio_mclk = <&gpk0 0x03 0x01>;
		gpio_reset = <&gpc1 0x04 0x01>;
		gpio_iris_en = <&gpe7 0x03 0x01>;
		status = "okay";
	};
};

&hsi2c_27 {	/* FDT:5981-6015 */
	#address-cells = <1>;	/* not set on the ACK bus node */
	#size-cells = <0>;
	pinctrl-names = "default", "on_i2c", "off_i2c";
	pinctrl-0 = <&hsi2c27_bus_in>;
	pinctrl-1 = <&hsi2c27_bus>;
	pinctrl-2 = <&hsi2c27_bus_in>;
	clock-frequency = <400000>;	/* 0x61a80 */
	status = "okay";
	/* FDT:6002-6007 */
	fimc-is-imx320@10 {
		compatible = "samsung,exynos5-fimc-is-cis-imx320";
		reg = <0x10>;
		id = <0x00 0x01>;
		setfile = "default";
	};
	/* FDT:6009-6014 */
	fimc-is-3h1@35 {
		compatible = "samsung,exynos5-fimc-is-cis-3h1";
		reg = <0x35>;
		id = <0x00 0x01>;
		setfile = "default";
	};
};

&hsi2c_28 {	/* FDT:6017-6049 */
	#address-cells = <1>;	/* not set on the ACK bus node */
	#size-cells = <0>;
	pinctrl-names = "default", "on_i2c", "off_i2c";
	pinctrl-0 = <&hsi2c28_bus_in>;
	pinctrl-1 = <&hsi2c28_bus>;
	pinctrl-2 = <&hsi2c28_bus_in>;
	clock-frequency = <400000>;	/* 0x61a80 */
	status = "okay";
	/* FDT:6038-6043 */
	fimc-is-actuator@c {
		compatible = "samsung,exynos5-fimc-is-actuator-ak7372";
		reg = <0x0c>;
		id = <0x00 0x01>;
		place = <0x01>;
	};
	/* FDT:6045-6048 */
	front_eeprom@51 {
		compatible = "samsung,front-eeprom-i2c";
		reg = <0x51>;
	};
};

&spi_0 {	/* FDT:6196-6231 */
	#address-cells = <1>;	/* not set on the ACK bus node */
	#size-cells = <0>;
	pinctrl-names = "default", "spi_out", "spi_fn";
	pinctrl-0 = <&fimc_is_spi_pin0_out>;
	pinctrl-1 = <&fimc_is_spi_pin0_out>;
	pinctrl-2 = <&fimc_is_spi_pin0_fn>;
	cs-gpios = <&gpc3 1 GPIO_ACTIVE_LOW>;	/* stock controller-data cs-gpio cs-gpio = <&gpc3 0x01 0x00>; */
	num-cs = <1>;
	swap-mode;	/* FDT:6202; the FROM read goes out as 32-bit words (fimc_is_spi_read) */
	status = "okay";
	/* FDT:6214-6230 */
	fimc_is_spi_0@0 {
		compatible = "samsung,fimc_is_spi0";
		spi-max-frequency = <0x2faf080>;
		reg = <0x00>;
		pinctrl-names = "default", "ssn_out", "ssn_fn", "ssn_inpd", "ssn_inpu";
		pinctrl-0 = <&fimc_is_spi_ssn0_out>;
		pinctrl-1 = <&fimc_is_spi_ssn0_out>;
		pinctrl-2 = <&fimc_is_spi_ssn0_fn>;
		pinctrl-3 = <&fimc_is_spi_ssn0_inpd>;
		pinctrl-4 = <&fimc_is_spi_ssn0_inpu>;
		use_spi_pinctrl;
		controller-data {
			samsung,spi-feedback-delay = <0x01>;
		};
	};
};

&spi_1 {	/* FDT:6233-6266 */
	#address-cells = <1>;	/* not set on the ACK bus node */
	#size-cells = <0>;
	pinctrl-names = "default", "spi_out", "spi_fn";
	pinctrl-0 = <&fimc_is_spi_pin1_out>;
	pinctrl-1 = <&fimc_is_spi_pin1_out>;
	pinctrl-2 = <&fimc_is_spi_pin1_fn>;
	cs-gpios = <&gpc3 5 GPIO_ACTIVE_LOW>;	/* stock controller-data cs-gpio cs-gpio = <&gpc3 0x05 0x00>; */
	num-cs = <1>;
	swap-mode;	/* FDT:6239; the companion read/write use 32/16-bit words */
	status = "okay";
	/* FDT:6251-6265 */
	fimc_is_spi_1@0 {	/* stock "@1", reg = <0> */
		compatible = "samsung,fimc_is_spi1";
		spi-max-frequency = <0x2faf080>;
		reg = <0x00>;
		pinctrl-names = "default", "ssn_out", "ssn_fn";
		pinctrl-0 = <&fimc_is_comp_int_in &fimc_is_spi_ssn1_out>;
		pinctrl-1 = <&fimc_is_comp_int_in &fimc_is_spi_ssn1_out>;
		pinctrl-2 = <&fimc_is_comp_int_fn &fimc_is_spi_ssn1_fn>;
		use_spi_pinctrl;
		controller-data {
			samsung,spi-feedback-delay = <0x00>;
		};
	};
};

/* ==== l6b2 part: MFC v11 codec hook-up (L6B 4.1, 5.5) ==== */

/ {
	aliases {
		/*
		 * Stock mfc0 = "/mfc0@13CE0000" (FDT:4234). Required: the driver
		 * takes its id from this alias and fails probe without it; the id
		 * builds the node numbers (/dev/video6..9) and names
		 * (S:drivers/media/platform/exynos/mfc/s5p_mfc.c:981-990).
		 */
		mfc0 = &mfc;
	};
};

/* CMU_MFC: the codec and its SysMMUs take their gates from it (L6B 4.0, 4.1) */
&cmu_mfc { status = "okay"; };
&sysmmu_mfc0 { status = "okay"; };
&sysmmu_mfc1 { status = "okay"; };
&mfc { status = "okay"; };

/* ==== l6bcam part: ISP thermal trips and the camera cooling map (REQ-2B-L6B-2) ==== */

/*
 * The isp-thermal zone is interrupt driven (polling-delay = <0> on both the
 * zone and the TMU), so the trip temperatures below are the ECT ISP ranges 2 and
 * 3 of spec L2b 4.3: 100 degC = 15 fps, 105 degC = 5 fps
 * (work/full/spec-usbc/tmp/L2b/ect_thermal.txt:19-24, ISP block at sboot
 * 0x5097c: [2] lower=100 upper=104 max_freq=15, [3] lower=105 upper=109
 * max_freq=5); the hysteresis is stock's isp-alert2 (FDT:9697, 0x1388).
 * Range 4 (110 degC) is the zone's existing isp-crit trip, ranges 0 and 1
 * (60 fps = no limit) change no limit and are not added (spec L2b 4.3).
 *
 * DUPLICATE OF WP-L2B: the two trips are L2b's K-11 board-DT commit (spec L2b
 * 4.3, commit table row K-11, milestone MT), which is not in this base; they
 * are here because the cooling maps below cannot be written without them.
 * Identical to that commit - if it ever lands, drop these two nodes.
 */
&{/thermal-zones/isp-thermal} {
	trips {
		isp_t100: isp-100 {
			temperature = <100000>;	/* ECT ISP range 2 (15 fps), SB:0x5097c */
			hysteresis = <5000>;	/* FDT:9697 isp-alert2 */
			type = "active";
		};

		isp_t105: isp-105 {
			temperature = <105000>;	/* ECT ISP range 3 (5 fps), SB:0x5097c */
			hysteresis = <5000>;
			type = "active";
		};
	};

	/*
	 * The camera core's ISP cooling device (REQ-2B-L6B-2, state 1 = 15 fps,
	 * state 2 = 5 fps; lower = upper, so step_wise goes straight to the
	 * ECT limit, spec L2b V-17).
	 */
	cooling-maps {
		map-100 {
			trip = <&isp_t100>;
			cooling-device = <&fimc_is 1 1>;
		};

		map-105 {
			trip = <&isp_t105>;
			cooling-device = <&fimc_is 2 2>;
		};
	};
};
