&fimc_is_sensor0 { status = "okay"; };
&fimc_is_sensor1 { status = "okay"; };
&fimc_is_sensor2 { status = "okay"; };
&fimc_is_sensor3 { status = "okay"; };

/ {
	/* FDT:11561-11570 (stock "@14050000" has no reg) */
	fimc_is_preprocessor: fimc_is_preprocessor {
		compatible = "samsung,exynos8895-fimc-is-preprocessor";	/* stock "samsung,exynos5-fimc-is-preprocessor" */
		power-domains = <&pd_cam>;			/* FDT:11563 samsung,power-domain = <0x0f> */
		clocks = <&cmu_top CLK_DOUT_CMU_CIS_CLK2>;	/* FDT:11564-11565; MUX_CIS_CLK2 is a HWACG no-op */
		clock-names = "CIS_CLK2";
		scenario = <0>;
		id = <0>;
		mclk_ch = <2>;
	};

	/* FDT:11572-11577 */
	fimc_is_device_companion0 {
		compatible = "samsung,exynos5-fimc-is-device-companion0";
		id = <0x00>;
		product_name = <0x03>;
		gpio_pdaf = <&gpc0 0x00 0x01>;
	};

	/* FDT:11579-11584 */
	fimc_is_device_flash {
		compatible = "samsung,sensor-flash-s2mpb02";
		id = <0x00 0x02>;
		torch-gpio = <&gpc0 0x02 0x01>;
		flash-gpio = <&gpc0 0x01 0x01>;
	};

	/* sensor modules FDT:11586-11960 (gpio/pinctrl phandles -> labels) */
	/* FDT:11586-11632 */
	fimc-is_sensor_imx260@34 {
		compatible = "samsung,sensor-module-imx260";
		pinctrl-names = "pin0", "pin1", "pin2";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_flash_is &fimc_is_mclk0_out &fimc_is_mclk2_out>;
		pinctrl-2 = <&fimc_is_flash_is &fimc_is_mclk0_fn &fimc_is_mclk2_fn>;
		position = <0x00>;
		id = <0x00>;
		mclk_ch = <0x00>;
		sensor_i2c_ch = <0x00>;
		sensor_i2c_addr = <0x34>;
		gpio_mclk = <&gpk0 0x00 0x01>;
		gpio_reset = <&gpc0 0x04 0x01>;
		gpio_prep_reset = <&gpc1 0x01 0x01>;
		gpio_camio_1p8_en = <&gpe7 0x07 0x01>;
		status = "okay";

		af {
			product_name = <0x0c>;
			i2c_addr = <0x18>;
			i2c_ch = <0x02>;
		};

		flash {
			product_name = <0x03>;
			flash_first_gpio = <0x01>;
			flash_second_gpio = <0x02>;
		};

		preprocessor {
			product_name = <0x03>;
			spi_channel = <0x01>;
			i2c_addr = <0x7a>;
			i2c_ch = <0x00>;
			dma_ch = <0x02>;
		};

		ois {
			product_name = <0x02>;
			i2c_addr = <0x48>;
			i2c_ch = <0x01>;
		};

		internal_vc {
			vc_list = <0x02 0x02 0x01>;
		};
	};

	/* FDT:11634-11685 */
	fimc-is_sensor_imx333@34 {
		compatible = "samsung,sensor-module-imx333";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_flash_is &fimc_is_mclk0_out &fimc_is_mclk2_out>;
		pinctrl-2 = <&fimc_is_flash_is &fimc_is_mclk0_fn &fimc_is_mclk2_fn>;
		pinctrl-3 = <&ois_rst_out &cam_rst_out &comp_rst_out>;
		pinctrl-4;
		position = <0x00>;
		id = <0x00>;
		mclk_ch = <0x00>;
		sensor_i2c_ch = <0x00>;
		sensor_i2c_addr = <0x34>;
		gpio_mclk = <&gpk0 0x00 0x01>;
		gpio_reset = <&gpc0 0x04 0x01>;
		gpio_ois_reset = <&gpc1 0x00 0x01>;
		gpio_prep_reset = <&gpc1 0x01 0x01>;
		gpio_cam_af_2p8_en = <&gpf1 0x00 0x01>;
		gpio_camio_1p8_en = <&gpe7 0x07 0x01>;
		power_seq_id = <0x01>;
		status = "okay";

		af {
			product_name = <0x0c>;
			i2c_addr = <0x18>;
			i2c_ch = <0x01>;
		};

		flash {
			product_name = <0x03>;
			flash_first_gpio = <0x01>;
			flash_second_gpio = <0x02>;
		};

		preprocessor {
			product_name = <0x03>;
			spi_channel = <0x01>;
			i2c_addr = <0x7a>;
			i2c_ch = <0x00>;
			dma_ch = <0x02>;
		};

		ois {
			product_name = <0x02>;
			i2c_addr = <0x48>;
			i2c_ch = <0x01>;
		};

		internal_vc {
			vc_list = <0x02 0x02 0x01>;
		};
	};

	/* FDT:11687-11739 */
	fimc-is_sensor_2l2@5A {
		compatible = "samsung,sensor-module-2l2";
		pinctrl-names = "pin0", "pin1", "pin2", "pin3", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_flash_is &fimc_is_mclk0_out &fimc_is_mclk2_out>;
		pinctrl-2 = <&fimc_is_flash_is &fimc_is_mclk0_fn &fimc_is_mclk2_fn>;
		pinctrl-3 = <&fimc_is_mclk0_fn>;
		pinctrl-4 = <&ois_rst_out &cam_rst_out &comp_rst_out>;
		pinctrl-5;
		position = <0x00>;
		id = <0x00>;
		mclk_ch = <0x00>;
		sensor_i2c_ch = <0x00>;
		sensor_i2c_addr = <0x5a>;
		gpio_mclk = <&gpk0 0x00 0x01>;
		gpio_reset = <&gpc0 0x04 0x01>;
		gpio_ois_reset = <&gpc1 0x00 0x01>;
		gpio_prep_reset = <&gpc1 0x01 0x01>;
		gpio_cam_af_2p8_en = <&gpf1 0x00 0x01>;
		gpio_camio_1p8_en = <&gpe7 0x07 0x01>;
		power_seq_id = <0x01>;
		status = "okay";

		af {
			product_name = <0x0c>;
			i2c_addr = <0x18>;
			i2c_ch = <0x01>;
		};

		flash {
			product_name = <0x03>;
			flash_first_gpio = <0x01>;
			flash_second_gpio = <0x02>;
		};

		preprocessor {
			product_name = <0x03>;
			spi_channel = <0x01>;
			i2c_addr = <0x7a>;
			i2c_ch = <0x00>;
			dma_ch = <0x02>;
		};

		ois {
			product_name = <0x02>;
			i2c_addr = <0x48>;
			i2c_ch = <0x01>;
		};

		internal_vc {
			vc_list = <0x02 0x02 0x01>;
		};
	};

	/* FDT:11741-11789 */
	fimc-is_sensor_3m3@5A {
		compatible = "samsung,sensor-module-3m3";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_flash_is &fimc_is_mclk0_out &fimc_is_mclk2_out>;
		pinctrl-2 = <&fimc_is_flash_is &fimc_is_mclk0_fn &fimc_is_mclk2_fn>;
		pinctrl-3 = <&sub_cam_en_out &sub_cam_1p0_out &sub_cam_io_out &sub_cam_af_out &sub_cam_rst_out>;
		pinctrl-4;
		position = <0x02>;
		id = <0x02>;
		mclk_ch = <0x00>;
		sensor_i2c_ch = <0x02>;
		sensor_i2c_addr = <0x5a>;
		gpio_mclk = <&gpk0 0x00 0x01>;
		gpio_reset = <&gpc1 0x02 0x01>;
		gpio_ois_reset = <&gpc1 0x00 0x01>;
		gpio_camio_1p8_en = <&gpe7 0x07 0x01>;
		gpio_cam_1p0_en = <&gpe6 0x03 0x01>;
		gpio_cam_af_2p8_en = <&gpf1 0x00 0x01>;
		gpio_cam_2p8_en = <&gpc1 0x03 0x01>;
		power_seq_id = <0x01>;
		status = "okay";

		af {
			product_name = <0x11>;
			i2c_addr = <0x1e>;
			i2c_ch = <0x03>;
		};

		flash {
			product_name = <0x03>;
			flash_first_gpio = <0x01>;
			flash_second_gpio = <0x02>;
		};

		preprocessor {
			product_name = <0x64>;
		};

		ois {
			product_name = <0x02>;
			i2c_addr = <0x48>;
			i2c_ch = <0x01>;
		};

		internal_vc {
			vc_list = <0x01 0x01 0x00>;
		};
	};

	/* FDT:11791-11835 */
	fimc-is_sensor_imx320_c3@20 {
		compatible = "samsung,sensor-module-imx320-c3";
		pinctrl-names = "pin0", "pin1", "pin2", "default", "release";
		pinctrl-0;
		pinctrl-1 = <&fimc_is_mclk1_out &fimc_is_mclk2_out>;
