/*
 * Samsung Galaxy Note 8 (greatlte, SM-N950N) board DT, part "l5":
 * L5 display: DECON/DSIM/panel (L5 4).
 *
 * Included at the end of exynos8895-greatlte.dts, after L0's nodes, in the merge
 * order of FULL_IMAGE_PLAN.md 2.2. Owner: WP-L5; no other work package edits this
 * file (plan 2.3 rule D1). A node that two parts both configure (&usi9, &usi10)
 * is written identically in both files: dtc lets the later file win on a differing
 * value, which gl-verify V-DUP reports as an error. L0's reserved-memory stays in
 * the .dts; carveout additions and flag changes are &label edits here (plan X-8).
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>

/*
 * S2DOS03 display PMIC on hsi2c_16 (usi5), address 0x60 (spec/L5_display.md 4.8):
 * the panel rails vdd_ddi_1p6 (buck1), vdd_ddi_1p8 (ldo1), vdd_ddi_3p0 (ldo3),
 * all left on by S-Boot. ldo2 "HRM_1.8V_AP" and ldo4 "HRM_3.3V_AP" (FDT:5550-5560)
 * belong to the HRM sensor (L6) and are added by its layer through &s2dos03.
 */
&usi5 {
	samsung,mode = <USI_MODE_I2C0_1>;	/* FDT:5021-5026 usi_mode = "hsi2c0_hsi2c1" = SW_CONF 0x3 (S:drivers/soc/samsung/usi.c:20,37) */
	status = "okay";
};

&hsi2c_16 {
	#address-cells = <1>;			/* FDT:5510 */
	#size-cells = <0>;
	status = "okay";			/* FDT:5519; hsi2c_15 stays disabled, FDT:5502 */

	s2dos03: pmic@60 {
		compatible = "samsung,s2dos03";	/* vendor "samsung,s2dos03pmic" FDT:5522 */
		reg = <0x60>;			/* FDT:5523 */

		regulators {
			s2dos03_buck1: buck1 {
				regulator-name = "vdd_ddi_1p6";		/* FDT:5529 */
				regulator-min-microvolt = <1500000>;	/* FDT:5530 0x16e360 */
				regulator-max-microvolt = <1600000>;	/* FDT:5531 0x186a00 */
				regulator-boot-on;			/* FDT:5532 */
			};

			s2dos03_ldo1: ldo1 {
				regulator-name = "vdd_ddi_1p8";		/* FDT:5536 */
				regulator-min-microvolt = <1800000>;	/* FDT:5537 0x1b7740 */
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;			/* FDT:5539 */
			};

			s2dos03_ldo3: ldo3 {
				regulator-name = "vdd_ddi_3p0";		/* FDT:5543 */
				regulator-min-microvolt = <3000000>;	/* FDT:5544 0x2dc6c0 */
				regulator-max-microvolt = <3000000>;
				regulator-boot-on;			/* FDT:5546 */
			};
		};
	};
};

/*
 * S-Boot's "lcd_buffer" (spec/L5_display.md 4.1): it keeps 0xcc000000-0xcd400000
 * out of its DRAM test and scans its logo out of it; the framebuffer address it
 * passes on the command line is the same constant. no-map, and identity-mapped
 * for the DECON's IOMMU domain before translation is ever enabled
 * (A:drivers/iommu/of_iommu.c:206-270: IOMMU_RESV_DIRECT when iova == phys and
 * the length equals the region). soc@0 has one address and one size cell.
 */
&{/reserved-memory} {
	splash_mem: framebuffer@cc000000 {
		reg = <0x0 0xcc000000 0x1400000>;	/* SB:0xc9017a04 mov x1,#0xcc000000; SB:0xc9017a08 mov x2,#0xcd400000 */
		no-map;
		iommu-addresses = <&decon 0xcc000000 0x1400000>;
	};
};

/*
 * Simple-framebuffer over the live splash (spec/L5_display.md 4.2, stage 5a).
 * Disabled: the DRM driver owns the display in this image. It is the "keep
 * splash" kill switch of FULL_IMAGE_PLAN.md 3.3 (set it okay and disable the
 * DECON, the DSIM and the display System MMUs). reg, not memory-region, so
 * simplefb sizes the aperture as the 1440x2960x4 picture.
 */
&{/chosen} {
	#address-cells = <2>;
	#size-cells = <1>;
	ranges;

	framebuffer0: framebuffer@cc000000 {
		compatible = "simple-framebuffer";
		reg = <0x0 0xcc000000 (1440 * 2960 * 4)>;	/* SB:0xc9009fb4 mov w2,#-0x34000000 -> " s3cfb.bootloaderfb=0x%x" SB:0xc9088938 */
		width = <1440>;					/* FDT:10082 resolution = <0x5a0 0xb90> */
		height = <2960>;
		stride = <(1440 * 4)>;
		format = "a8r8g8b8";				/* vendor fb BGRA_8888 (S:drivers/video/fbdev/exynos/dpu/decon_core.c:4079) */
		power-domains = <&pd_dpu0>, <&pd_dpu1>;
		vddi3p0-supply = <&s2dos03_ldo3>;
		vddi1p8-supply = <&s2dos03_ldo1>;
		vddi1p6-supply = <&s2dos03_buck1>;
		status = "disabled";
	};
};

/*
 * Display pipeline (spec/L5_display.md 4.3-4.7): power domains, CMU_DPU0 (gate
 * policy of L5 4.9 in its driver), MIPI D-PHY, the three display System MMUs,
 * DECON0, DSIM0 and the S6E3HA6 panel.
 */
&pd_dpu0 { status = "okay"; };
&pd_dpu1 { status = "okay"; };
&cmu_dpu0 { status = "okay"; };
&mipi_phy { status = "okay"; };
&sysmmu_dpu0 { status = "okay"; };
&sysmmu_dpu1 { status = "okay"; };
&sysmmu_dpu2 { status = "okay"; };

/* DECON0 TE input gpb0-1: EINT while the display is on, input when off (FDT:2924-2936) */
&pinctrl_peric1 {
	decon_f_te_on: decon-f-te-on-pins {
		samsung,pins = "gpb0-1";				/* FDT:2925 */
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;		/* FDT:2926 <0x0f> */
	};

	decon_f_te_off: decon-f-te-off-pins {
		samsung,pins = "gpb0-1";				/* FDT:2932 */
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;		/* FDT:2933 <0x00> */
	};
};

&decon {
	memory-region = <&splash_mem>;		/* its iommu-addresses: identity map of the splash */
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&decon_f_te_on>;		/* vendor "hw_te_on" FDT:7534-7535 */
	pinctrl-1 = <&decon_f_te_off>;		/* vendor "hw_te_off" FDT:7536 */
	status = "okay";

	/*
	 * CAM running status for the hibernation enter check (stock "cam-stat"
	 * child of decon_f, FDT:7555-7557, S:drivers/video/fbdev/exynos/dpu/
	 * decon_core.c:3869-3876; PMU bit, always readable): hibernation
	 * engages only with bits [3:0] clear. The unit address silences
	 * unit_address_vs_reg; of_get_child_by_name() ignores it.
	 */
	cam-stat@16484024 {
		reg = <0x00 0x16484024 0x04>;
	};
};

/* DSIM0 link values of the panel's DDI node (FDT:10079-10114) */
&dsi {
	samsung,burst-clock-frequency = <898000000>;	/* FDT:10087 timing,dsi-hs-clk = <0x382> */
	samsung,esc-clock-frequency = <20000000>;	/* FDT:10089 timing,dsi-escape-clk = <0x14> */
	samsung,cmd-underrun-lp-ref = <0xbce>;		/* FDT:10099 cmd_underrun_lp_ref = <0xbce> */
	status = "okay";

	ports {
		port@1 {
			reg = <1>;

			dsi_to_panel: endpoint {
				remote-endpoint = <&panel_from_dsi>;
				data-lanes = <1 2 3 4>;		/* FDT:10098 data_lane = <0x04> */
			};
		};
	};

	/* labelled for the touch panel follower (L6F REQ-L5-F1) */
	panel: panel@0 {
		compatible = "samsung,s6e3ha6";
		reg = <0>;					/* virtual channel 0 (S:drivers/video/fbdev/exynos/dpu/dsim_reg.c:1354) */
		reset-gpios = <&gpa0 5 GPIO_ACTIVE_LOW>;	/* FDT:11986 gpio,lcd-reset = <0x90 0x05 0x01> */
		disp-det-gpios = <&gpi1 1 GPIO_ACTIVE_HIGH>;	/* FDT:11987 gpio,disp-det = <0x8a 0x01 0x00> */
		te-gpios = <&gpb0 1 GPIO_ACTIVE_HIGH>;		/* vendor DECON gpios = <gpb0 1 0xf> FDT:7549 */
		vddi3p0-supply = <&s2dos03_ldo3>;		/* FDT:11988 "vdd_ddi_3p0" */
		vddi1p8-supply = <&s2dos03_ldo1>;		/* FDT:11989 "vdd_ddi_1p8" */
		vddi1p6-supply = <&s2dos03_buck1>;		/* FDT:11990 "vdd_ddi_1p6" */
		width-mm = <71>;				/* FDT:10083 size = <0x47 0x91> */
		height-mm = <145>;

		port {
			panel_from_dsi: endpoint {
				remote-endpoint = <&dsi_to_panel>;
			};
		};
	};
};

/*
 * The panel's SPI port, bit-banged on gpe5 (spi_gpio + panel_spi@0,
 * FDT:10268-10284; L5 9.4 e, l5-ext DESIGN 2.2): the vendor COPR reads go
 * over it. The vendor gpio-sck/gpio-miso/gpio-mosi properties are the 6.18
 * spi-gpio binding's sck-/miso-/mosi-gpios; gpe5 = phandle 0x58 (FDT:2062-2069),
 * flags 0 = active high. hsi2c13/14, the other users of gpe5-0..3, are
 * disabled (FDT:5468, 5485).
 */
/ {
	spi_gpio: spi {
		compatible = "spi-gpio";
		#address-cells = <1>;
		#size-cells = <0>;
		sck-gpios = <&gpe5 3 GPIO_ACTIVE_HIGH>;
		miso-gpios = <&gpe5 0 GPIO_ACTIVE_HIGH>;
		mosi-gpios = <&gpe5 1 GPIO_ACTIVE_HIGH>;
		cs-gpios = <&gpe5 2 GPIO_ACTIVE_HIGH>;
		num-chipselects = <1>;

		panel_spi@0 {
			compatible = "panel_spi";
			reg = <0>;
			spi-max-frequency = <1200000>;	/* FDT:10281 0x124f80 */
			bits-per-word = <8>;
		};
	};
};
