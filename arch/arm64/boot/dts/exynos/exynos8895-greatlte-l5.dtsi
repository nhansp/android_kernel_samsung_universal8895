/*
 * Samsung Galaxy Note 8 (greatlte, SM-N950N) board DT, part "l5":
 * L5 display: DECON/DSIM/panel (L5 4).
 *
 * Included at the end of exynos8895-greatlte.dts, after L0's nodes, in the merge
 * order of FULL_IMAGE_PLAN.md 2.2. Owner: WP-L5; no other work package edits this
 * file (plan 2.3 rule D1). A node that two parts both configure (&usi9, &usi10)
 * is written identically in both files: dtc lets the later file win on a differing
 * value, which gl-verify V-DUP reports as an error. L0's reserved-memory stays in
 * the .dts; carveout additions and flag changes are &label edits here (plan X-8).
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/soc/samsung,exynos-usi.h>

/*
 * S2DOS03 display PMIC on hsi2c_16 (usi5), address 0x60 (spec/L5_display.md 4.8):
 * the panel rails vdd_ddi_1p6 (buck1), vdd_ddi_1p8 (ldo1), vdd_ddi_3p0 (ldo3),
 * all left on by S-Boot. ldo2 "HRM_1.8V_AP" and ldo4 "HRM_3.3V_AP" (FDT:5550-5560)
 * belong to the HRM sensor (L6) and are added by its layer through &s2dos03.
 */
&usi5 {
	samsung,mode = <USI_MODE_I2C0_1>;	/* FDT:5021-5026 usi_mode = "hsi2c0_hsi2c1" = SW_CONF 0x3 (S:drivers/soc/samsung/usi.c:20,37) */
	status = "okay";
};

&hsi2c_16 {
	#address-cells = <1>;			/* FDT:5510 */
	#size-cells = <0>;
	status = "okay";			/* FDT:5519; hsi2c_15 stays disabled, FDT:5502 */

	s2dos03: pmic@60 {
		compatible = "samsung,s2dos03";	/* vendor "samsung,s2dos03pmic" FDT:5522 */
		reg = <0x60>;			/* FDT:5523 */

		regulators {
			s2dos03_buck1: buck1 {
				regulator-name = "vdd_ddi_1p6";		/* FDT:5529 */
				regulator-min-microvolt = <1500000>;	/* FDT:5530 0x16e360 */
				regulator-max-microvolt = <1600000>;	/* FDT:5531 0x186a00 */
				regulator-boot-on;			/* FDT:5532 */
			};

			s2dos03_ldo1: ldo1 {
				regulator-name = "vdd_ddi_1p8";		/* FDT:5536 */
				regulator-min-microvolt = <1800000>;	/* FDT:5537 0x1b7740 */
				regulator-max-microvolt = <1800000>;
				regulator-boot-on;			/* FDT:5539 */
			};

			s2dos03_ldo3: ldo3 {
				regulator-name = "vdd_ddi_3p0";		/* FDT:5543 */
				regulator-min-microvolt = <3000000>;	/* FDT:5544 0x2dc6c0 */
				regulator-max-microvolt = <3000000>;
				regulator-boot-on;			/* FDT:5546 */
			};
		};
	};
};

/*
 * S-Boot's "lcd_buffer" (spec/L5_display.md 4.1): it keeps 0xcc000000-0xcd400000
 * out of its DRAM test and scans its logo out of it; the framebuffer address it
 * passes on the command line is the same constant. no-map, and identity-mapped
 * for the DECON's IOMMU domain before translation is ever enabled
 * (A:drivers/iommu/of_iommu.c:206-270: IOMMU_RESV_DIRECT when iova == phys and
 * the length equals the region). soc@0 has one address and one size cell.
 */
&{/reserved-memory} {
	splash_mem: framebuffer@cc000000 {
		reg = <0x0 0xcc000000 0x1400000>;	/* SB:0xc9017a04 mov x1,#0xcc000000; SB:0xc9017a08 mov x2,#0xcd400000 */
		no-map;
		iommu-addresses = <&decon 0xcc000000 0x1400000>;
	};
};

/*
 * Simple-framebuffer over the live splash (spec/L5_display.md 4.2, stage 5a).
 * Disabled: the DRM driver owns the display in this image. It is the "keep
 * splash" kill switch of FULL_IMAGE_PLAN.md 3.3 (set it okay and disable the
 * DECON, the DSIM and the display System MMUs). reg, not memory-region, so
 * simplefb sizes the aperture as the 1440x2960x4 picture.
 */
&{/chosen} {
	#address-cells = <2>;
	#size-cells = <1>;
	ranges;

	framebuffer0: framebuffer@cc000000 {
		compatible = "simple-framebuffer";
		reg = <0x0 0xcc000000 (1440 * 2960 * 4)>;	/* SB:0xc9009fb4 mov w2,#-0x34000000 -> " s3cfb.bootloaderfb=0x%x" SB:0xc9088938 */
		width = <1440>;					/* FDT:10082 resolution = <0x5a0 0xb90> */
		height = <2960>;
		stride = <(1440 * 4)>;
		format = "a8r8g8b8";				/* vendor fb BGRA_8888 (S:drivers/video/fbdev/exynos/dpu/decon_core.c:4079) */
		power-domains = <&pd_dpu0>, <&pd_dpu1>;
		vddi3p0-supply = <&s2dos03_ldo3>;
		vddi1p8-supply = <&s2dos03_ldo1>;
		vddi1p6-supply = <&s2dos03_buck1>;
		status = "disabled";
	};
};
