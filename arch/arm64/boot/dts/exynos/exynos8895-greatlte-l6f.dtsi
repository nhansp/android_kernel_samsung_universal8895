/*
 * Samsung Galaxy Note 8 (greatlte, SM-N950N) board DT, part "l6f":
 * L6F power/input/misc: charger, fuel gauge, touch, S Pen, keys, fingerprint (L6F 4).
 *
 * Included at the end of exynos8895-greatlte.dts, after L0's nodes, in the merge
 * order of FULL_IMAGE_PLAN.md 2.2. Owner: WP-6F; no other work package edits this
 * file (plan 2.3 rule D1). A node that two parts both configure (&usi9, &usi10)
 * is written identically in both files: dtc lets the later file win on a differing
 * value, which gl-verify V-DUP reports as an error. L0's reserved-memory stays in
 * the .dts; carveout additions and flag changes are &label edits here (plan X-8).
 */
&pinctrl_alive {
	attn_irq: attn-irq-pins {			/* FDT:266-273 (0x66), touch on_state */
		samsung,pins = "gpa1-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
	};
	attn_input: attn-input-pins {			/* FDT:275-281 (0x67), touch off_state; stock sets no drv */
		samsung,pins = "gpa1-0";
		samsung,pin-function = <EXYNOS_PIN_FUNC_INPUT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_DOWN>;	/* pud 1 */
	};
};

&usi9 {
	samsung,mode = <USI_MODE_I2C0_1>;		/* stock usi@1082101C "hsi2c0_hsi2c1" FDT:5049-5053 */
	status = "okay";
};

&hsi2c_23 {						/* stock hsi2c@108E0000 FDT:5666-5683 (SPI 0x19a = 410) */
	clock-frequency = <400000>;		/* no clock-frequency in FDT:5666-5683 -> stock 400 kHz default (as 4.3) */
	status = "okay";

	touchscreen@48 {
		compatible = "samsung,s6sy661";		/* new s6sy761 variant (5.12); stock "sec,sec_ts" FDT:5685 */
		reg = <0x48>;				/* FDT:5686 */
		interrupt-parent = <&gpa1>;
		interrupts = <0 IRQ_TYPE_LEVEL_LOW>;	/* FDT:5692 sec,irq_gpio = <&gpa1 0 0>; FDT:5693 irq_type 0x2008 =
							   IRQF_ONESHOT | IRQF_TRIGGER_LOW */
		vdd-supply = <&ldo34_reg>;		/* FDT:5696 "tsp_io" (L2_power.md:646-651) */
		avdd-supply = <&ldo35_reg>;		/* FDT:5697 "tsp_avdd" (L2_power.md:652-657) */
		touchscreen-size-x = <4096>;		/* FDT:5694 sec,max_coords 0xfff = size - 1; chip value - 1 in stock (sec_ts.c:1922-1926) */
		touchscreen-size-y = <4096>;
		pinctrl-names = "default", "sleep";	/* FDT:5687 "on_state", "off_state" */
		pinctrl-0 = <&attn_irq>;		/* FDT:5688 0x66 */
		pinctrl-1 = <&attn_input>;		/* FDT:5689 0x67 */
		panel = <&panel>;			/* run 7: DRM panel follower, 5.12 item 13 (closes O-TS3); label from
							   L5 (REQ-L5-1); delete to keep touch powered while awake */
	};
};

/* Keys and hall (L6F slice A) */
#include <dt-bindings/input/input.h>

&pinctrl_alive {
	key_wink: key-wink-pins {			/* FDT:283-290 (phandle 0x145) */
		samsung,pins = "gpa0-6";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;	/* 0x0f */
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
	};
	key_voldown: key-voldown-pins {			/* FDT:292-299 (0x146) */
		samsung,pins = "gpa0-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
	};
	key_volup: key-volup-pins {			/* FDT:301-308 (0x147) */
		samsung,pins = "gpa0-3";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
	};
	key_power: key-power-pins {			/* FDT:310-317 (0x148) */
		samsung,pins = "gpa2-4";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
	};
	hall_irq: hall-irq-pins {			/* FDT:248-255 (0x142) */
		samsung,pins = "gpa0-1";
		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
		samsung,pin-drv = <EXYNOS7_PIN_DRV_LV1>;
	};
};

/ {
	gpio-keys {
		compatible = "gpio-keys";			/* FDT:11246 */
		label = "gpio_keys";				/* input name = stock "gpio_keys" (recon/input/input.txt:57);
								   A:drivers/input/keyboard/gpio_keys.c:778, :879 */
		pinctrl-names = "default";
		pinctrl-0 = <&key_wink &key_voldown &key_volup &key_power>;	/* FDT:11250 <0x145..0x148> */

		key-wink {
			label = "gpio-keys: KEY_WINK";		/* FDT:11253 */
			gpios = <&gpa0 6 GPIO_ACTIVE_LOW>;	/* FDT:11257 <0x90 6 0xf> (bit 0 = active low) */
			linux,code = <0x2bf>;			/* FDT:11256; Samsung KEY_WINK S:include/uapi/linux/input-event-codes.h:341,
								   inside 6.18 KEY_MAX 0x2ff A:include/uapi/linux/input-event-codes.h:837 */
			wakeup-source;				/* FDT:11258 gpio-key,wakeup */
		};
		key-volume-down {
			label = "gpio-keys: KEY_VOLUMEDOWN";	/* FDT:11262 */
			gpios = <&gpa0 4 GPIO_ACTIVE_LOW>;	/* FDT:11266 */
			linux,code = <KEY_VOLUMEDOWN>;		/* 0x72 FDT:11265 */
		};
		key-volume-up {
			label = "gpio-keys: KEY_VOLUMEUP";	/* FDT:11270 */
			gpios = <&gpa0 3 GPIO_ACTIVE_LOW>;	/* FDT:11274 */
			linux,code = <KEY_VOLUMEUP>;		/* 0x73 FDT:11273 */
		};
		key-power {
			label = "gpio-keys: KEY_POWER";		/* FDT:11278 */
			gpios = <&gpa2 4 GPIO_ACTIVE_LOW>;	/* FDT:11282 <0x4f 4 0xf> (0x4f = gpa2) */
			linux,code = <KEY_POWER>;		/* 0x74 FDT:11281 */
			wakeup-source;				/* FDT:11283 */
		};
	};

	hall-keys {
		compatible = "gpio-keys";
		label = "hall";					/* stock input name S:drivers/input/hall.c:252 */
		pinctrl-names = "default";
		pinctrl-0 = <&hall_irq>;			/* FDT:11206 0x142 */

		flip-cover {
			label = "flip_cover";
			gpios = <&gpa0 1 GPIO_ACTIVE_LOW>;	/* FDT:11207 hall,gpio_flip_cover = <&gpa0 1 0>; level 1 = open
								   (S:drivers/input/hall.c:98-104), so active-low = closed */
			linux,input-type = <EV_SW>;
			linux,code = <SW_LID>;			/* 0x00 A:include/uapi/linux/input-event-codes.h:934; stock SW_FLIP 0x15 > SW_MAX 0x11 (:954) */
			wakeup-source;
			debounce-interval = <10>;		/* stock 10 ms on open, 0 on close: S:drivers/input/hall.c:115-121 */
		};
	};
};

