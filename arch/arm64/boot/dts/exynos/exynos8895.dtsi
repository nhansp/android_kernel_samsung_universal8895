// SPDX-License-Identifier: GPL-2.0 OR BSD-3-Clause
/*
 * Samsung's Exynos 8895 SoC device tree source
 *
 * Copyright (c) 2024, Ivaylo Ivanov <ivo.ivanov.ivanov1@gmail.com>
 */

#include <dt-bindings/clock/samsung,exynos8895.h>
#include <dt-bindings/clock/samsung,exynos8895-acpm.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/thermal/thermal.h>

/ {
	compatible = "samsung,exynos8895";
	#address-cells = <2>;
	#size-cells = <1>;

	interrupt-parent = <&gic>;

	aliases {
		pinctrl0 = &pinctrl_alive;
		pinctrl1 = &pinctrl_abox;
		pinctrl2 = &pinctrl_vts;
		pinctrl3 = &pinctrl_fsys0;
		pinctrl4 = &pinctrl_fsys1;
		pinctrl5 = &pinctrl_busc;
		pinctrl6 = &pinctrl_peric0;
		pinctrl7 = &pinctrl_peric1;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu-map {
			cluster0 {
				core0 { cpu = <&cpu0>; };
				core1 { cpu = <&cpu1>; };
				core2 { cpu = <&cpu2>; };
				core3 { cpu = <&cpu3>; };
			};

			cluster1 {
				core0 { cpu = <&cpu4>; };
				core1 { cpu = <&cpu5>; };
				core2 { cpu = <&cpu6>; };
				core3 { cpu = <&cpu7>; };
			};
		};

		/* Boot cluster (Cortex-A53, MPIDR Aff1=1) first: stock logical ids 0-3. */
		cpu0: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x100>;			/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:184, FDT:4274 */
			enable-method = "psci";		/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:186 */
			capacity-dmips-mhz = <2048>;	/* S:arch/arm64/kernel/topology.c:207 */
		};

		cpu1: cpu@101 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x101>;			/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:194 */
			enable-method = "psci";
			capacity-dmips-mhz = <2048>;
		};

		cpu2: cpu@102 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x102>;			/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:203 */
			enable-method = "psci";
			capacity-dmips-mhz = <2048>;
		};

		cpu3: cpu@103 {
			device_type = "cpu";
			compatible = "arm,cortex-a53";
			reg = <0x103>;			/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:212 */
			enable-method = "psci";
			capacity-dmips-mhz = <2048>;
		};

		/* Mongoose M2 cluster (MPIDR Aff1=0): stock logical ids 4-7. */
		cpu4: cpu@0 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m2";	/* A:Documentation/devicetree/bindings/arm/cpus.yaml:222 */
			reg = <0x0>;			/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:221, FDT:4317 */
			enable-method = "psci";		/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:223 */
			capacity-dmips-mhz = <5035>;	/* S:arch/arm64/kernel/topology.c:205 */
		};

		cpu5: cpu@1 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m2";
			reg = <0x1>;			/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:231 */
			enable-method = "psci";
			capacity-dmips-mhz = <5035>;
		};

		cpu6: cpu@2 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m2";
			reg = <0x2>;			/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:240 */
			enable-method = "psci";
			capacity-dmips-mhz = <5035>;
		};

		cpu7: cpu@3 {
			device_type = "cpu";
			compatible = "samsung,mongoose-m2";
			reg = <0x3>;			/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:249 */
			enable-method = "psci";
			capacity-dmips-mhz = <5035>;
		};
	};

	firmware {
		/*
		 * The APM's ACPM firmware interface (the stock acpm_ipc, acpm and
		 * acpm_dvfs nodes, S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:2407-2438,
		 * FDT:6674-6701; their channel numbers are driver match data here).
		 * The PMIC child is the board's.
		 */
		acpm_ipc: power-management {
			compatible = "samsung,exynos8895-acpm-ipc";
			#clock-cells = <1>;	/* DVFS clocks, dt-bindings/clock/samsung,exynos8895-acpm.h */
			mboxes = <&ap2apm_mailbox>;
			shmem = <&apm_sram>;
			status = "disabled";
		};
	};

	/*
	 * Cortex-A53 cluster, cpus 0-3 = ACPM DVFS domain cpucl1. Levels: the ECT
	 * dvfs_cpucl1 table (sboot.bin SB+0x463cc); every ASV table (versions 1-8)
	 * enables L3..L11 = 1690000..455000 kHz, and stock "min-freq = <455000>;"
	 * (S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:473). Nine levels = the
	 * nine A53 "current" entries (:189). No opp-microvolt: the APM applies
	 * the voltage itself, and there is no cpu-supply.
	 * clock-latency: S:drivers/cpufreq/exynos-acme.h:101 "#define TRANSITION_LATENCY 100000" (ns).
	 */
	cpucl1_opp_table: opp-table-cl1 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-455000000 {
			opp-hz = /bits/ 64 <455000000>;
			clock-latency-ns = <100000>;
		};
		opp-598000000 {
			opp-hz = /bits/ 64 <598000000>;
			clock-latency-ns = <100000>;
		};
		opp-715000000 {
			opp-hz = /bits/ 64 <715000000>;
			clock-latency-ns = <100000>;
		};
		opp-832000000 {
			opp-hz = /bits/ 64 <832000000>;
			clock-latency-ns = <100000>;
		};
		opp-949000000 {
			opp-hz = /bits/ 64 <949000000>;
			clock-latency-ns = <100000>;
		};
		opp-1053000000 {
			/* ASV boot level L6 */
			opp-hz = /bits/ 64 <1053000000>;
			clock-latency-ns = <100000>;
		};
		opp-1248000000 {
			opp-hz = /bits/ 64 <1248000000>;
			clock-latency-ns = <100000>;
		};
		opp-1456000000 {
			opp-hz = /bits/ 64 <1456000000>;
			clock-latency-ns = <100000>;
		};
		opp-1690000000 {
			opp-hz = /bits/ 64 <1690000000>;
			clock-latency-ns = <100000>;
		};
	};

	/*
	 * Mongoose cluster, cpus 4-7 = ACPM DVFS domain cpucl0. Levels: the ECT
	 * dvfs_cpucl0 table (SB+0x462d4); ASV tables 3-8 enable L5..L17 =
	 * 2314000..741000 kHz (tables 1-2 stop at 2158000, and stock uses table 8
	 * for a version without a table, S:drivers/soc/samsung/cal-if/vclk.c:507-520),
	 * stock "min-freq = <741000>;" (S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:518).
	 * 13 levels = the Mongoose "current" entries (:226). Drop opp-2314000000
	 * only if the fused ASV version (acpm-clk "asv_ver=") is 1 or 2.
	 * opp-microvolt feeds only the energy model of the IPA power actor (no
	 * cpu-supply, so the OPP core never applies it; the APM keeps its own
	 * voltage): ECT ASV block, dvfs_cpucl0, table version 8, group 0 (the
	 * highest voltage of each level in that table; Lnn = ECT level), chosen
	 * because ACK has no static-power term (spec/L2c_thermal.md 4.3).
	 */
	cpucl0_opp_table: opp-table-cl0 {
		compatible = "operating-points-v2";
		opp-shared;

		opp-741000000 {
			opp-hz = /bits/ 64 <741000000>;
			opp-microvolt = <681250>;	/* L17 */
			clock-latency-ns = <100000>;
		};
		opp-858000000 {
			opp-hz = /bits/ 64 <858000000>;
			opp-microvolt = <706250>;	/* L16 */
			clock-latency-ns = <100000>;
		};
		opp-962000000 {
			opp-hz = /bits/ 64 <962000000>;
			opp-microvolt = <725000>;	/* L15 */
			clock-latency-ns = <100000>;
		};
		opp-1066000000 {
			/* ASV boot level L14 */
			opp-hz = /bits/ 64 <1066000000>;
			opp-microvolt = <737500>;	/* L14 */
			clock-latency-ns = <100000>;
		};
		opp-1170000000 {
			opp-hz = /bits/ 64 <1170000000>;
			opp-microvolt = <756250>;	/* L13 */
			clock-latency-ns = <100000>;
		};
		opp-1261000000 {
			opp-hz = /bits/ 64 <1261000000>;
			opp-microvolt = <775000>;	/* L12 */
			clock-latency-ns = <100000>;
		};
		opp-1469000000 {
			opp-hz = /bits/ 64 <1469000000>;
			opp-microvolt = <825000>;	/* L11 */
			clock-latency-ns = <100000>;
		};
		opp-1703000000 {
			opp-hz = /bits/ 64 <1703000000>;
			opp-microvolt = <893750>;	/* L10 */
			clock-latency-ns = <100000>;
		};
		opp-1807000000 {
			opp-hz = /bits/ 64 <1807000000>;
			opp-microvolt = <925000>;	/* L9 */
			clock-latency-ns = <100000>;
		};
		opp-1937000000 {
			opp-hz = /bits/ 64 <1937000000>;
			opp-microvolt = <968750>;	/* L8 */
			clock-latency-ns = <100000>;
		};
		opp-2002000000 {
			opp-hz = /bits/ 64 <2002000000>;
			opp-microvolt = <987500>;	/* L7 */
			clock-latency-ns = <100000>;
		};
		opp-2158000000 {
			opp-hz = /bits/ 64 <2158000000>;
			opp-microvolt = <1050000>;	/* L6 */
			clock-latency-ns = <100000>;
		};
		opp-2314000000 {
			opp-hz = /bits/ 64 <2314000000>;
			opp-microvolt = <1118750>;	/* L5 */
			clock-latency-ns = <100000>;
		};
	};

	/*
	 * Bus DVFS domains (spec L2b 4.1): stock devfreq_{mif,int,intcam,disp,cam}
	 * (FDT:6712-6805). Levels = ECT DVFS levels inside the ASV-enabled range,
	 * the same for ASV tables 1-8 (sboot.bin ECT, spec L2b 0.4). The rate is
	 * set through the ACPM DVFS clock (FREQ_REQ on ACPM channel 0).
	 */
	bus_mif: bus-mif {
		compatible = "samsung,exynos8895-bus-mif";
		clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_MIF>;	/* dfs_id 0xb040000, FDT:6728 */
		operating-points-v2 = <&bus_mif_opp_table>;
		status = "disabled";
	};

	bus_mif_opp_table: opp-table-bus-mif {
		compatible = "operating-points-v2";

		/* ECT dvfs_mif L10..L2 (SB:0x46508); ASV level_en L2-L10 in tables 1-8 */
		opp-286000000 { opp-hz = /bits/ 64 <286000000>; };
		opp-421000000 { opp-hz = /bits/ 64 <421000000>; };
		opp-546000000 { opp-hz = /bits/ 64 <546000000>; };
		opp-676000000 { opp-hz = /bits/ 64 <676000000>; };
		opp-845000000 { opp-hz = /bits/ 64 <845000000>; };
		opp-1014000000 { opp-hz = /bits/ 64 <1014000000>; };
		opp-1352000000 { opp-hz = /bits/ 64 <1352000000>; };
		opp-1540000000 { opp-hz = /bits/ 64 <1540000000>; };
		opp-1794000000 { opp-hz = /bits/ 64 <1794000000>; };
	};

	bus_int: bus-int {
		compatible = "samsung,exynos8895-bus-int";
		clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_INT>;	/* dfs_id 0xb040001, FDT:6748 */
		operating-points-v2 = <&bus_int_opp_table>;
		status = "disabled";
	};

	bus_int_opp_table: opp-table-bus-int {
		compatible = "operating-points-v2";

		/* ECT dvfs_int L6..L0 (SB:0x46654); all enabled in ASV tables 1-8 */
		opp-107000000 { opp-hz = /bits/ 64 <107000000>; };
		opp-178000000 { opp-hz = /bits/ 64 <178000000>; };
		opp-267000000 { opp-hz = /bits/ 64 <267000000>; };
		opp-333000000 { opp-hz = /bits/ 64 <333000000>; };
		opp-400000000 { opp-hz = /bits/ 64 <400000000>; };
		opp-533000000 { opp-hz = /bits/ 64 <533000000>; };
		opp-667000000 { opp-hz = /bits/ 64 <667000000>; };
	};

	bus_intcam: bus-intcam {
		compatible = "samsung,exynos8895-bus-intcam";
		clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_INTCAM>;	/* dfs_id 0xb040005, FDT:6768 */
		operating-points-v2 = <&bus_intcam_opp_table>;
		status = "disabled";
	};

	bus_intcam_opp_table: opp-table-bus-intcam {
		compatible = "operating-points-v2";

		/* ECT dvfs_intcam L3..L0 (SB:0x468a8); all enabled */
		opp-640000000 { opp-hz = /bits/ 64 <640000000>; };
		opp-670000000 { opp-hz = /bits/ 64 <670000000>; };
		opp-680000000 { opp-hz = /bits/ 64 <680000000>; };
		opp-690000000 { opp-hz = /bits/ 64 <690000000>; };
	};

	bus_cam: bus-cam {
		compatible = "samsung,exynos8895-bus-cam";
		clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CAM>;	/* dfs_id 0xb040006, FDT:6804 */
		operating-points-v2 = <&bus_cam_opp_table>;
		status = "disabled";
	};

	bus_cam_opp_table: opp-table-bus-cam {
		compatible = "operating-points-v2";

		/* ECT dvfs_cam L6..L0 (SB:0x46934); all enabled */
		opp-630000000 { opp-hz = /bits/ 64 <630000000>; };
		opp-640000000 { opp-hz = /bits/ 64 <640000000>; };
		opp-650000000 { opp-hz = /bits/ 64 <650000000>; };
		opp-660000000 { opp-hz = /bits/ 64 <660000000>; };
		opp-670000000 { opp-hz = /bits/ 64 <670000000>; };
		opp-680000000 { opp-hz = /bits/ 64 <680000000>; };
		opp-690000000 { opp-hz = /bits/ 64 <690000000>; };
	};

	bus_disp: bus-disp {
		compatible = "samsung,exynos8895-bus-disp";
		clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_DISP>;	/* dfs_id 0xb040007, FDT:6786 */
		operating-points-v2 = <&bus_disp_opp_table>;
		status = "disabled";
	};

	bus_disp_opp_table: opp-table-bus-disp {
		compatible = "operating-points-v2";

		/* ECT dvfs_disp L3..L1 (SB:0x46c48); ASV level_en L1-L3 in tables 1-8 */
		opp-214000000 { opp-hz = /bits/ 64 <214000000>; };
		opp-356000000 { opp-hz = /bits/ 64 <356000000>; };
		opp-533000000 { opp-hz = /bits/ 64 <533000000>; };
	};

	oscclk: osc-clock {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-output-names = "oscclk";
	};

	pmu-a53 {
		compatible = "arm,cortex-a53-pmu";
		interrupts = <GIC_SPI 24 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 25 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 26 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 27 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu0>,
				     <&cpu1>,
				     <&cpu2>,
				     <&cpu3>;
	};

	pmu-mongoose-m2 {
		compatible = "samsung,mongoose-pmu";
		interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 42 IRQ_TYPE_LEVEL_HIGH>,
			     <GIC_SPI 43 IRQ_TYPE_LEVEL_HIGH>;
		interrupt-affinity = <&cpu4>,
				     <&cpu5>,
				     <&cpu6>,
				     <&cpu7>;
	};

	psci {
		compatible = "arm,psci";
		method = "smc";
		cpu_off = <0x84000002>;
		cpu_on = <0xc4000003>;
		cpu_suspend = <0xc4000001>;
	};

	soc: soc@0 {
		compatible = "simple-bus";
		ranges = <0x0 0x0 0x0 0x20000000>;

		#address-cells = <1>;
		#size-cells = <1>;

		chipid@10000000 {
			compatible = "samsung,exynos8895-chipid",
				     "samsung,exynos850-chipid";
			reg = <0x10000000 0x24>;
		};

		cmu_peris: clock-controller@10010000 {
			compatible = "samsung,exynos8895-cmu-peris";
			reg = <0x10010000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_PERIS_BUS>;
			clock-names = "oscclk", "bus";
		};

		timer@10040000 {
			compatible = "samsung,exynos8895-mct",
				     "samsung,exynos4210-mct";
			reg = <0x10040000 0x800>;
			clocks = <&oscclk>, <&cmu_peris CLK_GOUT_PERIS_MCT_PCLK>;
			clock-names = "fin_pll", "mct";
			interrupts = <GIC_SPI 455 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 456 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 457 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 458 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 459 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 460 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 461 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 462 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 463 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 464 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 465 IRQ_TYPE_LEVEL_HIGH>,
				     <GIC_SPI 466 IRQ_TYPE_LEVEL_HIGH>;
		};

		watchdog: watchdog@10060000 {
			compatible = "samsung,exynos8895-wdt";
			reg = <0x10060000 0x100>;	/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:3169; FDT:7681 */
			interrupts = <GIC_SPI 454 IRQ_TYPE_LEVEL_HIGH>;	/* S:...:3170 <0 454 0>; FDT:7682 0x1c6 */
			/*
			 * stock "gate_watchdog" = UMUX_CLKCMU_PERIS_BUS (the PERIS bus user mux),
			 * "rate_watchdog" = OSCCLK 26 MHz: S:...:3171-3172
			 */
			clocks = <&cmu_peris CLK_MOUT_PERIS_BUS_USER>, <&oscclk>;
			clock-names = "watchdog", "watchdog_src";
			samsung,syscon-phandle = <&pmu_system_controller>;	/* S:...:3174 */
			timeout-sec = <30>;	/* S:...:3173; FDT:7685 0x1e */
			status = "disabled";
		};

		/*
		 * Four TMU instances on two register blocks, as stock
		 * (S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:4537-4591, FDT:9339-9434):
		 * the node names differ because dtc merges same-named siblings; the
		 * shared unit address is a W=1 warning only. APB clock: PERIS
		 * BUSIF_TMU at PERIS+0x2020 (CAL:cmucal-sfr.c:1903).
		 */
		tmu_big: tmu-big@10080000 {
			compatible = "samsung,exynos8895-tmu";
			reg = <0x10080000 0x400>;		/* S:...exynos8895.dtsi:4539 */
			interrupts = <GIC_SPI 451 IRQ_TYPE_LEVEL_HIGH>;	/* :4540 "<0 451 0>"; FDT:9342 <0x1c3> */
			clocks = <&cmu_peris CLK_GOUT_PERIS_BUSIF_TMU_PCLK>;
			clock-names = "tmu_apbif";
			samsung,tmu-sensors = <0x3d>;		/* :4543 "sensors = <61>;" */
			samsung,tmu-sensing-mode = "balance";	/* :4544 */
			/* stock mngs-thermal power_allocator gains, FDT:9445-9449 (mW/C, mW, C) */
			samsung,ipa-k-po = <100>;		/* k_po = <0x64> */
			samsung,ipa-k-pu = <85>;		/* k_pu = <0x55> */
			samsung,ipa-k-i = <100>;		/* k_i = <0x64> */
			samsung,ipa-integral-max = <1500>;	/* i_max = <0x5dc> */
			samsung,ipa-integral-cutoff = <28>;	/* integral_cutoff = <0x1c> */
			/*
			 * FDT:9347-9349 hotplug_enable, in <0x5b>, out <0x60> (C); the CPUs
			 * above NR_HOTPLUG_CPUS 4 (S:drivers/thermal/samsung/exynos_tmu.h:30)
			 */
			samsung,hotplug-cpus = <&cpu4>, <&cpu5>, <&cpu6>, <&cpu7>;
			samsung,hotplug-out-temp = <96000>;
			samsung,hotplug-in-temp = <91000>;
			#thermal-sensor-cells = <0>;
			status = "disabled";
		};

		tmu_little: tmu-little@10080000 {
			compatible = "samsung,exynos8895-tmu";
			reg = <0x10080000 0x400>;		/* :4553 */
			interrupts = <GIC_SPI 451 IRQ_TYPE_LEVEL_HIGH>;	/* :4554 */
			clocks = <&cmu_peris CLK_GOUT_PERIS_BUSIF_TMU_PCLK>;
			clock-names = "tmu_apbif";
			samsung,tmu-sensors = <0x02>;		/* :4557 "sensors = <2>;" */
			samsung,tmu-sensing-mode = "max";	/* :4558 */
			#thermal-sensor-cells = <0>;
			status = "disabled";
		};

		tmu_gpu: tmu-gpu@10084000 {
			compatible = "samsung,exynos8895-tmu";
			reg = <0x10084000 0x400>;		/* :4564 */
			interrupts = <GIC_SPI 452 IRQ_TYPE_LEVEL_HIGH>;	/* :4565 "<0 452 0>" */
			clocks = <&cmu_peris CLK_GOUT_PERIS_BUSIF_TMU_PCLK>;
			clock-names = "tmu_apbif";
			samsung,tmu-sensors = <0x01>;		/* :4568 "sensors = <1>;" */
			samsung,tmu-sensing-mode = "max";	/* :4569 */
			/* stock GPU power_allocator gains, FDT:9620-9624 (mW/C, mW, C) */
			samsung,ipa-k-po = <60>;		/* k_po = <0x3c> */
			samsung,ipa-k-pu = <100>;		/* k_pu = <0x64> */
			samsung,ipa-k-i = <50>;			/* k_i = <0x32> */
			samsung,ipa-integral-max = <500>;	/* i_max = <0x1f4> */
			samsung,ipa-integral-cutoff = <10>;	/* integral_cutoff = <0x0a> */
			#thermal-sensor-cells = <0>;
			status = "disabled";
		};

		tmu_isp: tmu-isp@10084000 {
			compatible = "samsung,exynos8895-tmu";
			reg = <0x10084000 0x400>;		/* :4584 */
			interrupts = <GIC_SPI 452 IRQ_TYPE_LEVEL_HIGH>;	/* :4585 */
			clocks = <&cmu_peris CLK_GOUT_PERIS_BUSIF_TMU_PCLK>;
			clock-names = "tmu_apbif";
			samsung,tmu-sensors = <0x06>;		/* :4588 "sensors = <6>;" */
			samsung,tmu-sensing-mode = "max";	/* :4589 */
			#thermal-sensor-cells = <0>;
			status = "disabled";
		};

		gic: interrupt-controller@10201000 {
			compatible = "arm,gic-400";
			reg = <0x10201000 0x1000>,
			      <0x10202000 0x1000>,
			      <0x10204000 0x2000>,
			      <0x10206000 0x2000>;
			#interrupt-cells = <3>;
			interrupt-controller;
			interrupts = <GIC_PPI 9 (GIC_CPU_MASK_SIMPLE(8) |
						 IRQ_TYPE_LEVEL_HIGH)>;
			#address-cells = <0>;
			#size-cells = <1>;
		};

		cmu_peric0: clock-controller@10400000 {
			compatible = "samsung,exynos8895-cmu-peric0";
			reg = <0x10400000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_PERIC0_BUS>,
				 <&cmu_top CLK_DOUT_CMU_PERIC0_UART_DBG>,
				 <&cmu_top CLK_DOUT_CMU_PERIC0_USI00>,
				 <&cmu_top CLK_DOUT_CMU_PERIC0_USI01>,
				 <&cmu_top CLK_DOUT_CMU_PERIC0_USI02>,
				 <&cmu_top CLK_DOUT_CMU_PERIC0_USI03>;
			clock-names = "oscclk", "bus", "uart", "usi0",
				      "usi1", "usi2", "usi3";
		};

