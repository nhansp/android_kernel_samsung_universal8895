				interrupts = <GIC_SPI 429 IRQ_TYPE_LEVEL_HIGH>;
				pinctrl-0 = <&spi15_bus>;
				pinctrl-names = "default";
				#address-cells = <1>;
				#size-cells = <0>;
				status = "disabled";
			};

			hsi2c_32: i2c@10000 {
				compatible = "samsung,exynos8895-hsi2c";
				reg = <0x10000 0x1000>;
				clocks = <&cmu_peric1 CLK_GOUT_PERIC1_USI13_I_PCLK>;
				clock-names = "hsi2c";
				interrupts = <GIC_SPI 427 IRQ_TYPE_LEVEL_HIGH>;
				pinctrl-0 = <&hsi2c32_bus>;
				pinctrl-names = "default";
				status = "disabled";
			};
		};

		pinctrl_peric1: pinctrl@10980000 {
			compatible = "samsung,exynos8895-pinctrl";
			reg = <0x10980000 0x1000>;
			interrupts = <GIC_SPI 430 IRQ_TYPE_LEVEL_HIGH>;
		};

		hsi2c_1: i2c@10990000 {
			compatible = "samsung,exynos8895-hsi2c";
			reg = <0x10990000 0x1000>;
			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_HSI2C_CAM0_IPCLK>;
			clock-names = "hsi2c";
			interrupts = <GIC_SPI 431 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-0 = <&hsi2c1_bus>;
			pinctrl-names = "default";
			status = "disabled";
		};

		hsi2c_2: i2c@109a0000 {
			compatible = "samsung,exynos8895-hsi2c";
			reg = <0x109a0000 0x1000>;
			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_HSI2C_CAM1_IPCLK>;
			clock-names = "hsi2c";
			interrupts = <GIC_SPI 432 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-0 = <&hsi2c2_bus>;
			pinctrl-names = "default";
			status = "disabled";
		};

		hsi2c_3: i2c@109b0000 {
			compatible = "samsung,exynos8895-hsi2c";
			reg = <0x109b0000 0x1000>;
			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_HSI2C_CAM2_IPCLK>;
			clock-names = "hsi2c";
			interrupts = <GIC_SPI 433 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-0 = <&hsi2c3_bus>;
			pinctrl-names = "default";
			status = "disabled";
		};

		hsi2c_4: i2c@109c0000 {
			compatible = "samsung,exynos8895-hsi2c";
			reg = <0x109c0000 0x1000>;
			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_HSI2C_CAM3_IPCLK>;
			clock-names = "hsi2c";
			interrupts = <GIC_SPI 434 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-0 = <&hsi2c4_bus>;
			pinctrl-names = "default";
			status = "disabled";
		};

		spi_0: spi@109d0000 {
			compatible = "samsung,exynos8895-spi",
				     "samsung,exynos850-spi";
			reg = <0x109d0000 0x100>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_SPI_CAM0_PCLK>,
				 <&cmu_peric1 CLK_GOUT_PERIC1_SPI_CAM0_SPI_EXT_CLK>;
			clock-names = "spi", "spi_busclk0";
			interrupts = <GIC_SPI 435 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-0 = <&spi0_bus>;
			pinctrl-names = "default";
			status = "disabled";
		};

		spi_1: spi@109e0000 {
			compatible = "samsung,exynos8895-spi",
				     "samsung,exynos850-spi";
			reg = <0x109e0000 0x100>;
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&cmu_peric1 CLK_GOUT_PERIC1_SPI_CAM1_PCLK>,
				 <&cmu_peric1 CLK_GOUT_PERIC1_SPI_CAM1_SPI_EXT_CLK>;
			clock-names = "spi", "spi_busclk0";
			interrupts = <GIC_SPI 436 IRQ_TYPE_LEVEL_HIGH>;
			pinctrl-0 = <&spi1_bus>;
			pinctrl-names = "default";
			status = "disabled";
		};

		/*
		 * USB 3.0 DRD controller (L3 4.1): stock "samsung,exynos8895-dwusb3" at
		 * 0x10c00000 size 0x10000 (FDT:7854-7858). Stock "aclk" (FDT:7856-7857, the
		 * link Q-channel vclk 0x2ca) has no 6.18 clock; the link's AXI gate is
		 * held instead. Stock "sclk" (0x2bf, USBDRD30) = the REF_CLK gate. Stock
		 * enables the USBTV IP as one vclk that also holds the USBTVH AHB and
		 * core gates (S:drivers/soc/samsung/cal-if/exynos8895/cmucal-vclk.c:1442-1449);
		 * without a user, clk_disable_unused gates them and the core never binds.
		 */
		usbdrd: usb@10c00000 {
			compatible = "samsung,exynos8895-dwusb3";
			ranges = <0x0 0x10c00000 0x10000>;
			clocks = <&cmu_fsys0 CLK_GOUT_FSYS0_USBTV_I_USB30DRD_ACLK>,
				 <&cmu_fsys0 CLK_GOUT_FSYS0_USBTV_I_USB30DRD_REF_CLK>,
				 <&cmu_fsys0 CLK_GOUT_FSYS0_USBTV_I_USBTVH_AHB_CLK>,
				 <&cmu_fsys0 CLK_GOUT_FSYS0_USBTV_I_USBTVH_CORE_CLK>;
			clock-names = "aclk", "ref", "usbtvh_ahb", "usbtvh_core";
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			usbdrd_dwc3: usb@0 {
				compatible = "snps,dwc3";
				reg = <0x0 0x10000>;				/* FDT:7868 */
				interrupts = <GIC_SPI 337 IRQ_TYPE_LEVEL_HIGH>;	/* FDT:7869 <0 0x151 0> */
				/* GCTL.PWRDNSCALE; stock suspend_clk_freq 66 MHz, FDT:7871 */
				clocks = <&cmu_fsys0 CLK_GOUT_FSYS0_USBTV_I_USB30DRD_SUSPEND_CLK>;
				clock-names = "suspend";
				phys = <&usbdrd_phy 0>, <&usbdrd_phy 1>;	/* FDT:7873-7874 */
				phy-names = "usb2-phy", "usb3-phy";
				/* stock clears GUSB2PHYCFG SUSPHY and ENBLSLPM: S:drivers/usb/dwc3/core.c:714-715 */
				snps,dis_u2_susphy_quirk;
				snps,dis_enblslpm_quirk;
				/* no LPM, no U1/U2 (IKC:3598): S:drivers/usb/gadget/composite.c:611-612, S:drivers/usb/dwc3/ep0.c:633-652 */
				snps,usb2-gadget-lpm-disable;
				snps,dis-u1-entry-quirk;
				snps,dis-u2-entry-quirk;
				/*
				 * DWC_usb3 2.80a (GSNPSID 0x5533280a): stock sets
				 * GUSB3PIPECTL.DIS_RXDETP3 for >= 2.50a, S:drivers/usb/dwc3/core.c:162-166
				 */
				snps,dis_rxdet_inp3_quirk;
			};
		};

		/* USB 3.0 DRD PHY (L3 4.1): FDT:7880-7905 */
		usbdrd_phy: phy@10e00000 {
			compatible = "samsung,exynos8895-usbdrd-phy";
			reg = <0x10e00000 0x100>,	/* window 0, FDT:7882 */
			      <0x10e10000 0x100>,	/* window 1, FDT:7882 */
			      <0x10e50070 0x10>;	/* refclk select, FDT:7901 */
			clocks = <&cmu_fsys0 CLK_GOUT_FSYS0_USBTV_I_USB30DRD_ACLK>,
				 <&oscclk>;		/* stock ext_xtal = OSCCLK, FDT:7883 */
			clock-names = "phy", "ref";
			samsung,pmu-syscon = <&pmu_system_controller>;	/* FDT:7885 */
			#phy-cells = <1>;				/* FDT:7888 */
			status = "disabled";
		};

		cmu_fsys0: clock-controller@11000000 {
			compatible = "samsung,exynos8895-cmu-fsys0";
			reg = <0x11000000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_FSYS0_BUS>,
				 <&cmu_top CLK_DOUT_CMU_FSYS0_DPGTC>,
				 <&cmu_top CLK_DOUT_CMU_FSYS0_MMC_EMBD>,
				 <&cmu_top CLK_DOUT_CMU_FSYS0_UFS_EMBD>,
				 <&cmu_top CLK_DOUT_CMU_FSYS0_USBDRD30>;
			clock-names = "oscclk", "bus", "dpgtc", "mmc",
				      "ufs", "usbdrd30";
		};

		syscon_fsys0: syscon@11020000 {
			compatible = "samsung,exynos8895-fsys0-sysreg", "syscon";
			reg = <0x11020000 0x2000>;
			clocks = <&cmu_fsys0 CLK_GOUT_FSYS0_SYSREG_FSYS0_PCLK>;
		};

		pinctrl_fsys0: pinctrl@11050000 {
			compatible = "samsung,exynos8895-pinctrl";
			reg = <0x11050000 0x1000>;
			interrupts = <GIC_SPI 335 IRQ_TYPE_LEVEL_HIGH>;
		};

		/*
		 * UFS 2.1 host, stock "hw-rev 4". Stock node:
		 * S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:817-1100 (FDT:4693-4763).
		 * Clocks: the three FSYS0 IP gates of the UFS block (stock gate list
		 * CAL:cmucal-vclk.c:1437-1441); stock DT named the HWACG Q-channel
		 * GATE_UFS_EMBD and the TOP rate UFS_EMBD instead. The ufs-phy,
		 * ufs-io-coherency and ufs-tcxo-sel children become phys,
		 * samsung,sysreg and a driver constant into the same syscon.
		 */
		ufs: ufs@11120000 {
			compatible = "samsung,exynos8895-ufs";
			reg = <0x11120000 0x200>,	/* S:exynos8895.dtsi:827 "0: HCI standard" */
			      <0x11121100 0x200>,	/* :828 "1: Vendor specificed" */
			      <0x11110000 0x8000>,	/* :829 "2: UNIPRO" */
			      <0x11130000 0x100>;	/* :830 "3: UFS protector", mapped, never accessed */
			reg-names = "hci", "vs_hci", "unipro", "ufsp";
			interrupts = <GIC_SPI 334 IRQ_TYPE_LEVEL_HIGH>;	/* :831 "<0 334 0>" */
			clocks = <&cmu_fsys0 CLK_GOUT_FSYS0_UFS_EMBD_I_ACLK>,
				 <&cmu_fsys0 CLK_GOUT_FSYS0_UFS_EMBD_I_CLK_UNIPRO>,
				 <&cmu_fsys0 CLK_GOUT_FSYS0_UFS_EMBD_I_FMP_CLK>;
			clock-names = "core_clk", "sclk_unipro_main", "fmp";
			freq-table-hz = <0 0>, <0 0>, <0 0>;	/* :858 "<0 0>, <0 0>": no rate is set */
			pinctrl-names = "default";
			pinctrl-0 = <&ufs_rst_n &ufs_refclk_out>;	/* :833 */
			phys = <&ufs_phy>;
			phy-names = "ufs-phy";
			samsung,sysreg = <&syscon_fsys0 0x700>;	/* :1082-1086 0x11020700, bits 9:8 */
			dma-coherent;				/* :850 */
			status = "disabled";
		};

		/* Embedded UFS M-PHY: S:exynos8895.dtsi:1065-1074 (FDT:4735-4745) */
		ufs_phy: phy@11124000 {
			compatible = "samsung,exynos8895-ufs-phy";
			reg = <0x11124000 0x800>;	/* :1069 */
			reg-names = "phy-pma";
			clocks = <&oscclk>;		/* 26 MHz TCXO, "use alternative" path :1097-1098 */
			clock-names = "ref_clk";
			samsung,pmu-syscon = <&pmu_system_controller 0x724>;	/* ufs-phy-sys :1072 0x16480724 */
			#phy-cells = <0>;
			status = "disabled";
		};

		cmu_fsys1: clock-controller@11400000 {
			compatible = "samsung,exynos8895-cmu-fsys1";
			reg = <0x11400000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_FSYS1_BUS>,
				 <&cmu_top CLK_DOUT_CMU_FSYS1_PCIE>,
				 <&cmu_top CLK_DOUT_CMU_FSYS1_UFS_CARD>,
				 <&cmu_top CLK_DOUT_CMU_FSYS1_MMC_CARD>;
			clock-names = "oscclk", "bus", "pcie", "ufs", "mmc";
		};

		syscon_fsys1: syscon@11420000 {
			compatible = "samsung,exynos8895-fsys1-sysreg", "syscon";
			reg = <0x11420000 0x2000>;
			clocks = <&cmu_fsys1 CLK_GOUT_FSYS1_SYSREG_FSYS1_PCLK>;
		};

		pinctrl_fsys1: pinctrl@11430000 {
			compatible = "samsung,exynos8895-pinctrl";
			reg = <0x11430000 0x1000>;
			interrupts = <GIC_SPI 342 IRQ_TYPE_LEVEL_HIGH>;
		};

		mmc: mmc@11500000 {
			/* no -smu: stock never programs the SD slot's SMU (cfg_smu only for
			 * mshc alias 0, S:drivers/mmc/host/dw_mmc-exynos.c:256-269; this is
			 * mshc2, S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:143) */
			compatible = "samsung,exynos8895-dw-mshc",
				     "samsung,exynos7-dw-mshc";
			reg = <0x11500000 0x2000>;
			assigned-clocks = <&cmu_top CLK_MOUT_CMU_FSYS1_MMC_CARD>;
			/* stock MMC_CARD LUT: mux 1 = PLL_SHARED2 (800 MHz), div 0
			 * (CAL:cmucal-vclk.c:2580-2581, cmucal-vclklut.c:137-138,
			 * cmucal-node.c:20-21,275-278) */
			assigned-clock-parents = <&cmu_top CLK_FOUT_SHARED2_PLL>;
			clocks = <&cmu_fsys1 CLK_GOUT_FSYS1_MMC_CARD_I_ACLK>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_MMC_CARD_SDCLKIN>;
			clock-names = "biu", "ciu";
			fifo-depth = <64>;
			interrupts = <GIC_SPI 341 IRQ_TYPE_LEVEL_HIGH>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		/* L6D PCIe RC0 (K-F3) */
		pcie0: pcie@11700000 {
			compatible = "samsung,exynos8895-pcie";
			reg = <0x11700000 0x1000>,	/* dbi    FDT:8220 (4th region) */
			      <0x116a0000 0x1000>,	/* elbi   FDT:8220 (1st) */
			      <0x116d0000 0x1000>,	/* phy    FDT:8220 (2nd); shared with ch1 FDT:8256 */
			      <0x116c0000 0x1fc>,	/* pcs    FDT:8220 (5th); shared with ch1 FDT:8256 */
			      <0x11bff000 0x1000>;	/* config FDT:8220 (6th) */
			reg-names = "dbi", "elbi", "phy", "pcs", "config";
			interrupts = <GIC_SPI 345 IRQ_TYPE_LEVEL_HIGH>;	/* FDT:8222 <0 0x159 0>; type as the stock interrupt-map FDT:8234 (4) */
			clocks = <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_DBI_ACLK_0>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_MSTR_ACLK_0>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_SLV_ACLK_0>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_PCIE_SUB_CTRL_INST_0_I_DRIVER_APB_CLK>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_PIPE2_DIGITAL_X2_WRAP_INST_0_I_APB_PCLK_SCL>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_IEEE1500_WRAPPER_FOR_PCIE_PHY_LC_X2_INST_0_I_SCL_APB_PCLK>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_PHY_REF_CLK_IN>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_DBI_ACLK_1>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_MSTR_ACLK_1>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_SLV_ACLK_1>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_PCIE_PCIE_SUB_CTRL_INST_1_I_DRIVER_APB_CLK>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_TOE_WIFI0_I_CLK>,
				 <&cmu_fsys1 CLK_GOUT_FSYS1_TOE_WIFI1_I_CLK>;
			clock-names = "dbi", "mstr", "slv", "apb", "pipe_apb", "phy_apb", "ref",
				      "dbi1", "mstr1", "slv1", "apb1", "toe0", "toe1";
			/* The six after "ref" (hardware test, image 0063/0064): stock booted with clk_ignore_unused
			 * (FDT:11147 bootargs), so no FSYS1 PCIe/TOE gate was ever turned off. Unclaimed, ACK's
			 * clk_disable_unused stops them after this probe and the next ELBI read (exynos_pcie_poweron,
			 * PCIE_STATE_HISTORY_CHECK) takes a synchronous external abort. Channel 1 shares the PHY and
			 * sub-controller with channel 0 (FDT:8220/8256); held here, they keep the stock state. */
			/* stock claims none (FDT:8239-8240, HWACG Q-channel gates S:drivers/clk/samsung/clk-exynos8895.c:236-245);
			 * ACK gates are manual, class IP (L1_platform.md:484) -> held here; ids/offsets RL-5 */
			samsung,pmu-syscon = <&pmu_system_controller>;	/* FDT:8223 samsung,syscon-phandle = <0x1f> (PMU); 0x610, 0x71C */
			samsung,fsys-sysreg = <&syscon_fsys1 0x1044>;	/* FDT:8220 "sysreg" 0x11421044 = syscon_fsys1 0x11420000 + 0x1044; FDT:8224 */
			#address-cells = <3>;			/* FDT:8228 */
			#size-cells = <2>;			/* FDT:8229 */
			device_type = "pci";			/* FDT:8230 */
			ranges = <0x82000000 0x0 0x11800000 0x11800000 0x0 0x400000>;	/* FDT:8231 (parent address = 1 cell here) */
			bus-range = <0x00 0xff>;		/* stock dw_pcie 4.4 root bus 0 (pci-exynos.c:1051); secondary 1 */
			#interrupt-cells = <1>;			/* FDT:8232 */
			interrupt-map-mask = <0 0 0 0>;		/* FDT:8233 */
			interrupt-map = <0 0 0 0 &gic GIC_SPI 345 IRQ_TYPE_LEVEL_HIGH>;	/* FDT:8234 <.. 0x01 0x00 0x159 0x04> */
			num-lanes = <1>;			/* FDT:8236 */
			status = "disabled";
		};

		cmu_dpu0: clock-controller@12800000 {
			compatible = "samsung,exynos8895-cmu-dpu0";
			reg = <0x12800000 0x8000>;	/* CAL:cmucal-sfr.c:19 SFR_BLOCK(DPU0, 0x12800000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_DPU_BUS>;	/* CAL:cmucal-node.c:1006 MUX_CLKCMU_DPU_BUS_USER parents */
			clock-names = "oscclk", "bus";
			power-domains = <&pd_dpu0>;	/* CAL:pmucal_local_exynos8895.h:203-232 dpu0_save */
			status = "disabled";
		};

		/*
		 * SYSREG_DPU0 (S:drivers/video/fbdev/exynos/dpu/regs-decon.h:69): DISP_SS
		 * LPMUX/DLMUX/MIPI_PHY_CON/TE_SEL at +0x1000..+0x100c (vendor mapping
		 * FDT:7465 <0x12821000 0x10>, regs-decon.h:21,27,43,50) and
		 * BUS_COMPONENT_DRCG_EN at +0x200 (S:.../pmucal_local_exynos8895.h:230).
		 */
		syscon_dpu0: syscon@12820000 {
			compatible = "samsung,exynos8895-dpu0-sysreg", "syscon";
			reg = <0x12820000 0x2000>;
			clocks = <&cmu_dpu0 CLK_GOUT_DPU0_SYSREG_DPU0_PCLK>;	/* CAL:cmucal-sfr.c:978 (0x2108) */
		};

		/*
		 * DECON0 ("decon_f", FDT:7527-7558) with the DPP registers of its six
		 * channels (G0 G1 VG0 VG1 VGF0 VGF1 at 0x1000 each, FDT:7385..7440
		 * reg[0]) and DPU_DMA (common 0x0-0xff, channel n at n * 0x1000,
		 * FDT reg[1]/reg[2]): the vendor's seven "dpp" devices are part of
		 * this one device, the only master of the display System MMUs.
		 * Interrupts: frame start/done and extra by the vendor's index
		 * (S:drivers/video/fbdev/exynos/dpu/decon_dsi.c:151-214), then each
		 * channel's DMA and DPP interrupts (vendor order, S:.../dpu/
		 * dpp_drv.c:1033-1065).
		 * Clocks: the CMU_DPU0 gates of DECON0 (0x207c), DPP G0 (0x2080),
		 * DPU_DMA SFR (0x209c) and DMA channel 1 = G0/VG0 (0x2090,
		 * S:.../dpu/helper.c:593-597).
		 */
		decon: display-controller@12860000 {
			compatible = "samsung,exynos8895-decon";
			reg = <0x12860000 0x10000>,	/* FDT:7530; DSC0/1 at +0x4000/+0x5000 */
			      <0x12851000 0x6000>,
			      <0x128b0000 0x7000>;
			reg-names = "decon", "dpp", "dma";
			interrupts = <GIC_SPI 143 IRQ_TYPE_LEVEL_HIGH>,	/* FDT:7531 0x8f */
				     <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>,	/* 0x90 */
				     <GIC_SPI 149 IRQ_TYPE_LEVEL_HIGH>,	/* 0x95 */
				     <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>,	/* G0 FDT:7386 0xb7 */
				     <GIC_SPI 179 IRQ_TYPE_LEVEL_HIGH>,	/* 0xb3 */
				     <GIC_SPI 184 IRQ_TYPE_LEVEL_HIGH>,	/* G1 FDT:7397 0xb8 */
				     <GIC_SPI 181 IRQ_TYPE_LEVEL_HIGH>,	/* 0xb5 */
				     <GIC_SPI 185 IRQ_TYPE_LEVEL_HIGH>,	/* VG0 FDT:7408 0xb9 */
				     <GIC_SPI 180 IRQ_TYPE_LEVEL_HIGH>,	/* 0xb4 */
				     <GIC_SPI 186 IRQ_TYPE_LEVEL_HIGH>,	/* VG1 FDT:7419 0xba */
				     <GIC_SPI 182 IRQ_TYPE_LEVEL_HIGH>,	/* 0xb6 */
				     <GIC_SPI 188 IRQ_TYPE_LEVEL_HIGH>,	/* VGF0 FDT:7430 0xbc */
				     <GIC_SPI 177 IRQ_TYPE_LEVEL_HIGH>,	/* 0xb1 */
				     <GIC_SPI 187 IRQ_TYPE_LEVEL_HIGH>,	/* VGF1 FDT:7441 0xbb */
				     <GIC_SPI 178 IRQ_TYPE_LEVEL_HIGH>;	/* 0xb2 */
			interrupt-names = "frame_start", "frame_done", "extra",
					  "g0_dma", "g0_dpp", "g1_dma", "g1_dpp",
					  "vg0_dma", "vg0_dpp", "vg1_dma", "vg1_dpp",
					  "vgf0_dma", "vgf0_dpp", "vgf1_dma", "vgf1_dpp";
			clocks = <&cmu_dpu0 CLK_GOUT_DPU0_DECON0_ACLK>,	/* CAL:cmucal-sfr.c:971 */
				 <&cmu_dpu0 CLK_GOUT_DPU0_DPP_DPP_G0_ACLK>,	/* :1001 */
				 <&cmu_dpu0 CLK_GOUT_DPU0_DPU_DMA_ACLK_SFR>,	/* :1010 */
				 <&cmu_dpu0 CLK_GOUT_DPU0_DPU_DMA_ACLK_CH1>;	/* :1006 */
			clock-names = "aclk", "dpp_g0", "dma_sfr", "dma_ch1";
			power-domains = <&pd_dpu0>;	/* FDT:7537 */
			iommus = <&sysmmu_dpu0>, <&sysmmu_dpu1>, <&sysmmu_dpu2>;
			samsung,disp-sysreg = <&syscon_dpu0>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					decon_to_dsi: endpoint {
						remote-endpoint = <&dsi_from_decon>;
					};
				};
			};
		};

		/*
		 * DSIM0 (FDT:7483-7492): APB gate in CMU_DPU0, D-PHY = DSIM0 of the
		 * PMU's MIPI PHY, pd_dpu1. PLL input 26 MHz (the vendor's fixed
		 * fin, S:.../dpu/dsim_reg.c:1459). The panel-side link values and
		 * port@1 come from the board.
		 */
		dsi: dsi@12870000 {
			compatible = "samsung,exynos8895-mipi-dsi";
			reg = <0x12870000 0x100>;	/* FDT:7485 */
			interrupts = <GIC_SPI 150 IRQ_TYPE_LEVEL_HIGH>;	/* FDT:7486 0x96 */
			clocks = <&cmu_dpu0 CLK_GOUT_DPU0_AD_APB_MIPI_DSIM0_PCLKS>;	/* CAL:cmucal-sfr.c:994 */
			clock-names = "bus";
			phys = <&mipi_phy 1>;	/* EXYNOS_MIPI_PHY_ID_DSIM0 */
			phy-names = "dsim";
			power-domains = <&pd_dpu1>;	/* FDT:7489 */
			samsung,pll-clock-frequency = <26000000>;
			samsung,disp-sysreg = <&syscon_dpu0>;
			samsung,dpu1-sysreg = <&syscon_dpu1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;

					dsi_from_decon: endpoint {
						remote-endpoint = <&decon_to_dsi>;
					};
				};
			};
		};

		/*
		 * Display System MMUs (FDT:7334-7380). Each serves several DPP
		 * channels of DECON0; the DECON is their only master (one master
		 * per System MMU). The second vendor interrupt is the secure one.
		 * Vendor-only properties dropped: qos (ACK writes QoS 15 itself),
		 * port-name, sysmmu,secure-*, sysmmu,tlb_property (no ACK consumer).
		 * power-domains: the vendor nodes have none (its bus-wide runtime
		 * PM powers them with the master); ACK needs it so no register is
		 * read with pd_dpu0 off. aclk/pclk: CMU_DPU0 gates.
		 */
		sysmmu_dpu0: iommu@12900000 {
			compatible = "samsung,exynos-sysmmu";
			reg = <0x12900000 0x3000>;	/* FDT:7336 */
			interrupts = <GIC_SPI 152 IRQ_TYPE_LEVEL_HIGH>;	/* FDT:7337 0x98 */
			clocks = <&cmu_dpu0 CLK_GOUT_DPU0_SYSMMU_DPUD0_ACLK>,	/* CAL:cmucal-sfr.c:983 */
				 <&cmu_dpu0 CLK_GOUT_DPU0_SYSMMU_DPUD0_PCLK_NONSECURE>;	/* :982 */
			clock-names = "aclk", "pclk";
			power-domains = <&pd_dpu0>;
			#iommu-cells = <0>;
			status = "disabled";
		};

		sysmmu_dpu1: iommu@12910000 {
			compatible = "samsung,exynos-sysmmu";
			reg = <0x12910000 0x3000>;	/* FDT:7352 */
			interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>;	/* FDT:7353 0x9b */
			clocks = <&cmu_dpu0 CLK_GOUT_DPU0_SYSMMU_DPUD1_ACLK>,	/* CAL:cmucal-sfr.c:1024 */
				 <&cmu_dpu0 CLK_GOUT_DPU0_SYSMMU_DPUD1_PCLK_NONSECURE>;	/* :985 */
			clock-names = "aclk", "pclk";
			power-domains = <&pd_dpu0>;
			#iommu-cells = <0>;
			status = "disabled";
		};

		sysmmu_dpu2: iommu@12920000 {
			compatible = "samsung,exynos-sysmmu";
			reg = <0x12920000 0x3000>;	/* FDT:7368 */
			interrupts = <GIC_SPI 158 IRQ_TYPE_LEVEL_HIGH>;	/* FDT:7369 0x9e */
			clocks = <&cmu_dpu0 CLK_GOUT_DPU0_SYSMMU_DPUD2_ACLK>,	/* CAL:cmucal-sfr.c:1015 */
				 <&cmu_dpu0 CLK_GOUT_DPU0_SYSMMU_DPUD2_PCLK_NONSECURE>;	/* :1017 */
			clock-names = "aclk", "pclk";
			power-domains = <&pd_dpu0>;
			#iommu-cells = <0>;
			status = "disabled";
		};

		cmu_dpu1: clock-controller@12a00000 {
			compatible = "samsung,exynos8895-cmu-dpu1";
			reg = <0x12a00000 0x8000>;	/* CAL:cmucal-sfr.c:20 SFR_BLOCK(DPU1, 0x12a00000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_dpu0 CLK_GOUT_DPU0_CLKCMU_DPU1_BUSD>,	/* CAL:cmucal-node.c:1007 { OSCCLK_DPU1, CLKCMU_DPU1_BUSD } */
				 <&cmu_dpu0 CLK_GOUT_DPU0_CLKCMU_DPU1_BUSP>;	/* CAL:cmucal-node.c:1008 { OSCCLK_DPU1, CLKCMU_DPU1_BUSP } */
			clock-names = "oscclk", "busd", "busp";
			power-domains = <&pd_dpu1>;	/* CAL:pmucal_local_exynos8895.h:247-269 dpu1_save */
			status = "disabled";
		};

		/*
		 * SYSREG_DPU1: only BUS_COMPONENT_DRCG_EN at +0x200 is used
		 * (S:.../pmucal_local_exynos8895.h:267). Its PCLK gate is in CMU_DPU1
		 * (CAL:cmucal-sfr.c:1064), which is not registered: no clocks.
		 */
		syscon_dpu1: syscon@12a20000 {
			compatible = "samsung,exynos8895-dpu1-sysreg", "syscon";
			reg = <0x12a20000 0x1000>;
		};

		cmu_cam: clock-controller@12c00000 {
			compatible = "samsung,exynos8895-cmu-cam";
			reg = <0x12c00000 0x8000>;	/* CAL:cmucal-sfr.c:12 SFR_BLOCK(CAM, 0x12c00000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_CAM_BUS>,	/* CAL:cmucal-node.c:597 */
				 <&cmu_top CLK_DOUT_CMU_CAM_TPU0>,	/* CAL:cmucal-node.c:601 */
				 <&cmu_top CLK_DOUT_CMU_CAM_TPU1>,	/* CAL:cmucal-node.c:609 */
				 <&cmu_top CLK_DOUT_CMU_CAM_VRA>;	/* CAL:cmucal-node.c:605 */
			clock-names = "oscclk", "bus", "tpu0", "tpu1", "vra";
			assigned-clocks = <&cmu_cam CLK_MOUT_CAM_BUS_USER>, <&cmu_cam CLK_MOUT_CAM_TPU0_USER>,
					  <&cmu_cam CLK_MOUT_CAM_TPU1_USER>, <&cmu_cam CLK_MOUT_CAM_VRA_USER>;
			assigned-clock-parents = <&cmu_top CLK_DOUT_CMU_CAM_BUS>, <&cmu_top CLK_DOUT_CMU_CAM_TPU0>,
						 <&cmu_top CLK_DOUT_CMU_CAM_TPU1>, <&cmu_top CLK_DOUT_CMU_CAM_VRA>;
			power-domains = <&pd_cam>;	/* CAL:pmucal_local_exynos8895.h:76-112 cam_save */
			status = "disabled";
		};

		cmu_dcam: clock-controller@12e00000 {
			compatible = "samsung,exynos8895-cmu-dcam";
			reg = <0x12e00000 0x8000>;	/* CAL:cmucal-sfr.c:18 SFR_BLOCK(DCAM, 0x12e00000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_DCAM_BUS>,	/* CAL:cmucal-node.c:633 */
				 <&cmu_top CLK_DOUT_CMU_DCAM_IMGD>;	/* CAL:cmucal-node.c:637 */
			clock-names = "oscclk", "bus", "imgd";
			assigned-clocks = <&cmu_dcam CLK_MOUT_DCAM_BUS_USER>, <&cmu_dcam CLK_MOUT_DCAM_IMGD_USER>;
			assigned-clock-parents = <&cmu_top CLK_DOUT_CMU_DCAM_BUS>, <&cmu_top CLK_DOUT_CMU_DCAM_IMGD>;
			power-domains = <&pd_dcam>;	/* CAL:pmucal_local_exynos8895.h:172-187 dcam_save */
			status = "disabled";
		};

		cmu_isplp: clock-controller@13000000 {
			compatible = "samsung,exynos8895-cmu-isplp";
			reg = <0x13000000 0x8000>;	/* CAL:cmucal-sfr.c:28 SFR_BLOCK(ISPLP, 0x13000000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_ISPLP_BUS>;	/* CAL:cmucal-node.c:713 */
			clock-names = "oscclk", "bus";
			assigned-clocks = <&cmu_isplp CLK_MOUT_ISPLP_BUS_USER>;
			assigned-clock-parents = <&cmu_top CLK_DOUT_CMU_ISPLP_BUS>;
			power-domains = <&pd_isplp>;	/* CAL:pmucal_local_exynos8895.h:416-435 isplp_save */
			status = "disabled";
		};

		cmu_isphq: clock-controller@13100000 {
			compatible = "samsung,exynos8895-cmu-isphq";
			reg = <0x13100000 0x8000>;	/* CAL:cmucal-sfr.c:27 SFR_BLOCK(ISPHQ, 0x13100000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_ISPHQ_BUS>;	/* CAL:cmucal-node.c:709 */
			clock-names = "oscclk", "bus";
			assigned-clocks = <&cmu_isphq CLK_MOUT_ISPHQ_BUS_USER>;
			assigned-clock-parents = <&cmu_top CLK_DOUT_CMU_ISPHQ_BUS>;
			power-domains = <&pd_isphq>;	/* CAL:pmucal_local_exynos8895.h:385-400 isphq_save */
			status = "disabled";
		};

		cmu_g3d: clock-controller@13800000 {
			compatible = "samsung,exynos8895-cmu-g3d";
			reg = <0x13800000 0x8000>;	/* CAL:cmucal-sfr.c:25 SFR_BLOCK(G3D, 0x13800000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_G3D_SWITCH>,	/* CAL:cmucal-node.c:701 { OSCCLK_G3D, CLKCMU_G3D_SWITCH } */
				 <&cmu_top CLK_DOUT_CMU_HPM>;	/* CAL:cmucal-node.c:1864 parent CLKCMU_HPM */
			clock-names = "oscclk", "switch", "hpm";
			status = "disabled";
		};

		/* L6A slice gpu: Mali-G71 MP20 for the vendor kbase r16p0 (spec L6A_graphics.md 4.1) */
		gpu: gpu@13900000 {
			/*
			 * Stock "arm,mali" (FDT:4637); not "arm,mali-bifrost", whose
			 * lower-case interrupt names (Documentation/devicetree/bindings/gpu/arm,mali-bifrost.yaml)
			 * this driver does not use.
			 */
			compatible = "samsung,exynos8895-mali";
			reg = <0x13900000 0x5000>;	/* FDT:4638 <0x00 0x13900000 0x5000> */
			interrupts = <GIC_SPI 60 IRQ_TYPE_LEVEL_HIGH>,	/* FDT:4639 <0x00 0x3c 0x00> JOB */
				     <GIC_SPI 61 IRQ_TYPE_LEVEL_HIGH>,	/* <0x00 0x3d 0x00> MMU */
				     <GIC_SPI 59 IRQ_TYPE_LEVEL_HIGH>;	/* <0x00 0x3b 0x00> GPU */
			interrupt-names = "JOB", "MMU", "GPU";	/* FDT:4640 */
			power-domains = <&pd_g3d>;	/* FDT:4642 samsung,power-domain = <0x18> */
			/* FDT:4641 g3d_cmu_cal_id = <0xb040004>, ACPM index 0xb040004 & 0xffff */
			clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_G3D>;
			clock-names = "clk_mali";
			operating-points-v2 = <&gpu_opp_table>;
			#cooling-cells = <2>;		/* FDT:4644 */
			samsung,autosuspend-delay-ms = <50>;	/* FDT:4672 gpu_runtime_pm_delay_time = <0x32> */
			status = "disabled";
		};

		/*
		 * FDT:4648 gpu_dvfs_table column 0 inside [gpu_min_clock FDT:4655
		 * 0x3f7a0, gpu_max_clock FDT:4653 0x854d0]; each is also an ECT
		 * dvfs_g3d level (SB+0x4647c). No opp-microvolt: the APM owns the
		 * G3D voltage.
		 */
		gpu_opp_table: opp-table-gpu {
			compatible = "operating-points-v2";

			opp-260000000 {
				opp-hz = /bits/ 64 <260000000>;	/* 0x3f7a0 */
			};
			opp-338000000 {
				opp-hz = /bits/ 64 <338000000>;	/* 0x52850 */
			};
			opp-385000000 {
				opp-hz = /bits/ 64 <385000000>;	/* 0x5dfe8 */
			};
			opp-455000000 {
				opp-hz = /bits/ 64 <455000000>;	/* 0x6f158 */
			};
			opp-546000000 {
				opp-hz = /bits/ 64 <546000000>;	/* 0x854d0 */
			};
		};

		cmu_g2d: clock-controller@13a00000 {
			compatible = "samsung,exynos8895-cmu-g2d";
			reg = <0x13a00000 0x8000>;	/* CAL:cmucal-sfr.c:24 SFR_BLOCK(G2D, 0x13a00000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_G2D_G2D>,	/* CAL:cmucal-node.c:693 */
				 <&cmu_top CLK_DOUT_CMU_G2D_JPEG>;	/* CAL:cmucal-node.c:697 */
			clock-names = "oscclk", "g2d", "jpeg";
			assigned-clocks = <&cmu_g2d CLK_MOUT_G2D_G2D_USER>, <&cmu_g2d CLK_MOUT_G2D_JPEG_USER>;
			assigned-clock-parents = <&cmu_top CLK_DOUT_CMU_G2D_G2D>, <&cmu_top CLK_DOUT_CMU_G2D_JPEG>;
			power-domains = <&pd_g2d>;	/* CAL:pmucal_local_exynos8895.h:319-346 g2d_save */
			status = "disabled";
		};

		cmu_mfc: clock-controller@13c00000 {
			compatible = "samsung,exynos8895-cmu-mfc";
			reg = <0x13c00000 0x8000>;	/* CAL:cmucal-sfr.c:30 SFR_BLOCK(MFC, 0x13c00000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_MFC_BUS>;	/* CAL:cmucal-node.c:721 { OSCCLK_MFC, CLKCMU_MFC_BUS } */
			clock-names = "oscclk", "bus";
			assigned-clocks = <&cmu_mfc CLK_MOUT_MFC_BUS_USER>;
			assigned-clock-parents = <&cmu_top CLK_DOUT_CMU_MFC_BUS>;	/* UMUX := CLKCMU_MFC_BUS, stock ra.c:593-595 */
			power-domains = <&pd_mfc>;	/* CAL:pmucal_local_exynos8895.h:502-520 mfc_save */
			status = "disabled";
		};

		cmu_abox: clock-controller@13e00000 {
			compatible = "samsung,exynos8895-cmu-abox";
			reg = <0x13e00000 0x8000>;	/* CAL:cmucal-sfr.c:8 SFR_BLOCK(ABOX, 0x13e00000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,	/* OSCCLK_ABOX 26 MHz, CAL:cmucal-node.c:2237 */
				 <&cmu_top CLK_DOUT_CMU_ABOX_CPUABOX>;	/* CAL:cmucal-node.c:577-579 CPUABOX_USER parents */
			clock-names = "oscclk", "cpuabox";
			power-domains = <&pd_abox>;	/* CAL:pmucal_local_exynos8895.h:6-59 abox_save */
			status = "disabled";
		};

		pinctrl_abox: pinctrl@13e60000 {
			compatible = "samsung,exynos8895-pinctrl";
			reg = <0x13e60000 0x1000>;
		};

		cmu_vts: clock-controller@14000000 {
			compatible = "samsung,exynos8895-cmu-vts";
			reg = <0x14000000 0x8000>;	/* CAL:cmucal-sfr.c:40 SFR_BLOCK(VTS, 0x14000000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>;	/* OSCCLK_VTS 26 MHz, CAL:cmucal-node.c:2286 */
			clock-names = "oscclk";
			power-domains = <&pd_vts>;	/* CAL:pmucal_local_exynos8895.h:603-634 vts_save */
			status = "disabled";
		};

		pinctrl_vts: pinctrl@14080000 {
			compatible = "samsung,exynos8895-pinctrl";
			reg = <0x14080000 0x1000>;
		};

		cmu_srdz: clock-controller@14200000 {
			compatible = "samsung,exynos8895-cmu-srdz";
			reg = <0x14200000 0x8000>;	/* CAL:cmucal-sfr.c:38 SFR_BLOCK(SRDZ, 0x14200000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_SRDZ_BUS>,	/* CAL:cmucal-node.c:817 */
				 <&cmu_top CLK_DOUT_CMU_SRDZ_IMGD>;	/* CAL:cmucal-node.c:813 */
			clock-names = "oscclk", "bus", "imgd";
			assigned-clocks = <&cmu_srdz CLK_MOUT_SRDZ_BUS_USER>, <&cmu_srdz CLK_MOUT_SRDZ_IMGD_USER>;
			assigned-clock-parents = <&cmu_top CLK_DOUT_CMU_SRDZ_BUS>, <&cmu_top CLK_DOUT_CMU_SRDZ_IMGD>;
			power-domains = <&pd_srdz>;	/* CAL:pmucal_local_exynos8895.h:536-555 srdz_save */
			status = "disabled";
		};

		cmu_busc: clock-controller@15a00000 {
			compatible = "samsung,exynos8895-cmu-busc";
			reg = <0x15a00000 0x8000>;	/* CAL:cmucal-sfr.c:11 SFR_BLOCK(BUSC, 0x15a00000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_BUSC_BUS>,	/* CAL:cmucal-node.c:589 { OSCCLK_BUSC, CLKCMU_BUSC_BUS } */
				 <&cmu_top CLK_DOUT_CMU_BUSC_BUSPHSI2C>;	/* CAL:cmucal-node.c:593 { OSCCLK_BUSC, CLKCMU_BUSC_BUSPHSI2C } */
			clock-names = "oscclk", "bus", "busphsi2c";
			status = "disabled";
		};

		pinctrl_busc: pinctrl@15a30000 {
			compatible = "samsung,exynos8895-pinctrl";
			reg = <0x15a30000 0x1000>;
			interrupts = <GIC_SPI 103 IRQ_TYPE_LEVEL_HIGH>;
		};

		cmu_top: clock-controller@15a80000 {
			compatible = "samsung,exynos8895-cmu-top";
			reg = <0x15a80000 0x8000>;
			#clock-cells = <1>;
			clocks = <&oscclk>;
			clock-names = "oscclk";
		};

		adc: adc@15b70000 {
			compatible = "samsung,exynos8895-adc";	/* stock "samsung,exynos-adc-v3" FDT:7616 */
			reg = <0x15b70000 0x100>;			/* FDT:7617 */
			interrupts = <GIC_SPI 104 IRQ_TYPE_LEVEL_HIGH>;	/* FDT:7618 <0 0x68 0> */
			/* FDT:7621 <0x21 0x3f2> = GATE_ADCIF_BUSC_S0 (S:include/dt-bindings/clock/exynos8895.h:453) */
			clocks = <&cmu_busc CLK_GOUT_BUSC_ADCIF_BUSC_PCLK_S0>;
			clock-names = "adc";
			#io-channel-cells = <1>;			/* FDT:7619 */
			/* no vdd-supply: stock has none (FDT:7615-7625) */
			status = "disabled";
		};

		cmu_apm: clock-controller@16400000 {
			compatible = "samsung,exynos8895-cmu-apm";
			reg = <0x16400000 0x8000>;	/* CAL:cmucal-sfr.c:9 SFR_BLOCK(APM, 0x16400000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,	/* CAL:cmucal-node.c:581 parents { OSCCLK_APM, CLKCMU_APM_BUS } */
				 <&cmu_top CLK_DOUT_CMU_APM_BUS>;
			clock-names = "oscclk", "bus";
		};

		ap2apm_mailbox: mailbox@16440000 {
			compatible = "samsung,exynos8895-mbox";
			/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:2420 "<0x0 0x16440000 0x1000>," (AP2APM MAILBOX); FDT:6687 */
			reg = <0x16440000 0x1000>;
			/*
			 * CMU_APM MAILBOX_APM2AP pclk, APM+0x2038 bit 21
			 * (CAL:cmucal-sfr.c:147); the driver holds it enabled.
			 */
			clocks = <&cmu_apm CLK_GOUT_APM_MAILBOX_APM2AP_PCLK>;
			clock-names = "pclk";
			/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:2419 "interrupts = <0 39 0>;"; FDT:6686 */
			interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
			#mbox-cells = <0>;
			status = "disabled";
		};

		pmu_system_controller: system-controller@16480000 {
			compatible = "samsung,exynos8895-pmu",
				     "samsung,exynos7-pmu", "syscon";
			reg = <0x16480000 0x10000>;

			/*
			 * S-Boot boot target in INFORM3 (0x080c) for the stock
			 * commands (S:drivers/staging/samsung/sec_reboot.c:47-60,
			 * 170-226; offset S:include/linux/sec_ext.h:28). No
			 * mode-normal: INFORM2 and the NULL/unknown-command default
			 * 0x12345670 come from the PMU driver's priority-128 reboot
			 * notifier, which runs before this node's (priority 0), so
			 * this node only overrides INFORM3 for a matching command;
			 * a power-off (cmd NULL -> "normal") writes nothing, as
			 * stock sec_power_off() writes no INFORM3.
			 */
			reboot-mode {
				compatible = "syscon-reboot-mode";
				offset = <0x080c>;
				mode-download = <0x12345671>;	/* SEC_RESET_REASON_DOWNLOAD :51,178-179 */
				mode-upload = <0x12345672>;	/* SEC_RESET_REASON_UPLOAD :52,182-183 */
				mode-recovery = <0x12345674>;	/* SEC_RESET_REASON_RECOVERY :54,176-177 */
				mode-fota = <0x12345675>;	/* SEC_RESET_REASON_FOTA :55,172-173 */
				mode-fota_bl = <0x12345676>;	/* SEC_RESET_REASON_FOTA_BL :56,174-175 */
				mode-secure = <0x12345677>;	/* SEC_RESET_REASON_SECURE :57,184-185 */
				mode-fwup = <0x12345679>;	/* SEC_RESET_REASON_FWUP :58,186-187 */
				mode-bootloader = <0x1234567d>;	/* SEC_RESET_REASON_BOOTLOADER :60,180-181 */
			};

			/*
			 * MIPI D-PHYs: DSIM0 isolation at PMU+0x710 bit 0 (FDT:7476
			 * "isolation = <0x710>;", S:drivers/phy/phy-exynos8895-mipi.c:25
			 * EXYNOS_MIPI_PHY_ISO_BYPASS (1 << 0)); the PHY driver takes
			 * this node's parent as its PMU regmap.
			 */
			mipi_phy: mipi-phy {
				compatible = "samsung,exynos8895-mipi-video-phy";
				#phy-cells = <1>;
				status = "disabled";
			};
		};

		/*
		 * Power domains (spec/L1_platform.md 4.4). CONFIGURATION at reg + 0,
		 * STATUS + 4, OPTION + 8: S:arch/arm64/boot/dts/exynos/exynos8895-pm-domains.dtsi:18-135
		 * = CAL:pmucal_local_exynos8895.h <blk>_CONFIGURATION (CAL: =
		 * S:drivers/soc/samsung/cal-if/exynos8895/). Every node is added
		 * "disabled" (plan 2.3 D2). A board enables the nine whose stock
		 * on/off is CONFIGURATION/STATUS only and that host no DMA master
		 * S-Boot leaves running (cam dsp g2d isphq isplp mfc vpu dcam srdz,
		 * L1 4.4) once its PMU node is enabled (lpm_init before any
		 * power-off); a domain without a consumer is then switched off at
		 * sync_state. The other seven stay as S-Boot left them until their
		 * consumer layer enables them with its devices.
		 */
		pd_abox: power-domain@16484000 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x16484000 0x20>;	/* S:...-pm-domains.dtsi:18-24; CAL:pmucal_local_exynos8895.h:2 */
			#power-domain-cells = <0>;
			label = "abox";
			samsung,pmu-syscon = <&pmu_system_controller>;	/* ABOX_CA7_OPTION before off: CAL:...:62 */
			status = "disabled";	/* L6E: enabled with ABOX */
		};

		pd_cam: power-domain@16484020 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x16484020 0x20>;	/* S:...-pm-domains.dtsi:26-31; CAL:...:72 */
			#power-domain-cells = <0>;
			label = "cam";
			status = "disabled";	/* L1 4.4: enabled by the board (greatlte: -l1.dtsi) */
		};

		pd_dbg: power-domain@16484040 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x16484040 0x20>;	/* S:...-pm-domains.dtsi:33-38; CAL:...:124 */
			#power-domain-cells = <0>;
			label = "dbg";
			status = "disabled";	/* S:...-pm-domains.dtsi:37 status = "disabled" */
		};

		pd_dpu0: power-domain@16484060 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x16484060 0x20>;	/* S:...-pm-domains.dtsi:48-53; CAL:...:199 */
			#power-domain-cells = <0>;
			label = "dpu0";
			status = "disabled";	/* L5: live splash (DECON DMA) */
		};

		pd_dpu1: power-domain@16484080 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x16484080 0x20>;	/* S:...-pm-domains.dtsi:55-61; CAL:...:243 */
			#power-domain-cells = <0>;
			label = "dpu1";
			power-domains = <&pd_dpu0>;	/* S:...-pm-domains.dtsi:60 parent = <&pd_dpu0> */
			status = "disabled";	/* L5 */
		};

		pd_dsp: power-domain@164840a0 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x164840a0 0x20>;	/* S:...-pm-domains.dtsi:63-68; CAL:...:280 */
			#power-domain-cells = <0>;
			label = "dsp";
			status = "disabled";	/* L1 4.4: enabled by the board (greatlte: -l1.dtsi) */
		};

		pd_g2d: power-domain@164840c0 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x164840c0 0x20>;	/* S:...-pm-domains.dtsi:70-75; CAL:...:315 */
			#power-domain-cells = <0>;
			label = "g2d";
			status = "disabled";	/* L1 4.4: enabled by the board (greatlte: -l1.dtsi) */
		};

		pd_g3d: power-domain@164840e0 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			/*
			 * reg 1 = CMU_G3D, the PLL/mux words of g3d_on/g3d_off:
			 * CAL:...:358-360,371-373; CAL:cmucal-sfr.c:25
			 */
			reg = <0x164840e0 0x20>,	/* S:...-pm-domains.dtsi:77-82; CAL:...:361 */
			      <0x13800000 0x1000>;
			#power-domain-cells = <0>;
			label = "g3d";
			status = "disabled";	/* L6A: enabled with the GPU */
		};

		pd_isphq: power-domain@16484100 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x16484100 0x20>;	/* S:...-pm-domains.dtsi:84-90; CAL:...:381 */
			#power-domain-cells = <0>;
			label = "isphq";
			power-domains = <&pd_cam>;	/* S:...-pm-domains.dtsi:89 parent = <&pd_cam> */
			status = "disabled";	/* L1 4.4: enabled by the board (greatlte: -l1.dtsi) */
		};

		pd_isplp: power-domain@16484120 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x16484120 0x20>;	/* S:...-pm-domains.dtsi:92-98; CAL:...:412 */
			#power-domain-cells = <0>;
			label = "isplp";
			power-domains = <&pd_isphq>;	/* S:...-pm-domains.dtsi:97 parent = <&pd_isphq> */
			status = "disabled";	/* L1 4.4: enabled by the board (greatlte: -l1.dtsi) */
		};

		pd_iva: power-domain@16484140 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x16484140 0x20>;	/* S:...-pm-domains.dtsi:100-105; CAL:...:447 */
			#power-domain-cells = <0>;
			label = "iva";
			status = "disabled";	/* off clears VMCU_CTRL/PMU at 0x136d0000 first: CAL:...:486-491 */
		};

		pd_mfc: power-domain@16484160 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x16484160 0x20>;	/* S:...-pm-domains.dtsi:107-112; CAL:...:498 */
			#power-domain-cells = <0>;
			label = "mfc";
			status = "disabled";	/* L1 4.4: enabled by the board (greatlte: -l1.dtsi) */
		};

		pd_vpu: power-domain@16484180 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x16484180 0x20>;	/* S:...-pm-domains.dtsi:122-127; CAL:...:567 */
			#power-domain-cells = <0>;
			label = "vpu";
			status = "disabled";	/* L1 4.4: enabled by the board (greatlte: -l1.dtsi) */
		};

		pd_vts: power-domain@164841a0 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x164841a0 0x20>;	/* S:...-pm-domains.dtsi:129-135; CAL:...:599 */
			#power-domain-cells = <0>;
			label = "vts";
			status = "disabled";	/* L6E: enabled with VTS; CMUREF mux before off: CAL:...:637-638 */
		};

		pd_dcam: power-domain@16485220 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x16485220 0x20>;	/* S:...-pm-domains.dtsi:40-46; CAL:...:168 */
			#power-domain-cells = <0>;
			label = "dcam";
			power-domains = <&pd_srdz>;	/* S:...-pm-domains.dtsi:45 parent = <&pd_srdz> */
			status = "disabled";	/* L1 4.4: enabled by the board (greatlte: -l1.dtsi) */
		};

		pd_srdz: power-domain@16485420 {
			compatible = "samsung,exynos8895-pd", "samsung,exynos5433-pd";
			reg = <0x16485420 0x20>;	/* S:...-pm-domains.dtsi:114-120; CAL:...:532 */
			#power-domain-cells = <0>;
			label = "srdz";
			power-domains = <&pd_isplp>;	/* S:...-pm-domains.dtsi:119 parent = <&pd_isplp> */
			status = "disabled";	/* L1 4.4: enabled by the board (greatlte: -l1.dtsi) */
		};

		pinctrl_alive: pinctrl@164b0000 {
			compatible = "samsung,exynos8895-pinctrl";
			reg = <0x164b0000 0x1000>;

			wakeup-interrupt-controller {
				compatible = "samsung,exynos8895-wakeup-eint",
					     "samsung,exynos7-wakeup-eint";
				interrupt-parent = <&gic>;
				interrupts = <GIC_SPI 16 IRQ_TYPE_LEVEL_HIGH>;
			};
		};

		apm_sram: sram@16500000 {
			compatible = "mmio-sram";
			/* S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:2421 "<0x0 0x16500000 0xB400>;" (APM SRAM); FDT:6687 */
			reg = <0x16500000 0xb400>;
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0x16500000 0xb400>;
			/*
			 * Device mapping only: the ACPM driver maps it with devm_ioremap()
			 * (A:drivers/firmware/samsung/exynos-acpm.c:624) as stock
			 * (S:drivers/soc/samsung/acpm/acpm_ipc.c:725); without this the
			 * SRAM driver would add a write-combined mapping
			 * (A:drivers/misc/sram.c:391-399).
			 */
			no-memory-wc;
			status = "disabled";
		};

		cmu_cpucl0: clock-controller@16800000 {
			compatible = "samsung,exynos8895-cmu-cpucl0";
			reg = <0x16800000 0x8000>;	/* CAL:cmucal-sfr.c:15 SFR_BLOCK(CPUCL0, 0x16800000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_CPUCL0_SWITCH>,	/* CAL:cmucal-node.c:621 { OSCCLK_CPUCL0, CLKCMU_CPUCL0_SWITCH } */
				 <&cmu_top CLK_DOUT_CMU_HPM>,	/* CAL:cmucal-node.c:1567 parent CLKCMU_HPM */
				 <&cmu_top CLK_GOUT_CMU_DROOPDETECTOR>;	/* CAL:cmucal-node.c:1570-1571 parent CLKCMU_DROOPDETECTOR */
			clock-names = "oscclk", "switch", "hpm", "droop";
		};

		cmu_cpucl1: clock-controller@16900000 {
			compatible = "samsung,exynos8895-cmu-cpucl1";
			reg = <0x16900000 0x8000>;	/* CAL:cmucal-sfr.c:16 SFR_BLOCK(CPUCL1, 0x16900000, 0x8000) */
			#clock-cells = <1>;
			clocks = <&oscclk>,
				 <&cmu_top CLK_DOUT_CMU_CPUCL1_SWITCH>,	/* CAL:cmucal-node.c:1002 MUX_CLKCMU_CPUCL1_SWITCH_USER parents */
				 <&cmu_top CLK_DOUT_CMU_HPM>;	/* CAL:cmucal-node.c:1580 parent CLKCMU_HPM */
			clock-names = "oscclk", "switch", "hpm";
		};
	};

	/*
	 * Trips from the factory DT (FDT:9436-9748) and, for little, the ECT
	 * (spec/L2c_thermal.md 2.3). Stock "hot" 115 C, its level-7 threshold with
	 * the hardware trip armed, is the critical trip here (the driver needs one
	 * and programs it at level 7). Stock's power_allocator switch-on trips
	 * (55 C big, 78 C GPU) were "active"; ACK takes the switch-on from the first
	 * of two passive trips, walked in DT order, so they are passive and come
	 * first (A:drivers/thermal/gov_power_allocator.c:500-536). The governor and
	 * gains are on the TMU nodes (samsung,ipa-*); the driver selects
	 * power_allocator once the zone's cooling devices are power actors
	 * (spec/L2c_thermal.md 4.2); until then these zones run step_wise.
	 */
	thermal-zones {
		big-thermal {
			polling-delay-passive = <50>;	/* FDT:9440 <0x32> */
			polling-delay = <1000>;		/* FDT:9441 <0x3e8> */
			thermal-sensors = <&tmu_big>;
			sustainable-power = <2000>;	/* FDT:9444 <0x7d0> */

			trips {
				big_switch_on: big-switch-on {
					temperature = <55000>;	/* FDT:9460 mngs-alert0 <0xd6d8> */
					hysteresis = <2000>;	/* FDT:9461 <0x7d0> */
					type = "passive";	/* stock "active", see above */
				};

				big_passive: big-passive {
					temperature = <83000>;	/* FDT:9468 mngs-alert1 <0x14438> */
					hysteresis = <5000>;	/* FDT:9469 <0x1388> */
					type = "passive";
				};

				big-crit {
					temperature = <115000>;	/* FDT:9476 mngs-hot <0x1c138> */
					hysteresis = <5000>;	/* FDT:9477 */
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&big_passive>;
					cooling-device = <&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
							 <&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				};
			};
		};

		/*
		 * Stock APOLLO zone: the ECT THERMAL function "APOLLO" (sboot.bin
		 * SB:0x508d8) overrides the trip temperatures (its lower bounds, equal
		 * to FDT:9505-9562) and the upper limit of each map's <&cpu0 0 0>
		 * (FDT:9573-9608) with the cpufreq level of its max_frequency
		 * (S:drivers/thermal/of-thermal.c:541-634): 1690000, 1690000, 1456000,
		 * 1248000, 1053000, 598000, 598000 kHz = states 0, 0, 1, 2, 3, 7, 7 of
		 * the little table (cpucl1_opp_table, descending). step_wise, as stock
		 * (no governor property, IKC:2520).
		 */
		little-thermal {
			polling-delay-passive = <0>;	/* FDT:9498 */
			polling-delay = <0>;		/* FDT:9499 */
			thermal-sensors = <&tmu_little>;

			trips {
				little_alert0: little-alert0 {
					temperature = <20000>;	/* ECT SB:0x508dc; FDT:9505 */
					hysteresis = <5000>;	/* FDT:9506 */
					type = "active";
				};

				little_alert1: little-alert1 {
					temperature = <76000>;	/* ECT SB:0x508f0; FDT:9513 */
					hysteresis = <5000>;
					type = "active";
				};

				little_alert2: little-alert2 {
					temperature = <81000>;	/* ECT SB:0x50904; FDT:9521 */
					hysteresis = <5000>;
					type = "active";
				};

				little_alert3: little-alert3 {
					temperature = <86000>;	/* ECT SB:0x50918; FDT:9529 */
					hysteresis = <5000>;
					type = "active";
				};

				little_alert4: little-alert4 {
					temperature = <91000>;	/* ECT SB:0x5092c; FDT:9537 */
					hysteresis = <5000>;
					type = "active";
				};

				little_alert5: little-alert5 {
					temperature = <96000>;	/* ECT SB:0x50940; FDT:9545 */
					hysteresis = <5000>;
					type = "active";
				};

				little_alert6: little-alert6 {
					temperature = <101000>;	/* ECT SB:0x50954; FDT:9553 */
					hysteresis = <5000>;
					type = "active";
				};

				little-crit {
					temperature = <115000>;	/* FDT:9561 apo-hot; ECT SB:0x50968 */
					hysteresis = <5000>;
					type = "critical";
				};
			};

			cooling-maps {
				map0 {
					trip = <&little_alert0>;
					cooling-device = <&cpu0 0 0>;	/* 1690000 */
				};

				map1 {
					trip = <&little_alert1>;
					cooling-device = <&cpu0 0 0>;	/* 1690000 */
				};

				map2 {
					trip = <&little_alert2>;
					cooling-device = <&cpu0 0 1>;	/* 1456000 */
				};

				map3 {
					trip = <&little_alert3>;
					cooling-device = <&cpu0 0 2>;	/* 1248000 */
				};

				map4 {
					trip = <&little_alert4>;
					cooling-device = <&cpu0 0 3>;	/* 1053000 */
				};

				map5 {
					trip = <&little_alert5>;
					cooling-device = <&cpu0 0 7>;	/* 598000 */
				};

				map6 {
					trip = <&little_alert6>;
					cooling-device = <&cpu0 0 7>;	/* 598000 */
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <100>;	/* FDT:9615 <0x64> */
			polling-delay = <0>;		/* FDT:9616 */
			thermal-sensors = <&tmu_gpu>;
			sustainable-power = <2000>;	/* FDT:9619 <0x7d0> */

			trips {
				gpu_switch_on: gpu-switch-on {
					temperature = <78000>;	/* FDT:9635 gpu-alert0 <0x130b0> */
					hysteresis = <2000>;	/* FDT:9636 <0x7d0> */
					type = "passive";	/* stock "active", see above */
				};

				gpu_passive: gpu-passive {
					temperature = <88000>;	/* FDT:9643 gpu-alert1 <0x157c0> */
					hysteresis = <5000>;	/* FDT:9644 */
					type = "passive";
				};

				gpu-crit {
					temperature = <115000>;	/* FDT:9651 gpu-hot */
					hysteresis = <5000>;
					type = "critical";
				};
			};
			/* the cooling map to the GPU devfreq device is the GPU layer's */
		};

		isp-thermal {
			polling-delay-passive = <0>;	/* FDT:9673 */
			polling-delay = <0>;		/* FDT:9674 */
			thermal-sensors = <&tmu_isp>;

			trips {
				isp-crit {
					temperature = <115000>;	/* FDT:9712 isp-hot */
					hysteresis = <5000>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		/* Hypervisor Virtual Timer interrupt is not wired to GIC */
		interrupts = <GIC_PPI 13 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 14 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 11 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>,
			     <GIC_PPI 10 (GIC_CPU_MASK_SIMPLE(8) | IRQ_TYPE_LEVEL_LOW)>;
		/*
		 * Non-updatable, broken stock Samsung bootloader does not
		 * configure CNTFRQ_EL0
		 */
		clock-frequency = <26000000>;
	};
};

#include "exynos8895-pinctrl.dtsi"
#include "arm/samsung/exynos-syscon-restart.dtsi"

&poweroff {
	/*
	 * Stock power-off clears only PS_HOLD_CONTROL bit 8
	 * (S:drivers/staging/samsung/sec_reboot.c:147
	 * "exynos_pmu_update(EXYNOS_PMU_PS_HOLD_CONTROL, 0x1<<8, 0x0);",
	 * S:drivers/soc/samsung/exynos-reboot.c:77,188 0x330C "& 0xFFFFFEFF").
	 * The common node's "mask" alone writes the whole word 0x5200
	 * (A:drivers/power/reset/syscon-poweroff.c:71-74).
	 */
	mask = <0x100>;
	value = <0x0>;
};

/*
 * CPU DVFS: the stock cpufreq domains, domain@0 = cpus 0-3 with cal-id
 * ACPM_DVFS_CPUCL1 and domain@1 = cpus 4-7 with ACPM_DVFS_CPUCL0
 * (S:arch/arm64/boot/dts/exynos/exynos8895.dtsi:467-470, 512-515);
 * "#cooling-cells = <2>;" (:188, :225).
 */
&cpu0 {
	clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL1>;
	operating-points-v2 = <&cpucl1_opp_table>;
	#cooling-cells = <2>;
};

&cpu1 {
	clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL1>;
	operating-points-v2 = <&cpucl1_opp_table>;
	#cooling-cells = <2>;
};

&cpu2 {
	clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL1>;
	operating-points-v2 = <&cpucl1_opp_table>;
	#cooling-cells = <2>;
};

&cpu3 {
	clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL1>;
	operating-points-v2 = <&cpucl1_opp_table>;
	#cooling-cells = <2>;
};

&cpu4 {
	clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL0>;
	operating-points-v2 = <&cpucl0_opp_table>;
	#cooling-cells = <2>;
	/* ECT GEN DTM_PWR_Coeff[0] (MNGS), sboot.bin SB:0x4b288; S:drivers/thermal/samsung/exynos_tmu.c:1380-1393 */
	dynamic-power-coefficient = <465>;
};

&cpu5 {
	clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL0>;
	operating-points-v2 = <&cpucl0_opp_table>;
	#cooling-cells = <2>;
	dynamic-power-coefficient = <465>;
};

&cpu6 {
	clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL0>;
	operating-points-v2 = <&cpucl0_opp_table>;
	#cooling-cells = <2>;
	dynamic-power-coefficient = <465>;
};

&cpu7 {
	clocks = <&acpm_ipc EXYNOS8895_CLK_ACPM_DVFS_CPUCL0>;
	operating-points-v2 = <&cpucl0_opp_table>;
	#cooling-cells = <2>;
	dynamic-power-coefficient = <465>;
};
