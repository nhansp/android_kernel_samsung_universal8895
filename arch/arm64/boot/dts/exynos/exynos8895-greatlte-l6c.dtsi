/*
 * Samsung Galaxy Note 8 (greatlte, SM-N950N) board DT, part "l6c":
 * L6C modem, GNSS/sensor hub, grip, HRM (L6C 4).
 *
 * Included at the end of exynos8895-greatlte.dts, after L0's nodes, in the merge
 * order of FULL_IMAGE_PLAN.md 2.2. Owner: WP-6C; no other work package edits this
 * file (plan 2.3 rule D1). A node that two parts both configure (&usi9, &usi10)
 * is written identically in both files: dtc lets the later file win on a differing
 * value, which gl-verify V-DUP reports as an error. L0's reserved-memory stays in
 * the .dts; carveout additions and flag changes are &label edits here (plan X-8).
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

/* L6C 4.1 (6E modem) */

/* L6.7, plan X-8 (registered flag change): the ported shm_ipc needs the linear map of the CP window
 * (ZMB phys_to_virt: S:drivers/misc/mcu_ipc/shm_ipc.c:357; ZMB cells dma_map_single'd:
 * S:drivers/misc/modem_v1/link_device_memory_sbd.c:1033) and of the CP-log window (released page by page with
 * free_reserved_page() when the S-Boot token is not "on": S:.../shm_ipc.c:434-445, :585-587). Stock kept both mapped. */
&modem_mem {
	/delete-property/ no-map;
};

&cp_ram_logging_mem {
	/delete-property/ no-map;
};

&soc {
	/* AP<->CP mailbox. FDT:10652-10659; S:arch/arm64/boot/dts/exynos/exynos8895-greatlte_common.dtsi:1124-1130 */
	mcu_ipc_cp: mailbox@15b40000 {
		compatible = "samsung,exynos8895-mcu-ipc";	/* new; stock "samsung,exynos-shd-ipc-mailbox" FDT:10654 */
		reg = <0x15b40000 0x180>;			/* FDT:10655 <0x00 0x15b40000 0x180> */
		interrupts = <GIC_SPI 97 IRQ_TYPE_LEVEL_HIGH>;	/* FDT:10658 <0x00 0x61 0x00> */
		mcu,name = "mcu_ipc_cp";			/* FDT:10656 */
		mcu,id = <0>;					/* FDT:10657, MCU_CP (S:drivers/misc/mcu_ipc/mcu_ipc.h:20-24) */
		/* FDT:10653 mcu,irq_affinity_mask = <3> dropped: used only by ARGOS (D-8) */
	};
};

/ {
	/* CP shared-memory layout. FDT:10642-10650; S:.../modem-ss355ap-pdata.dtsi:370-379 (unit address dropped: no reg) */
	shmem_cp: shmem-ipc {
		compatible = "samsung,exynos8895-shm-ipc";	/* new; stock "samsung,exynos-shm_ipc" FDT:10643 */
		memory-region = <&modem_mem>, <&cp_ram_logging_mem>;	/* L0 4.5 labels; stock RESERVEDMEM_OF_DECLARE shm_ipc.c:459,:472 */
		memory-region-names = "modem_if", "cp_ram_logging";
		shmem,cp_size = <0x7a00000>;			/* FDT:10644 "CP 122MB" */
		shmem,vss_size = <0x600000>;			/* FDT:10645 "VSS 6MB" */
		shmem,ipc_offset = <0x8000000>;			/* FDT:10646 */
		shmem,ipc_size = <0x500000>;			/* FDT:10647 "5MB" */
		shmem,zmb_offset = <0x8500000>;			/* FDT:10648 (dtc prints "\bP\0" = 08 50 00 00); S:...pdata.dtsi:377 */
		shmem,zmb_size = <0xb00000>;			/* FDT:10649 "11MB" */
		samsung,acpm-dump = <&apm_sram>;		/* L2 4.2; replaces acpm_ipc dump-base/dump-size FDT:6692-6693 (0x16500000/0xb400) */
	};

	/* Modem interface. FDT:10286-10640; S:.../modem-ss355ap-pdata.dtsi:14-368 + S:.../exynos8895-greatlte_common.dtsi:1132-1140.
	 * Must stay at the root with this reg: platform device "10000.mif_pdata" (A:drivers/of/device.c:304-305, cbd path F-15),
	 * resource start 0x10000 = CP main-binary offset in the boot region (S:.../link_device_shmem.c:2085-2088, :3735);
	 * zero size is legal (A:drivers/of/address.c:195-196). */
	mif_pdata {
		compatible = "samsung,exynos8895-modem";	/* new; stock "sec_modem,modem_pdata" FDT:10288 */
		reg = <0x0 0x10000 0x0>;			/* FDT:10287 */
		interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>,	/* FDT:10290 idx 0 -> "cp_fail" (S:.../modem_ctrl_ss310ap.c:648) */
			     <GIC_SPI 57 IRQ_TYPE_LEVEL_HIGH>;	/*   idx 1 -> "cp_wdt" (:664); dtsi comment :20 names them ALIVE_CP_ACTIVE / CP2AP_RESET_REQ */
		samsung,mailbox = <&mcu_ipc_cp>;		/* new: probe ordering (5.1.1) */
		samsung,shmem = <&shmem_cp>;			/* new: probe ordering */
		samsung,pmu-syscon = <&pmu_system_controller>;	/* new: D-5 */

		mif,name = "ss355ap";				/* FDT:10291 */
		mif,modem_net = <0>;				/* FDT:10292 UMTS_NETWORK */
		mif,modem_type = <10>;				/* FDT:10293 SEC_SS310AP */
		mif,use_handover = <0>;				/* FDT:10294 */
		mif,ipc_version = <50>;				/* FDT:10295 0x32 = SIPC 5.0 */
		mif,link_types = <0x200>;			/* FDT:10296 LINKDEV_SHMEM */
		mif,link_name = "shmem";			/* FDT:10297 */
		mif,link_attrs = <0x7c9>;			/* FDT:10298 XMIT_BTDLR|DUMP_ALIGNED|BOOT_ALIGNED|MEM_DUMP|MEM_BOOT|DPRAM_MAGIC|SBD_IPC */
		mif,num_iodevs = <20>;				/* FDT:10299 0x14 */
		mif,buff_offset = <0x500000>;			/* FDT:10300 */
		mif,buff_size = <0x900000>;			/* FDT:10301 */
		mif,bufpool_2nd_base = <0xe9000000>;		/* FDT:10302 - parsed, never provided to CP (C-2) */
		mif,bufpool_2nd_size = <0x4000000>;		/* FDT:10303 */
		mbx_ap2cp_msg = <0>;				/* FDT:10304 */
		mbx_cp2ap_msg = <1>;				/* FDT:10305 */
		mbx_ap2cp_united_status = <2>;			/* FDT:10306 */
		mbx_cp2ap_united_status = <3>;			/* FDT:10307 */
		mbx_ap2cp_mif_value = <4>;			/* FDT:10308 */
		mbx_ap2cp_kerneltime = <9>;			/* FDT:10309 */
		mif,int_ap2cp_msg = <0>;			/* FDT:10310 */
		mif,int_ap2cp_wakeup = <1>;			/* FDT:10311 */
		mif,int_ap2cp_status = <2>;			/* FDT:10312 */
		mif,int_ap2cp_active = <3>;			/* FDT:10313 */
		mif,irq_cp2ap_msg = <0>;			/* FDT:10314 */
		mif,irq_cp2ap_status = <2>;			/* FDT:10315 */
		mif,irq_cp2ap_active = <4>;			/* FDT:10316 */
		mif,irq_cp2ap_wakelock = <8>;			/* FDT:10317 */
		mif,irq_cp2ap_ratmode = <9>;			/* FDT:10318 */
		mbx_cp2ap_dvfsreq_cpu = <5>;			/* FDT:10319 */
		mbx_cp2ap_dvfsreq_mif = <6>;			/* FDT:10320 */
		mbx_cp2ap_dvfsreq_int = <7>;			/* FDT:10321 */
		mif,irq_cp2ap_perf_req_cpu = <5>;		/* FDT:10322 */
		mif,irq_cp2ap_perf_req_mif = <6>;		/* FDT:10323 */
		mif,irq_cp2ap_perf_req_int = <7>;		/* FDT:10324 */
		sbi_cp_rat_mode_mask = <0x3f>;			/* FDT:10325 */
		sbi_cp_rat_mode_pos = <26>;			/* FDT:10326 0x1a */
		sbi_cp_evs_mode_mask = <0x1>;			/* FDT:10327 */
		sbi_cp_evs_mode_pos = <7>;			/* FDT:10328 */
		sbi_cp_wakelock_mask = <0x1>;			/* FDT:10329 */
		sbi_cp_wakelock_pos = <6>;			/* FDT:10330 */
		sbi_lte_active_mask = <0x1>;			/* FDT:10331 */
		sbi_lte_active_pos = <5>;			/* FDT:10332 */
		sbi_cp_status_mask = <0xf>;			/* FDT:10333 */
		sbi_cp_status_pos = <1>;			/* FDT:10334 */
		sbi_cp2ap_wakelock_mask = <0x1>;		/* FDT:10335 */
		sbi_cp2ap_wakelock_pos = <6>;			/* FDT:10336 */
		sbi_pda_active_mask = <0x1>;			/* FDT:10337 */
		sbi_pda_active_pos = <5>;			/* FDT:10338 */
		sbi_ap_status_mask = <0xf>;			/* FDT:10339 */
		sbi_ap_status_pos = <1>;			/* FDT:10340 */
		sbi_crash_type_mask = <0xf>;			/* FDT:10341 */
		sbi_crash_type_pos = <23>;			/* FDT:10342 0x17 */
		sbi_device_type_mask = <0x1f>;			/* FDT:10343 */
		sbi_device_type_pos = <18>;			/* FDT:10344 0x12 */
		sbi_ext_backtrace_mask = <0x1>;			/* FDT:10345 */
		sbi_ext_backtrace_pos = <17>;			/* FDT:10346 0x11 */
		sbi_ds_det_mask = <0x3>;			/* FDT:10347 */
		sbi_ds_det_pos = <14>;				/* FDT:10348 0x0e */
		sbi_sys_rev_mask = <0xff>;			/* FDT:10349 */
		sbi_sys_rev_pos = <6>;				/* FDT:10350 */
		sbi_lockval_cp2ap_dvfsreq_endian_mask = <0x1>;	/* FDT:10351 */
		sbi_lockval_cp2ap_dvfsreq_endian_pos = <31>;	/* FDT:10352 0x1f */
		sbi_lockval_cp2ap_dvfsreq_index_mask = <0x7fff>;	/* FDT:10353 */
		sbi_lockval_cp2ap_dvfsreq_index_pos = <0>;	/* FDT:10354 */
		sbi_ap2cp_kerneltime_sec_mask = <0xfff>;	/* FDT:10355 */
		sbi_ap2cp_kerneltime_sec_pos = <20>;		/* FDT:10356 0x14 */
		sbi_ap2cp_kerneltime_usec_mask = <0xfffff>;	/* FDT:10357 */
		sbi_ap2cp_kerneltime_usec_pos = <0>;		/* FDT:10358 */
		/* HW revision straps read into mailbox word 2 [13:6], bit n = GPIO n (S:.../modem_ctrl_ss310ap.c:144-167).
		 * FDT:10359: phandle 0xd7 = gpf1, 0x140 = gpd0 (work/scratch/L6_rest/phandles.txt);
		 * S:.../exynos8895-greatlte_common.dtsi:1133-1135 "XGPIO32-CP_REV0 ... XGPIO42-AP_REV3" */
		gpios = <&gpf1 1 GPIO_ACTIVE_HIGH>, <&gpf1 2 GPIO_ACTIVE_HIGH>,
			<&gpf1 3 GPIO_ACTIVE_HIGH>, <&gpf1 7 GPIO_ACTIVE_HIGH>,
			<&gpd0 0 GPIO_ACTIVE_HIGH>, <&gpd0 1 GPIO_ACTIVE_HIGH>,
			<&gpd0 2 GPIO_ACTIVE_HIGH>, <&gpd0 3 GPIO_ACTIVE_HIGH>;
		/* FDT:10360 pinctrl-names = "default" without pinctrl-0: no effect in stock, dropped */

		iodevs {					/* FDT:10362-10639, verbatim; channel ids per SIPC5 */
			io_device_0 {				/* FDT:10364-10376 */
				iod,name = "umts_ipc0"; iod,id = <0xeb>; iod,format = <0>; iod,io_type = <0>;
				iod,links = <0x200>; iod,attrs = <0x82>; iod,app = "RIL";
				iod,ul_num_buffers = <16>; iod,ul_buffer_size = <0x1000>;
				iod,dl_num_buffers = <32>; iod,dl_buffer_size = <0x1000>;
			};
			io_device_1 {				/* FDT:10378-10390 */
				iod,name = "umts_ipc1"; iod,id = <0xec>; iod,format = <0>; iod,io_type = <0>;
				iod,links = <0x200>; iod,attrs = <0x82>; iod,app = "RIL";
				iod,ul_num_buffers = <16>; iod,ul_buffer_size = <0x1000>;
				iod,dl_num_buffers = <32>; iod,dl_buffer_size = <0x1000>;
			};
			io_device_2 {				/* FDT:10392-10404 */
				iod,name = "umts_rfs0"; iod,id = <0xf5>; iod,format = <2>; iod,io_type = <0>;
				iod,links = <0x200>; iod,attrs = <0x82>; iod,app = "RFS";
				iod,ul_num_buffers = <16>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <512>; iod,dl_buffer_size = <0x800>;
			};
			io_device_3 {				/* FDT:10406-10418 */
				iod,name = "umts_csd"; iod,id = <0x1>; iod,format = <1>; iod,io_type = <0>;
				iod,links = <0x200>; iod,attrs = <0x82>; iod,app = "CSVT";
				iod,ul_num_buffers = <32>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <64>; iod,dl_buffer_size = <0x800>;
			};
			io_device_4 {				/* FDT:10420-10432 */
				iod,name = "umts_router"; iod,id = <0x19>; iod,format = <1>; iod,io_type = <0>;
				iod,links = <0x200>; iod,attrs = <0x82>; iod,app = "Data Router";
				iod,ul_num_buffers = <16>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <16>; iod,dl_buffer_size = <0x800>;
			};
			io_device_5 {				/* FDT:10434-10446 */
				iod,name = "umts_dm0"; iod,id = <0x1c>; iod,format = <1>; iod,io_type = <0>;
				iod,links = <0x200>; iod,attrs = <0x82>; iod,app = "DIAG";
				iod,ul_num_buffers = <16>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <128>; iod,dl_buffer_size = <0x800>;
			};
			/* io_device_6..13: rmnet0..rmnet7, FDT:10448-10562: ids 0x0a..0x11, format 1, io_type 1 (NET),
			 * links 0x200, attrs 0x180, napi_weight 0x40, ul/dl_num_buffers 0, ul/dl_buffer_size 0x800;
			 * io_device_6..9 carry iod,app = "NET", 10..13 have no iod,app (FDT:10508-10562) */
			io_device_6 {
				iod,name = "rmnet0"; iod,id = <0x0a>; iod,format = <1>; iod,io_type = <1>;
				iod,links = <0x200>; iod,attrs = <0x180>; iod,app = "NET"; iod,napi_weight = <64>;
				iod,ul_num_buffers = <0>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <0>; iod,dl_buffer_size = <0x800>;
			};
			io_device_7 {				/* FDT:10463-10476 */
				iod,name = "rmnet1"; iod,id = <0x0b>; iod,format = <1>; iod,io_type = <1>;
				iod,links = <0x200>; iod,attrs = <0x180>; iod,app = "NET"; iod,napi_weight = <64>;
				iod,ul_num_buffers = <0>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <0>; iod,dl_buffer_size = <0x800>;
			};
			io_device_8 {				/* FDT:10478-10491 */
				iod,name = "rmnet2"; iod,id = <0x0c>; iod,format = <1>; iod,io_type = <1>;
				iod,links = <0x200>; iod,attrs = <0x180>; iod,app = "NET"; iod,napi_weight = <64>;
				iod,ul_num_buffers = <0>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <0>; iod,dl_buffer_size = <0x800>;
			};
			io_device_9 {				/* FDT:10493-10506 */
				iod,name = "rmnet3"; iod,id = <0x0d>; iod,format = <1>; iod,io_type = <1>;
				iod,links = <0x200>; iod,attrs = <0x180>; iod,app = "NET"; iod,napi_weight = <64>;
				iod,ul_num_buffers = <0>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <0>; iod,dl_buffer_size = <0x800>;
			};
			io_device_10 {				/* FDT:10508-10520 (no iod,app) */
				iod,name = "rmnet4"; iod,id = <0x0e>; iod,format = <1>; iod,io_type = <1>;
				iod,links = <0x200>; iod,attrs = <0x180>; iod,napi_weight = <64>;
				iod,ul_num_buffers = <0>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <0>; iod,dl_buffer_size = <0x800>;
			};
			io_device_11 {				/* FDT:10522-10534 (no iod,app) */
				iod,name = "rmnet5"; iod,id = <0x0f>; iod,format = <1>; iod,io_type = <1>;
				iod,links = <0x200>; iod,attrs = <0x180>; iod,napi_weight = <64>;
				iod,ul_num_buffers = <0>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <0>; iod,dl_buffer_size = <0x800>;
			};
			io_device_12 {				/* FDT:10536-10548 (no iod,app) */
				iod,name = "rmnet6"; iod,id = <0x10>; iod,format = <1>; iod,io_type = <1>;
				iod,links = <0x200>; iod,attrs = <0x180>; iod,napi_weight = <64>;
				iod,ul_num_buffers = <0>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <0>; iod,dl_buffer_size = <0x800>;
			};
			io_device_13 {				/* FDT:10550-10562 (no iod,app) */
				iod,name = "rmnet7"; iod,id = <0x11>; iod,format = <1>; iod,io_type = <1>;
				iod,links = <0x200>; iod,attrs = <0x180>; iod,napi_weight = <64>;
				iod,ul_num_buffers = <0>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <0>; iod,dl_buffer_size = <0x800>;
			};
			io_device_14 {				/* FDT:10564-10576 */
				iod,name = "multipdp_hiprio"; iod,id = <0>; iod,format = <3>; iod,io_type = <2>;
				iod,links = <0x200>; iod,attrs = <0x180>; iod,app = "RIL";
				iod,ul_num_buffers = <256>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <256>; iod,dl_buffer_size = <0x800>;
			};
			io_device_15 {				/* FDT:10578-10590; attrs bit 12 = ATTR_ZEROCOPY (C-2) */
				iod,name = "multipdp"; iod,id = <0>; iod,format = <3>; iod,io_type = <2>;
				iod,links = <0x200>; iod,attrs = <0x1180>; iod,app = "RIL";
				iod,ul_num_buffers = <512>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <1024>; iod,dl_buffer_size = <0x8>;
			};
			io_device_16 {				/* FDT:10592-10600 */
				iod,name = "umts_boot0"; iod,id = <0xd7>; iod,format = <4>; iod,io_type = <0>;
				iod,links = <0x200>; iod,attrs = <0x2>; iod,app = "CBD";
			};
			io_device_17 {				/* FDT:10602-10610 */
				iod,name = "umts_ramdump0"; iod,id = <0xe1>; iod,format = <5>; iod,io_type = <0>;
				iod,links = <0x200>; iod,attrs = <0x202>; iod,app = "CBD";
			};
			io_device_18 {				/* FDT:10612-10624 */
				iod,name = "smd4"; iod,id = <0x21>; iod,format = <1>; iod,io_type = <0>;
				iod,links = <0x200>; iod,attrs = <0x882>;
				iod,ul_num_buffers = <16>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <128>; iod,dl_buffer_size = <0x800>;
				iod,option_region = "kor_single";
			};
			io_device_19 {				/* FDT:10626-10638; filtered out (region usa_att) but kept: mif,num_iodevs = 20 */
				iod,name = "umts_ciq0"; iod,id = <0x1a>; iod,format = <1>; iod,io_type = <0>;
				iod,links = <0x200>; iod,attrs = <0x882>;
				iod,ul_num_buffers = <16>; iod,ul_buffer_size = <0x800>;
				iod,dl_num_buffers = <128>; iod,dl_buffer_size = <0x800>;
				iod,option_region = "usa_att";
			};
		};
	};
};
