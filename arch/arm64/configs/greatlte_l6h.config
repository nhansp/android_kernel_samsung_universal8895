# greatlte charging extras (MAX77865 charger stages, IDT wireless receiver, AFC/QC, USB-PD).
# Every capability stays off; stages are enabled only on bench images with the user present.
# CONFIG_CHARGER_MAX77865_HV_GUARD is not set
# CONFIG_CHARGER_MAX77865_VBAT_OVP is not set
# CONFIG_CHARGER_MAX77865_SYSOVLO is not set
# CONFIG_CHARGER_MAX77865_AICL is not set
# CONFIG_CHARGER_MAX77865_TTF is not set
# CONFIG_CHARGER_MAX77865_AGE_FORECAST is not set
# CONFIG_WIRELESS_CHARGER_IDT_MFC is not set
# CONFIG_WIRELESS_CHARGER_IDT_MFC_NV is not set
# CONFIG_WIRELESS_CHARGER_IDT_MFC_HV is not set
# CONFIG_CHARGER_MAX77865_AFC is not set
# CONFIG_CHARGER_MAX77865_QC is not set
# CONFIG_CHARGER_MAX77865_TYPEC_RP is not set
# CONFIG_CHARGER_MAX77865_PD is not set
# CONFIG_CHARGER_MAX77865_USB_SS is not set
# CONFIG_CHARGER_MAX77865_TEST is not set
# the Type-C driver's PD voltage selection, as in greatlte_l6g.config
# CONFIG_TYPEC_S2MM005_PD_SELECT is not set
