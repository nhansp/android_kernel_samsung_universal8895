# arch/arm64/configs/greatlte_l6d.config -- greatlte L6D (PCIe, Wi-Fi, Bluetooth)
# Values of spec/L6D_connectivity.md 6.1.

# ---- L6D PCIe RC0 (K-F2) -------------------------------------------------------------
# gki:328 (repeat)
CONFIG_PCI=y
# dependency of every dwc glue (A:drivers/pci/controller/dwc/Kconfig:372); MSI itself unused (FDT:8248)
CONFIG_PCI_MSI=y
# new (6.2), selects PCIE_DW_HOST (no prompt, A:.../dwc/Kconfig:19-23)
CONFIG_PCIE_EXYNOS8895=y
# upstream 5433 glue, not ours (D1)
# CONFIG_PCI_EXYNOS is not set
# IKC:379 (PCIEAER gki:329 needs it)
CONFIG_PCIEPORTBUS=y
# IKC:380, gki:329 (repeat)
CONFIG_PCIEAER=y
# IKC:383; D10; prompt visible because CONFIG_EXPERT=y (gki:51, A:drivers/pci/pcie/Kconfig:76-78)
# CONFIG_PCIEASPM is not set

# Heartbeat rows (L6D 1.1, 5.8), DEBUG
CONFIG_GREATLTE_HB_L6D_PCIE=y

# ---- L6D Wi-Fi (K-F4z, K-F5) -----------------------------------------------------------
# IKC:1093
CONFIG_WIRELESS=y
# IKC:1094; D11
CONFIG_CFG80211=y
# IKC:1095
CONFIG_NL80211_TESTMODE=y
# IKC:1099
CONFIG_CFG80211_DEFAULT_PS=y
# IKC:1102
CONFIG_CFG80211_CRDA_SUPPORT=y
# IKC:1103
# CONFIG_CFG80211_WEXT is not set
# IKC:1106 (full-MAC dongle)
# CONFIG_MAC80211 is not set
# IKC:1109; gki:324 has m, CFG80211=y needs RFKILL!=m
CONFIG_RFKILL=y
# IKC:1113; D8
# CONFIG_RFKILL_GPIO is not set
# IKC:1799
CONFIG_WLAN=y
# gki:412 has it off
CONFIG_WLAN_VENDOR_BROADCOM=y
# IKC:1805; D5
# CONFIG_BRCMFMAC is not set
# CONFIG_BRCMSMAC is not set
# CONFIG_B43 is not set
# CONFIG_B43LEGACY is not set
# IKC:1806
CONFIG_BROADCOM_WIFI=y
# IKC:1817
CONFIG_BCM4361=y
# IKC:1824
CONFIG_BCMDHD_FW_PATH="/etc/wifi/bcmdhd_sta.bin"
# IKC:1825
CONFIG_BCMDHD_NVRAM_PATH="/etc/wifi/nvram_net.txt"
# IKC:1826
CONFIG_BROADCOM_WIFI_RESERVED_MEM=y
# IKC:1827
CONFIG_WLAN_REGION_CODE=200
# IKC:1828
CONFIG_WLAIBSS=y
# IKC:1829
CONFIG_WL_RELMCAST=y
# IKC:1830
# CONFIG_WL_NAN is not set
# IKC:1831
CONFIG_BCMDHD_PCIE=y
# IKC:1832
# CONFIG_BCMDHD_PREALLOC_PKTIDMAP is not set
# IKC:1833
CONFIG_BCMDHD_PREALLOC_MEMDUMP=y
# IKC:1836
CONFIG_BCMDHD_OOB_HOST_WAKE=y
# IKC:1837
CONFIG_SPLIT_ARGOS_SET=y
# IKC:1838 (symbol added, 5.5.2)
# CONFIG_WLAN_GRACE is not set
# IKC:1839 (symbol added, 5.5.2)
CONFIG_WLAN_GREAT=y
# IKC:1840
# CONFIG_BCM_DETECT_CONSECUTIVE_HANG is not set
# IKC:1841
# CONFIG_WLAN_TSQ_MULTIPLIER is not set
# IKC:1842
# CONFIG_DHD_DRIVEN_RANDOM_MAC_SCAN is not set
# new (6.2): replaces SOC_EXYNOS8895 in dhd
CONFIG_BCMDHD_EXYNOS8895=y


