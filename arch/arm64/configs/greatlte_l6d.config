# arch/arm64/configs/greatlte_l6d.config -- greatlte L6D (Bluetooth)
# Values of spec/L6D_connectivity.md 6.1 (K-G1, K-G2).
# One fragment per layer (T 5.3, REWRITE_PLAN.md 2.2), merged after greatlte_l6f.config.
# Everything is built in (=y).

# ---- L6D Bluetooth (K-G1, K-G2) ---------------------------------------------------------
# D11, IKC:1109; gki has m, needed for BCM43XX_BT_LPM dependency RFKILL=y
CONFIG_RFKILL=y
# gki:448 (repeat); SERIAL_SAMSUNG_UARTS has no prompt, default 4 (A:drivers/tty/serial/Kconfig:231-234) >= line 1
CONFIG_SERIAL_SAMSUNG=y
# new (6.2)
CONFIG_BCM43XX_BT_LPM=y
# CONFIG_BT stays at the gki value m (gki:315): Android's stack talks H4 to /dev/ttySAC1 from userspace (D9); the module is
#   built but never packed or loaded (X-18). Stock had BT=y (IKC:1070) only for its own hci code, which LOS does not use.

# Heartbeat rows (L6D 1.1, 5.8), DEBUG
CONFIG_GREATLTE_HB_L6D_BT=y
