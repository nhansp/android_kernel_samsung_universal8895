# arch/arm64/configs/greatlte_l4.config -- greatlte L4 (storage: UFS and SD).
# Values of spec/L4_storage.md 6; one fragment per layer (T 5.3, REWRITE_PLAN.md 2.2), merged after
# greatlte_l3.config (FULL_IMAGE_PLAN.md 2.3 K1). Everything is built in: UFS holds every partition
# LineageOS and the recovery mount, and nothing loads modules before the first-stage mount.
#
# Command line: first-stage init creates /dev/block/by-name/ only for the boot device named here
# (spec 5.5; the UFS host sits under soc@0 in the 6.18 DT, so the stock
# /dev/block/platform/11120000.ufs/by-name/ path cannot exist; the LOS fstab moves to /dev/block/by-name/).
# gl-cmdline: androidboot.boot_devices=soc@0/11120000.ufs

# SCSI disk layer (gki:370, 372; stock IK:1384, 1397).
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# UFS host, Exynos variant and its PHY (spec 5.1, 5.2). A:drivers/ufs/Kconfig:6;
# A:drivers/ufs/host/Kconfig:30, 120-129 (SCSI_UFS_EXYNOS depends on ARCH_EXYNOS);
# A:drivers/phy/samsung/Kconfig:32-40 (PHY_SAMSUNG_UFS selects GENERIC_PHY, MFD_SYSCON).
# Stock IK:1442 SCSI_UFSHCD=y, IK:1446 SCSI_UFSHCD_PLATFORM=y, IK:1450 SCSI_UFS_EXYNOS=y.
CONFIG_SCSI_UFSHCD=y
CONFIG_SCSI_UFSHCD_PLATFORM=y
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_PHY_SAMSUNG_UFS=y
# gki:609 has UFS crypto y. With it, exynos_ufs_fmp_init() sends 0xC2001850/0xC2001860
# (A:drivers/ufs/host/ufs-exynos.c:1256-1264), which are SMC_CMD_FMP_DUMP/SMC_CMD_LOG on this firmware
# (S:include/linux/smc.h:79-80), and turns on the 128-byte PRDT (SCSI_UFS_VARIABLE_SG_ENTRY_SIZE,
# A:drivers/ufs/host/Kconfig:131-133). The 8895 host runs FMP in DESCTYPE 0 = 16-byte PRDT (spec 5.1.6).
# CONFIG_SCSI_UFS_CRYPTO is not set
# Not needed on this device (gki y; n keeps the surface small), spec 6.
# CONFIG_SCSI_UFS_BSG is not set
# CONFIG_SCSI_UFS_HWMON is not set
# CONFIG_SCSI_UFS_FAULT_INJECTION is not set

# Partition tables: GPT on every UFS LUN, MBR on SD cards (stock IK:275, 282, 292;
# A:block/partitions/Kconfig:7, 121-123, 250-252). PARTITION_ADVANCED only exposes the other formats,
# which all default to n on arm64.
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y
CONFIG_MSDOS_PARTITION=y

# Already set by earlier fragments, repeated with the same value so V1 reports a later change against L4
# (plan 2.3 K1): EXYNOS_CHIPID (greatlte.config; soc_device_match() for the PMU 0x620 condition, spec
# 5.1.6), MFD_SYSCON (greatlte_l2.config; FSYS0 sysreg and PMU regmaps), REGULATOR_FIXED_VOLTAGE
# (greatlte_l2.config; ufs-vcc and vmmc).
CONFIG_EXYNOS_CHIPID=y
CONFIG_MFD_SYSCON=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# SD card: DesignWare MMC, Exynos variant (spec 5.4). gki:601; A:drivers/mmc/host/Kconfig:789-800,
# 820-826; stock IK:3791 MMC=y, IK:3801 MMC_BLOCK=y, IK:3817 MMC_DW=y, IK:3824 MMC_DW_EXYNOS=y.
# Stock's MMC_DW_FORCE_32BIT_SFR_RW=y (IK:3828) has no 6.18 symbol: the 8895 compatible sets
# DW_MMC_QUIRK_FIFO64_32 in the driver instead.
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_PLTFM=y
CONFIG_MMC_DW_EXYNOS=y
# gki:604 y; stock had no MMC FMP (IK:3818-3820) and dw_mmc has no crypto support.
# CONFIG_MMC_CRYPTO is not set

# LineageOS USERDATA uses software FBE ("fileencryption=aes-256-xts:aes-256-cts:v2", no inlinecrypt,
# LOS fstab.samsungexynos8895:22); the gki values stay (gki:123-124, 689-690) and the block-layer
# fallback keeps inlinecrypt usable without UFS crypto.
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y

# fstab file systems (ext4 SYSTEM/USERDATA/CACHE/EFS) and SD cards (vfat, exFAT).
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_EXFAT_FS=y
