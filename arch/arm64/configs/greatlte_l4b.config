# arch/arm64/configs/greatlte_l4b.config -- greatlte L4b (UFS inline encryption FMP, secure-world TRNG).
# Values of spec/L4b_fmp_rng.md 6; one fragment per work package (plan 2.3 K1), merged right after
# greatlte_l4.config (gl-build FRAG_ORDER). Everything is built in (=y).

# ---- L4b FMP (spec 5.3)
# overrides greatlte_l4.config: 8895 FMP hooks replace the gs101 SMCs (L4b 5.3). The 8895 drv data
# carries its own fmp_init/fmp_resume, so exynos_ufs_fmp_init() never sends the gs101 ids; with
# FMP_VERIFIED and the DEBUG KAT both n the host keeps the 16-byte PRDT and DESCTYPE 0 of today.
# gki:609; A:drivers/ufs/core/Kconfig:29. SCSI_UFS_VARIABLE_SG_ENTRY_SIZE follows (default y,
# A:drivers/ufs/host/Kconfig:131-133).
CONFIG_SCSI_UFS_CRYPTO=y
# spec D-5: set only by the follow-up commit after the KAT (T-L4b-2) and the write test (T-L4b-3b).
# CONFIG_SCSI_UFS_EXYNOS8895_FMP_VERIFIED is not set
# Not ported (spec D-7, 3.4): FIPS_FMP, NODE_FOR_SELFTEST_FAIL (IKC:5467-5468), FMP_DM_CRYPT (IKC:5465),
# UFS_FMP_DM_CRYPT (IKC:1385); no 6.18 symbols.

# Already set by greatlte_l4.config (63-66), repeated with the same value (plan 2.3 K1): the fscrypt
# inline path and its software fallback.
CONFIG_BLK_INLINE_ENCRYPTION=y
CONFIG_BLK_INLINE_ENCRYPTION_FALLBACK=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_INLINE_CRYPT=y

# ---- L4b secure-world TRNG (spec 5.1, 5.4)
# A:drivers/char/hw_random/Kconfig:495 (default HW_RANDOM if ARCH_EXYNOS; gki:459 HW_RANDOM=y); repeated.
CONFIG_HW_RANDOM_EXYNOS=y
# stock CONFIG_EXYRNG_FIPS_COMPLIANCE=y (IKC:2116): start-up test, HWRNG_RESUME
CONFIG_HW_RANDOM_EXYNOS8895_FIPS=y
# stock CONFIG_EXYRNG_FAIL_POLICY_RESET=y (IKC:2118): panic on a failed health test (user decision U-D2)
CONFIG_HW_RANDOM_EXYNOS8895_FAIL_RESET=y

# ---- L4b DEBUG heartbeat rows l4bfmp/l4brng (spec 5.5); the FMP known-answer test (5.6) only in the
# KAT test builds of spec 8.2 (T-L4b-1a/-2): it switches every UFS transfer to the 128-byte PRDT.
CONFIG_GREATLTE_HB_L4B=y
# CONFIG_SCSI_UFS_EXYNOS8895_FMP_KAT is not set
