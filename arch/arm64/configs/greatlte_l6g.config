# arch/arm64/configs/greatlte_l6g.config -- greatlte L6G (Type-C port controller, MUIC)
# Values of spec/L6G_typec_dp.md 6.1, block G1 only (G2 host role waits for REQ-L6F-G1 / O-G15;
# G4/G5 DisplayPort are design only, O-G13). Merged after greatlte_l6b.config (REQ-T-G1).

# ---- L6G G1: Type-C class, S2MM005, MUIC base ----
# gki:595; off in greatlte_base.config:113 (spec L6G N-3); stock IKC:3789 CONFIG_TYPEC=y
CONFIG_TYPEC=y
# gki:596; the S2MM005 is not a TCPC (its firmware runs PD)
# CONFIG_TYPEC_TCPM is not set
# gki:598
# CONFIG_TYPEC_UCSI is not set
# gki:599; no partner altmode is registered (spec L6G D-8)
# CONFIG_TYPEC_DP_ALTMODE is not set
# gki:600
# CONFIG_TYPEC_TBT_ALTMODE is not set
# stock IKC:4740 CONFIG_CCIC_S2MM005=y
CONFIG_TYPEC_S2MM005=y
# default n: charging path owned by L6H SAFETY (spec L6G 5.1.10)
# CONFIG_TYPEC_S2MM005_PD_SELECT is not set
# default n: raises VBUS (OTG boost); L6H 1A.1 row V1; G2 bench only
# CONFIG_TYPEC_S2MM005_OTG_VBUS is not set
# stock IKC:1373 CONFIG_MUIC_UNIVERSAL_MAX77865=y
CONFIG_TYPEC_MAX77865_MUIC=y
# the MUIC's max77865_muic.hv device (spec L6G 5.2.1)
CONFIG_AUXILIARY_BUS=y
# repeat of greatlte_l6f.config (sec/ccic, spec L6G 5.1.9)
CONFIG_SAMSUNG_SEC_CLASS=y

# ---- L6G G2: USB host role ----------------------------------------------------------------------------
# repeat of the L3 base; the mode choice moves from GADGET to DUAL_ROLE below
CONFIG_USB=y
# V-4: undo greatlte_l3.config's CONFIG_USB_DWC3_GADGET=y. The dwc3 mode is a choice
# (A:drivers/usb/dwc3/Kconfig:25-51) and V1 keeps the last fragment's request per symbol
# (tools/lib/kcheck.py:43-86), so the old value has to be cleared explicitly.
# CONFIG_USB_DWC3_GADGET is not set
# A:drivers/usb/dwc3/Kconfig:27-47; stock IKC:3590 CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_DWC3_DUAL_ROLE=y
# selected by DUAL_ROLE (A:drivers/usb/dwc3/Kconfig:8); listed so V1 checks it landed
CONFIG_USB_ROLE_SWITCH=y
# gki:568 (off in greatlte_base.config:109, spec L6G N-3); stock IKC:3513
CONFIG_USB_XHCI_HCD=y
# selected by DUAL_ROLE (A:drivers/usb/dwc3/Kconfig:7); stock IKC:3515
CONFIG_USB_XHCI_PLATFORM=y
# gki:575,576 (off in greatlte_base.config:111-112); stock IKC:3544: a USB stick on an OTG adapter
CONFIG_USB_STORAGE=y
CONFIG_USB_UAS=y
