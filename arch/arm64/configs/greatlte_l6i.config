# arch/arm64/configs/greatlte_l6i.config -- greatlte L6I (secure elements: NFC; eSE and MST not
# ported), values of spec/L6I_secure_elements.md 6.
# One fragment per work package (plan 2.3 K1); gl-build merges it after greatlte_l6h.config.
# Everything is built in (=y).

# Samsung NFC (stock IKC:1118, IKC:1123)
CONFIG_SAMSUNG_NFC=y
CONFIG_SEC_NFC=y
# provider of CLKOUT1 (oscclk_nfc); default y if ARCH_EXYNOS, same value as greatlte_l6e.config
CONFIG_EXYNOS_CLKOUT=y
# Not defined in 6.18 (stock y): ESE_P3_LSI, ESE_SECURE (D-3), MST_LDO, MFC_CHARGER (D-5),
# SEC_NFC_LOGGER (D-9).

# L6I heartbeat rows (1.1, 5.3), DEBUG: y while testing
CONFIG_GREATLTE_HB_L6I=y
