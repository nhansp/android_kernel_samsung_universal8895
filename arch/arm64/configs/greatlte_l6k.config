# arch/arm64/configs/greatlte_l6k.config -- greatlte L6K (misc I/O: certify hall, Gear VR HID,
# thermistors, DRAM temperature trip), values of spec/L6K_misc_io.md 6.
# One fragment per work package (plan 2.3 K1); gl-build merges it after greatlte_l6i.config.
# Everything is built in (=y).

# certify-hall-keys (4.1); repeats of greatlte_l6f.config, same value (rule K1)
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_SAMSUNG_SEC_KEY=y
# AP/WF/PA thermistor sensors (4.3); repeat of greatlte_l6f.config
CONFIG_GENERIC_ADC_THERMAL=y
# DRAM temperature trip (5.2); stock CONFIG_EXYNOS_MCINFO + CONFIG_MCINFO_SYSFS, IKC:4333-4334
CONFIG_EXYNOS8895_MCINFO=y
# stock HID class drivers that ACK has (D-5): IKC:3450, IKC:3449 (+ the Mad Catz ids of IKC:3476)
CONFIG_HID_SAMSUNG=y
CONFIG_HID_SAITEK=y
# Not set (stock y): HID_OVR, HID_TVR, USB_HMT_SAMSUNG_INPUT (D-2), SENSORS_SEC_THERMISTOR (D-3),
# CERTIFY_HALL (replaced by gpio-keys, D-1): no 6.18 symbols.
