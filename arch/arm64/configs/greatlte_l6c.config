# arch/arm64/configs/greatlte_l6c.config -- greatlte L6C (modem, GNSS/sensor hub, grip, HRM)
# Values of spec/L6C_modem_gnss.md 6.

# ---- L6C 6E modem (5.1) -------------------------------------------------------------------
# IKC:1335
CONFIG_SEC_SIPC_MODEM_IF=y
# IKC:1336; selects UMTS_MODEM_SS310AP, LINK_DEVICE_SHMEM, CP_SECURE_BOOT, CP_RAM_LOGGING and in the
# port MCU_IPC, SHM_IPC, MFD_SYSCON, EXYNOS8895_SMC (S:drivers/misc/modem_v1/Kconfig:9-15)
CONFIG_SEC_MODEM_SS310AP=y
# IKC:1325, :1327 (selected; repeated so gl-verify V1 checks them)
CONFIG_MCU_IPC=y
CONFIG_SHM_IPC=y
# IKC:1333, :1351, :1334 (selected)
CONFIG_LINK_DEVICE_SHMEM=y
CONFIG_UMTS_MODEM_SS310AP=y
CONFIG_CP_SECURE_BOOT=y
# IKC:1346: NAPI RX (mld_rx_int_poll)
CONFIG_LINK_DEVICE_NAPI=y
# IKC:1355 (C-8)
CONFIG_CP_RAM_LOGGING=y
# IKC:1357 (C-1): the PS channels map to the SBD QoS rings only with it
CONFIG_MODEM_IF_QOS=y
# IKC:1356, :1343, :1354, :1352, :1353 (stock)
# CONFIG_MODEM_IF_LEGACY_QOS is not set
# CONFIG_LINK_DEVICE_MEMORY is not set
# CONFIG_GPIO_DS_DETECT is not set
# CONFIG_DEBUG_PKTLOG is not set
# CONFIG_LINK_CONTROL_MSG_IOSM is not set
# new string (stock -DCONFIG_OPTION_REGION); FDT:10623 smd4 iod,option_region
CONFIG_OPTION_REGION="kor_single"
# L6F 5.11, selected (D-4)
CONFIG_EXYNOS8895_SMC=y
# base values relied on (plan X-2): gki:366 (apm_sram), MFD_SYSCON selected (PMU regmap, D-5),
# gki:80 (cbd takes /sys/power/wake_lock, 7.2)
CONFIG_SRAM=y
CONFIG_MFD_SYSCON=y
CONFIG_PM_WAKELOCKS=y

# ---- L6C 6I sensor hub + GNSS (5.2-5.4) -----------------------------------------------------
# owned here (I-14, C-10): spi_10 (hub) and L6E's spi_3; A:drivers/spi/Kconfig:1002-1004
CONFIG_SPI_S3C64XX=y
# IKC:4748; selects IIO_BUFFER, IIO_KFIFO_BUF, SAMSUNG_SEC_CLASS, SENSORS_SYSFS in the port
CONFIG_SENSORS_SSP=y
# IKC:4765, :4772, :4773, :4786, :4824
CONFIG_SENSORS_SYSFS=y
CONFIG_SENSORS_SSP_SENSORHUB=y
CONFIG_SENSORS_SSP_FACTORY=y
CONFIG_SENSORS_SSP_BBD=y
CONFIG_BCM_GPS_SPI_DRIVER=y
# sensor set of this board: IKC:4789, :4792, :4793, :4798, :4803, :4805, :4806, :4812, :4813,
# :4817, :4764, :4750, :4751, :4821
CONFIG_SENSORS_SSP_LSM6DSL=y
CONFIG_SENSORS_SSP_MAGNETIC_COMMON=y
CONFIG_SENSORS_SSP_LPS22H=y
CONFIG_SENSORS_SSP_TMD4906=y
CONFIG_SENSORS_SSP_PROX_AUTOCAL_AMS=y
CONFIG_SENSORS_SSP_LIGHT_REPORT_LUX=y
CONFIG_SENSORS_SSP_LIGHT_COLORID=y
CONFIG_SENSORS_SSP_INTERRUPT_GYRO_SENSOR=y
CONFIG_SENSORS_SSP_HIFI_BATCHING=y
CONFIG_SENSORS_SSP_GREAT=y
CONFIG_SENSORS_SSP_MOBEAM=y
CONFIG_SENSORS_MULTIPLE_GLASS_TYPE=y
CONFIG_SENSORS_SSP_IRDATA_FOR_CAMERA=y
CONFIG_SSP_SUPPORT_MAGNETIC_OVERFLOW=y
# IKC:4769-4771 (DT positions win)
CONFIG_SENSORS_SSP_ACCELEROMETER_POSITION=0
CONFIG_SENSORS_SSP_GYROSCOPE_POSITION=0
CONFIG_SENSORS_SSP_MAGNETOMETER_POSITION=0
# SSP_MOTOR_CALLBACK: stock y (IKC:4819), not ported, no Kconfig symbol (D-14)
# The patch compiled in, as stock (hardware finding, image 0072): LineageOS has no bbd_patch_great_p.bin, and the
# kernel's direct firmware loader resolves paths in the initial mount namespace, where no userspace overlay
# (Magisk) can put it, so request_firmware() fails with -ENOENT on every lhd open. D-18's file route needs the file
# in the vendor image first (device repo); until then the stock array (about 1 MiB of rodata) is served.
CONFIG_BBD_PATCH_BUILTIN=y
# new (5.4), replaces CONFIG_GPS_BCMxxxxx/CONFIG_GPS_BCM47531 (IKC:4835, :4839)
CONFIG_GPS_SEC_PWR=y
# L6F 5.9 (selected; D-13)
CONFIG_SAMSUNG_SEC_CLASS=y
# base values relied on (plan X-2): gki:468, :665-667
CONFIG_SPI=y
CONFIG_IIO=y
CONFIG_IIO_BUFFER=y
CONFIG_IIO_TRIGGER=y

# ---- L6C 6I-G grip, 6I-H HRM (5.9, 5.10) ---------------------------------------------------
# IKC:4810, :4811 (threshold carried for parity), :4809
CONFIG_SENSORS_SX9320=y
CONFIG_SENSORS_SX9320_NORMAL_TOUCH_THRESHOLD=221
# SENSORS_SX9320_MULTI: stock n (IKC:4809), not ported
# IKC:4825, :4826, :4830, :4831, :4832 (Kconfig default 70000)
CONFIG_SENSORS_HRMSENSOR=y
CONFIG_SENSORS_HRM_MAX86902=y
CONFIG_SENSORS_HRM_MAX869_ENHANCED_EOL=y
CONFIG_SENSORS_HRM_MAX869_NEW_EOL=y
CONFIG_MAX86902_THRESHOLD=80000
# bus and rail symbols repeated (plan X-2; owners L5, L6F): hsi2c_9/hsi2c_26, usi2/usi10, S2DOS03 ldo2/ldo4
CONFIG_I2C_EXYNOS5=y
CONFIG_EXYNOS_USI=y
CONFIG_REGULATOR_S2DOS03=y

# Heartbeat rows (L6C 1.1, 2.5), DEBUG
CONFIG_GREATLTE_HB_L6C=y
