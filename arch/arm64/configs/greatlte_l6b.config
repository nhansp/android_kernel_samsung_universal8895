# arch/arm64/configs/greatlte_l6b.config -- greatlte L6B (multimedia: MFC, camera, JPEG, scaler)
# Values of spec/L6B_multimedia.md 6. Two parts write this file: l6b (MFC review, FIMC-IS2)
# and l6b2 (S2MPB02, m2m1shot/SMFC/MSCL, MFC hook-up, heartbeat); each keeps its own blocks.

# ---- l6b: shared (5.3) ------------------------------------------------------------------
# new: multimedia QoS shim (INTCAM/CAM ACPM clocks, cluster freq_qos)
CONFIG_EXYNOS8895_MM_QOS=y

# ---- l6b: FIMC-IS2 camera (6D, 5.6) -------------------------------------------------------
# transplant keeps the stock symbol names; values IKC
CONFIG_VIDEO_EXYNOS_FIMC_IS2=y
CONFIG_EXYNOS_FIMC_IS=y
CONFIG_FIMC_IS_V5_2_0=y
CONFIG_EXYNOS_DEVICE_MIPI_CSIS_VER3=y
CONFIG_CSIS_V5_0=y
CONFIG_USE_CSI_DMAOUT_FEATURE=y
CONFIG_EXYNOS_FIMC_BNS=y
CONFIG_FIMC_BNS_V4_20_0=y
CONFIG_CAMERA_CIS_SELECT=y
CONFIG_CAMERA_CIS_3H1_OBJ=y
CONFIG_CAMERA_CIS_3H1_C3_OBJ=y
CONFIG_CAMERA_CIS_5E6_OBJ=y
CONFIG_CAMERA_CIS_3M3_OBJ=y
CONFIG_CAMERA_CIS_2L1_OBJ=y
CONFIG_CAMERA_CIS_2L2_OBJ=y
CONFIG_CAMERA_CIS_IMX333_OBJ=y
CONFIG_CAMERA_CIS_IMX320_OBJ=y
CONFIG_CAMERA_CIS_IMX320_C3_OBJ=y
CONFIG_CAMERA_ACT_SELECT=y
CONFIG_CAMERA_ACT_AK7371_OBJ=y
CONFIG_CAMERA_ACT_AK7372_OBJ=y
CONFIG_CAMERA_FLASH_SELECT=y
CONFIG_CAMERA_FLASH_S2MPB02_OBJ=y
CONFIG_CAMERA_FLASH_GPIO_OBJ=y
CONFIG_CAMERA_OIS_SELECT=y
CONFIG_USE_DIRECT_IS_CONTROL=y
CONFIG_CAMERA_MC_SCALER_VER2_USE=y
CONFIG_MC_SCALER_V3_0=y
CONFIG_USE_HW_API_COMMON=y
CONFIG_USE_SENSOR_GROUP=y
CONFIG_VENDER_MCD=y
CONFIG_CAMERA_EEPROM_SUPPORT_FRONT=y
CONFIG_COMPANION_USE=y
CONFIG_COMPANION_C3_USE=y
CONFIG_COMPANION_DIRECT_USE=y
CONFIG_COMPANION_C3_DIRECT_USE=y
CONFIG_COMPANION_DCDC_USE=y
CONFIG_PREPROCESSOR_STANDBY_USE=y
CONFIG_SENSOR_RETENTION_USE=y
CONFIG_OIS_USE=y
CONFIG_AF_HOST_CONTROL=y
CONFIG_CAMERA_GREAT=y
CONFIG_OIS_USE_RUMBA_S6=y
# stock =y IKC:2887. DEVIATION from spec 6 ("not set, factory only"): the option also
# builds fimc_is_comp_i2c_config() (vendor/mcd/fimc-is-companion_c3.c:1346), which the
# runtime CRC-on-close of the preprocessor calls (fimc-is-device-preprocessor.c:458-470)
CONFIG_COMPANION_FACTORY_VALIDATION=y
# stock =y IKC:2888; secure camera excluded (spec 2.6)
# CONFIG_SECURE_CAMERA_USE is not set
# stock =y IKC:2889 (spec 2.6)
# CONFIG_USE_SIGNED_BINARY is not set
# ---- l6b2: S2MPB02 camera PMIC (L6B 5.8) ------------------------------------------------
# IKC:2651
CONFIG_MFD_S2MPB02=y
# IKC:2719
CONFIG_REGULATOR_S2MPB02=y
# IKC:3871
CONFIG_LEDS_S2MPB02=y

# ---- l6b2: V4L2 core used by the MFC, SMFC and MSCL (L6B 6) -----------------------------
# gki =y already; repeated as L6B 6 lists them
CONFIG_MEDIA_SUPPORT=y
CONFIG_VIDEO_DEV=y
# IKC:2747 (no prompt; selected by the MFC and MSCL symbols)
CONFIG_V4L2_MEM2MEM_DEV=y
# replaces CONFIG_VIDEOBUF2_ION=y (IKC:2750); no prompt, selected by the transplants
CONFIG_VIDEOBUF2_DMA_CONTIG=y

# ---- l6b2: MFC v11 hook-up (L6B 5.5) -----------------------------------------------------
# new symbol for the transplant (stock CONFIG_VIDEO_EXYNOS_MFC=y IKC:2765, CONFIG_EXYNOS_MFC_V11=y IKC:2766)
CONFIG_VIDEO_EXYNOS8895_MFC=y
# CONFIG_EXYNOS_CONTENT_PATH_PROTECTION (stock =y IKC:4327) has no symbol in this tree: off (D-13)
