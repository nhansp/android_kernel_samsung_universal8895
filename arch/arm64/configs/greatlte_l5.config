# arch/arm64/configs/greatlte_l5.config -- greatlte L5 (display: SysMMUs, DECON0 with its DPP/DMA channels, DSIM0,
# the S6E3HA6 panel and the S2DOS03 panel PMIC).
# Values of spec/L5_display.md 6.2 (stage 5b; stage 5c, L6A REQ-L5-1..9, is code and has no symbol); one fragment per
# layer (T 5.3, REWRITE_PLAN.md 2.2), merged after greatlte_l4.config. Everything is built in (=y): the DECON and DSIM
# take the display over from S-Boot before userspace, and the heartbeat counters of the L5 DEBUG file are only live for
# built-in drivers (spec 5.9). L5 adds no permanent command-line token; the stage 5b-1 token drm_client_lib.active= is a
# run token of its gate image (gl-build --run). The heartbeat symbol CONFIG_GREATLTE_HB_L5 of the DEBUG commit belongs to
# tooling.config's images (T 6.1) and is not set here; CONFIG_DEBUG_LIST=y comes from tooling.config.
#
# System MMUs of the display (spec 4.5, 5.6). A:drivers/iommu/Kconfig:259-263 (ARCH_EXYNOS, selects IOMMU_API);
# IOMMU_DMA is def_bool on arm64 (:153-154); strict DMA is the default (:111) and stays: an identity default domain
# would leave translation off and hide the access-permission question of L5 OPEN-I2.
CONFIG_EXYNOS_IOMMU=y
CONFIG_IOMMU_DEFAULT_DMA_STRICT=y

# Exynos DRM with the new Exynos8895 DECON0 and the DSI host (spec 5.2, 5.3). A:drivers/gpu/drm/exynos/Kconfig:2
# (DRM_EXYNOS selects the KMS helpers and the client selection); DRM is y in gki:526. DRM_EXYNOS_DSI now also depends on
# DRM_EXYNOS8895_DECON and selects DRM_MIPI_DSI, DRM_PANEL and DRM_SAMSUNG_DSIM (A:drivers/gpu/drm/bridge/Kconfig:270).
# The other Exynos CRTC drivers stay off (wrong hardware, spec 5.1).
CONFIG_DRM=y
CONFIG_DRM_EXYNOS=y
CONFIG_DRM_EXYNOS8895_DECON=y
# CONFIG_DRM_EXYNOS5433_DECON is not set
# CONFIG_DRM_EXYNOS7_DECON is not set
# CONFIG_DRM_EXYNOS_FIMD is not set
CONFIG_DRM_EXYNOS_DSI=y
CONFIG_DRM_SAMSUNG_DSIM=y

# MIPI D-PHY of DSIM0 (spec 5.5), A:drivers/phy/samsung/Kconfig:14 (default y on ARCH_EXYNOS; listed so V1 notices drift).
CONFIG_PHY_EXYNOS_MIPI_VIDEO=y

# The panel (spec 5.7) and its PMIC on hsi2c_16 / usi5 (spec 5.8, 4.8). BACKLIGHT_CLASS_DEVICE (gki:527) is the panel
# Kconfig pattern. A:drivers/i2c/busses/Kconfig:680, A:drivers/soc/samsung/Kconfig:26 (both already y), MFD_SYSCON for
# the DPU sysregs (L2 sets it too, same value).
CONFIG_DRM_PANEL_SAMSUNG_S6E3HA6=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_REGULATOR_S2DOS03=y
CONFIG_I2C_EXYNOS5=y
CONFIG_EXYNOS_USI=y
CONFIG_MFD_SYSCON=y

# Console on the panel through the DRM fbdev client for stage 5b-2 (A:drivers/gpu/drm/clients/Kconfig:31). The full
# image's L6A fragment, merged later, overrides it to n (fb0 is then the S3CFB fb_info, plan X-31).
CONFIG_DRM_FBDEV_EMULATION=y

# Stage 5a, the "keep splash" kill switch of FULL_IMAGE_PLAN.md 3.3: simple-framebuffer over S-Boot's logo
# (A:drivers/video/fbdev/Kconfig:6,1784-1787; FB_SIMPLE needs !DRM_SIMPLEDRM). The /chosen node is disabled in this
# image. VT and FRAMEBUFFER_CONSOLE stay off (gki:435), as spec 6.1 has them by default.
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
# CONFIG_DRM_SIMPLEDRM is not set

# WP l5bl: the lcd class device "panel" of the S6E3HA6 panel (the stock
# lcd_device_register("panel") of S:drivers/video/fbdev/exynos/panel/panel_drv.c:673 and the sysfs
# attributes of sysfs.c:2012-2079 the Samsung lights HAL and the stock init rc use).
# A:drivers/video/backlight/Kconfig:11-21 (LCD_CLASS_DEVICE), not in gki_defconfig.
CONFIG_LCD_CLASS_DEVICE=y

# l5-ext: the vendor panel framework (work/full/l5-ext/DESIGN.md 2.2; stock EXYNOS_DECON_LCD* IKC:3114-3129), its lcd
# class device "panel" (IKC:3134) and the spi-gpio master of the panel's COPR port (IKC:2228, FDT:10268-10284).
CONFIG_DRM_PANEL_SAMSUNG_S6E3HA6_STOCK=y
CONFIG_SPI_GPIO=y
