# arch/arm64/configs/greatlte_l6f.config -- greatlte L6F (power supply, input, misc)
# Values of spec/L6F_power_input_misc.md 6 (L6.12 touchscreen).
# One fragment per layer (T 5.3, REWRITE_PLAN.md 2.2), merged after greatlte_l5.config.
# Everything is built in (=y).

CONFIG_TOUCHSCREEN_S6SY761=y
CONFIG_SAMSUNG_SEC_CLASS=y
CONFIG_GREATLTE_HB_L6F=y

# ---- slice pwr: MAX77865 MFD, charger, fuel gauge, AP ADC + NTC (L6F 6). THERMAL, THERMAL_OF
# (greatlte_l2), I2C_EXYNOS5, EXYNOS_USI (greatlte_l5) and IIO (gki_defconfig) are already y there.
CONFIG_POWER_SUPPLY=y
CONFIG_MFD_MAX77865=y
CONFIG_CHARGER_MAX77865=y
CONFIG_BATTERY_MAX17042=y
CONFIG_IIO=y
CONFIG_EXYNOS_ADC=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_GENERIC_ADC_THERMAL=y
CONFIG_I2C_EXYNOS5=y
CONFIG_EXYNOS_USI=y
