# arch/arm64/configs/greatlte_l6f.config -- greatlte L6F (power supply, input, misc)
# Values of spec/L6F_power_input_misc.md 6 (L6.12 touchscreen).
# One fragment per layer (T 5.3, REWRITE_PLAN.md 2.2), merged after greatlte_l5.config.
# Everything is built in (=y).

CONFIG_TOUCHSCREEN_S6SY761=y
CONFIG_SAMSUNG_SEC_CLASS=y
CONFIG_GREATLTE_HB_L6F=y

# Keys and hall (L6F slice A)
CONFIG_KEYBOARD_GPIO=y
CONFIG_INPUT_SAMSUNG_SEC_KEY=y

# greatlte L6F slice pen (L6F 6)
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_TOUCHSCREEN_WACOM_W9018=y

# ---- slice pwr: MAX77865 MFD, charger, fuel gauge, AP ADC + NTC (L6F 6). THERMAL, THERMAL_OF
# (greatlte_l2), I2C_EXYNOS5, EXYNOS_USI (greatlte_l5) and IIO (gki_defconfig) are already y there.
CONFIG_POWER_SUPPLY=y
CONFIG_MFD_MAX77865=y
CONFIG_CHARGER_MAX77865=y
# charging control is a permanent exclusion: the charger stays monitor-only (Kconfig default n)
# CONFIG_CHARGER_MAX77865_CHARGE_CONTROL is not set
CONFIG_BATTERY_MAX17042=y
CONFIG_IIO=y
CONFIG_EXYNOS_ADC=y
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_GENERIC_ADC_THERMAL=y
CONFIG_I2C_EXYNOS5=y
CONFIG_EXYNOS_USI=y

# slice hlp: greatlte haptics, PWM and RGB LED (L6F 6)
CONFIG_PWM=y
CONFIG_PWM_SAMSUNG=y
CONFIG_INPUT_MISC=y
CONFIG_INPUT_MAX77693_HAPTIC=y
CONFIG_NEW_LEDS=y
CONFIG_LEDS_CLASS=y
CONFIG_LEDS_MAX77865=y

# slice fp: fingerprint sensor, non-secure side (L6F 5.10, 6); selects EXYNOS8895_SMC. CPU_SPEEDUP uses the
# secure OS booster of greatlte_l6t.config (CONFIG_SECURE_OS_BOOSTER_API=y).
CONFIG_VFSSPI_EXYNOS8895=y
# Heartbeat rows fp, fpi (L6F 1.2), DEBUG
CONFIG_GREATLTE_HB_L6F_FP=y
