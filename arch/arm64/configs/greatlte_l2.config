# arch/arm64/configs/greatlte_l2.config -- greatlte L2 (power: ACPM, S2MPS17 PMIC and rails, CPU DVFS, TMU).
# Values of spec/L2_power.md 6; one fragment per layer (T 5.3, REWRITE_PLAN.md 2.2); merged after
# greatlte_l1.config. Everything is built in (=y): the PMIC must be up before the USB and SD probes, and
# nothing loads modules before the ramdisk (T 5.3: only Image and dtbs are built). L2 adds no command-line
# token. The heartbeat symbol CONFIG_GREATLTE_HB that builds the L2 DEBUG rows/printers belongs to
# tooling.config (T 6.1) and is not set here.
#
# AP2APM mailbox and the ACPM protocol (spec 5.1, 5.2). A:drivers/mailbox/Kconfig:2,58;
# A:drivers/firmware/samsung/Kconfig:3 (depends on MAILBOX).
CONFIG_MAILBOX=y
CONFIG_EXYNOS_MBOX=y
CONFIG_EXYNOS_ACPM_PROTOCOL=y
# ACPM DVFS clocks (spec 5.4, backported driver, drivers/clk/samsung/Kconfig:98, tristate, depends on
# EXYNOS_ACPM_PROTOCOL): =y because cpufreq-dt needs the CPU clocks before userspace.
CONFIG_EXYNOS_ACPM_CLK=y

# S2MPS17 PMIC over ACPM and its regulators (spec 5.3). A:drivers/mfd/Kconfig:1415 (selects MFD_SEC_CORE,
# which selects REGMAP_IRQ); A:drivers/regulator/Kconfig:1411. REGULATOR and REGULATOR_FIXED_VOLTAGE are
# already y (gki:507-508) and listed so V1 notices drift.
CONFIG_MFD_SEC_ACPM=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_S2MPS11=y

# CPU DVFS through the ACPM clocks (spec 4.5): cpufreq-dt on the OPP tables, schedutil by default.
# A:drivers/opp/Kconfig:2; A:drivers/cpufreq/Kconfig:105,196,215,253 (CPUFREQ_DT selects CPUFREQ_DT_PLATDEV
# and PM_OPP, :218-219). CPU_FREQ gki:94. ENERGY_MODEL stays as gki has it (gki:89): no EM is registered,
# the OPPs carry no voltage or power data (spec Q12).
CONFIG_PM_OPP=y
CONFIG_CPU_FREQ=y
CONFIG_CPUFREQ_DT=y
CONFIG_CPUFREQ_DT_PLATDEV=y
CONFIG_CPU_FREQ_GOV_SCHEDUTIL=y
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y

# TMU and thermal zones with the big/little CPU cooling maps (spec 4.6, 5.6). THERMAL gki:494, CPU_THERMAL
# gki:500; A:drivers/thermal/Kconfig:82,149,177,187; A:drivers/thermal/samsung/Kconfig:2 (depends on
# THERMAL_OF). THERMAL_EMULATION stays y (gki:503): the reason for the 8895 NULL guard in exynos_tmu (5.6).
CONFIG_THERMAL=y
CONFIG_THERMAL_OF=y
CONFIG_THERMAL_GOV_STEP_WISE=y
CONFIG_CPU_THERMAL=y
CONFIG_CPU_FREQ_THERMAL=y
CONFIG_EXYNOS_THERMAL=y
CONFIG_THERMAL_EMULATION=y

# DVFS plugin image of the APM firmware (spec 5.2.3 as corrected in work/acpm-debug): stock builds
# exynos8895_acpm_dvfs.fw into the kernel (S:firmware/Makefile:109-115, IK:1154 CONFIG_FIRMWARE_IN_KERNEL=y) and
# copies it into APM SRAM before the DP_A; exynos-acpm does the same with firmware_request_nowarn(). The file is
# firmware/exynos8895_acpm_dvfs.fw, the 0x5c00 bytes of the factory Image's struct builtin_fw at Image+0x1452130
# (sha256 a272830513378dc2fc5bfa23a3d08dbff38fffdf47b5b6c3de572cd4d0eea7e2). A:drivers/base/firmware_loader/Kconfig:4,
# 53, 86 (EXTRA_FIRMWARE_DIR without a leading '/' is relative to the source tree,
# A:drivers/base/firmware_loader/builtin/Makefile:4-6). FW_LOADER is gki's and listed so V1 notices drift.
CONFIG_FW_LOADER=y
CONFIG_EXTRA_FIRMWARE="exynos8895_acpm_dvfs.fw"
CONFIG_EXTRA_FIRMWARE_DIR="firmware"

# APM SRAM (spec 4.2; gki:366): the SRAM driver maps the pool, hence "no-memory-wc" on the node.
CONFIG_SRAM=y
# PMU syscon for the ACPM stop hook (spec 5.2.5, plan X-12): APM core power-down at PMU+0x8100.
# A:drivers/mfd/Kconfig:1634 (L1's S3C2410_WATCHDOG also selects it).
CONFIG_MFD_SYSCON=y

# The bring-up symbols of spec 6, DEBUG_FS (acpm/chan_stats, A:lib/Kconfig.debug:668) and DEBUG_LIST (list
# checks around the new ACPM notifier and list code, A:lib/Kconfig.debug:1725), are image-wide debug options:
# they are set by the tools' config/tooling.config of the debug images (FULL_IMAGE_PLAN.md X-34), not here,
# so that a release build (hardware fragments only) has neither.
