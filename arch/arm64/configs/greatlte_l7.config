# arch/arm64/configs/greatlte_l7.config -- greatlte L7 (power management: deep idle, suspend, RTC)
# Values of spec/L7_pm.md 6. One fragment per layer (T 5.3, REWRITE_PLAN.md 2.2), merged after the L6
# fragments. Everything is built in (=y). No permanent command-line token (spec 6); test-only --run tokens
# of spec 8.2: cpuidle_exynos8895.cpd_enabled=0, cpuidle_exynos8895.sicd_enabled=0 (every image with a live
# UART console), exynos8895_pm.cp_check=0, exynos8895_pm.apm_release=1, no_console_suspend.

# ---- deep idle and system suspend (spec 5.4, 5.5) ----
CONFIG_EXYNOS8895_PM=y
CONFIG_ARM_EXYNOS8895_CPUIDLE=y
# overrides gki_defconfig (gki:93 y): cpuidle-psci would match the same arm,idle-state nodes, and the second
# cpuidle_register() for the same CPUs fails; without it cpuidle-psci's faux device is never created
# (A:drivers/cpuidle/cpuidle-psci.c:478-493). PSCI_CPUIDLE_DOMAIN depends on it (A:drivers/cpuidle/Kconfig.arm:35-39).
# CONFIG_ARM_PSCI_CPUIDLE is not set
# gki:90-92 (repeat). menu (rating 20, A:drivers/cpuidle/governors/menu.c:527) beats teo (rating 19,
# A:drivers/cpuidle/governors/teo.c:537): the default governor is menu, as stock (IK:587).
CONFIG_CPU_IDLE=y
CONFIG_CPU_IDLE_GOV_MENU=y
CONFIG_CPU_IDLE_GOV_TEO=y
# gki:501 (repeat): cpuidle_cooling_register()
CONFIG_CPU_IDLE_THERMAL=y
# MCT as tick-broadcast device (spec 4.3): selected by ARCH_EXYNOS (A:arch/arm64/Kconfig.platforms:128-138) and
# by arm64 (repeat)
CONFIG_CLKSRC_EXYNOS_MCT=y
CONFIG_GENERIC_CLOCKEVENTS_BROADCAST=y
# default y with gki (repeat)
CONFIG_SUSPEND=y
CONFIG_PM_SLEEP=y
CONFIG_PM_SLEEP_SMP=y
# gki:79-80 (repeat): /sys/power/wake_lock for vendor/bin/cbd; Android's system_suspend drives /sys/power/state
CONFIG_PM_WAKELOCKS=y
CONFIG_PM_USERSPACE_AUTOSLEEP=y
# stock had it (IK:556), Android suspends through system_suspend instead
# CONFIG_PM_AUTOSLEEP is not set
# gki:78 (repeat): kept; "disk" runs none of the L7 suspend-only code
CONFIG_HIBERNATION=y
# gki:83-84 (repeat); stock IK:561-562,564
CONFIG_PM_DEBUG=y
CONFIG_PM_ADVANCED_DEBUG=y

# ---- rtc0 = S2MPS17 RTC (spec 5.10) ----
# not in gki (gki:619-622); depends on MFD_SEC_CORE (A:drivers/rtc/Kconfig:756-760), selected by L2's
# MFD_SEC_ACPM; stock IK:3976 CONFIG_RTC_DRV_S2MPS17=y
CONFIG_RTC_DRV_S5M=y
# Kconfig defaults (A:drivers/rtc/Kconfig:25-36,53-65; repeat): sleep time and system time from rtc0,
# stock IK:3889-3892
CONFIG_RTC_HCTOSYS=y
CONFIG_RTC_HCTOSYS_DEVICE="rtc0"
CONFIG_RTC_SYSTOHC=y
CONFIG_RTC_SYSTOHC_DEVICE="rtc0"
