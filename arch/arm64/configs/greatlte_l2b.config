# arch/arm64/configs/greatlte_l2b.config -- greatlte L2b (bus DVFS, spec/L2b_devfreq.md 6.1)
# One fragment per work package (plan 2.3 K1); gl-build merges it after the L6 fragments.
# Milestone M1 (K-3, K-4a, K-6). Everything is built in (=y).

# ---- L2b bus DVFS (M1: K-3, K-4a, K-6)
# IKC:4338; already y in the built image
CONFIG_PM_DEVFREQ=y
# IKC:4346; new symbol (spec 6.2), stock text S:drivers/devfreq/Kconfig:52-56
CONFIG_DEVFREQ_GOV_SIMPLE_INTERACTIVE=y
# IKC:4357; new driver (D1), stock S:drivers/devfreq/Kconfig:131-138
CONFIG_ARM_EXYNOS8895_BUS_DEVFREQ=y
# spec 1.3 B4 (l2v): the image default is the stock floors now that every
# in-tree consumer votes (GPU, ABOX, modem, UFS, SD via the votes merge
# d8454b6b7; DECON via the l2v display port). This removes the probe-time MIF
# pin (MIF held at 1794000 kHz under stage 2). The pin stays one boot switch
# away: run token exynos8895_bus.stage=2 restores it (plus the stock_floors /
# cpu_mif runtime masks); the T-J1 image adds exynos8895_bus.stage=0.
# Stated deviation from spec 1.3 ("image default is 2"): ordered by BRIEF-l2v.
CONFIG_ARM_EXYNOS8895_BUS_DEVFREQ_STAGE=4
# upstream exynos-bus, not used (D1); already n
# CONFIG_ARM_EXYNOS_BUS_DEVFREQ is not set

# ---- L2b DEBUG heartbeat rows, debugfs read-back, int_test_khz (M1: K-12)
CONFIG_GREATLTE_HB_L2B=y

# ---- L2b BTS (M3: K-9)
# new (spec 6.2, V-3): bandwidth -> MIF/INT floors
CONFIG_EXYNOS8895_BTS_BW=y
# IKC:4685. Built so that one image can A/B it: the registers are programmed only with the
# run token bts_exynos8895.program=1 (default off; spec M4 = on after T-BTS)
CONFIG_EXYNOS8895_BTS=y
