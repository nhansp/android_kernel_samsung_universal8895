# arch/arm64/configs/greatlte.config -- greatlte L0 (boot foundation)
#
# Platform: needed for the 8895 dtb (A:arch/arm64/boot/dts/exynos/Makefile) and later SoC drivers.
# Selects COMMON_CLK_SAMSUNG, CLKSRC_EXYNOS_MCT, EXYNOS_PMU, PINCTRL_EXYNOS, SOC_SAMSUNG
# (A:arch/arm64/Kconfig.platforms:128-137); their DT nodes are disabled at L0 (spec 4.6).
CONFIG_ARCH_EXYNOS=y
# default ARCH_EXYNOS, tristate (A:drivers/soc/samsung/Kconfig:15-18); built in so it probes without modules.
# ACK's exynos850 drvdata == stock 8895 register by register (spec 7.5).
CONFIG_EXYNOS_CHIPID=y

# Entry at S-Boot's load address (0x80080000 + n*16K, not 2 MiB aligned).
# A:arch/arm64/kernel/pi/map_kernel.c:102-103,245. Default y, visible only with EXPERT (A:arch/arm64/Kconfig:2341-2344).
CONFIG_RELOCATABLE=y
# Held constant (=y, as gki:72) across the spec 8.3 A/B. Selects RELOCATABLE (A:arch/arm64/Kconfig:2354-2356).
# No kaslr-seed from S-Boot (factory/dump/sboot.bin has no "kaslr-seed", "kaslr_seed" or "rng-seed"; "kaslr"
# occurs only at SB+0xfabc1 " kaslr_region=0x%x@0x%x" and SB+0x1052c8 "kaslr") and no RNDR on
# ARMv8.0 -> the virtual offset equals the physical misalignment only (A:arch/arm64/kernel/pi/kaslr_early.c:47-51);
# keeps "Kernel Offset: 0x..." in panic dumps (A:arch/arm64/kernel/setup.c:395-406) for offline symbolisation.
CONFIG_RANDOMIZE_BASE=y

# Command line: L0 contributes no token of its own (spec 6.2). The empty string replaces gki:75 (GKI's
# "console=ttynull ... kvm-arm.mode=protected bootconfig"); gl-build then sets the final string (T 5.3, 6.2).
CONFIG_CMDLINE=""
# L0's requirement: ours first, then " ", then S-Boot's bootargs (A:drivers/of/fdt.c:1093-1106, 1145-1160;
# same as gki:76). Inert in this fragment: the command-line-type choice depends on CMDLINE != ""
# (A:arch/arm64/Kconfig:2434-2437), so the olddefconfig of "make gki_defconfig greatlte.config" drops
# this line. It takes effect only where a later merge sets a non-empty CMDLINE before olddefconfig: in
# gl-build that is tooling.config's own CONFIG_CMDLINE_EXTEND=y (T 6.1, merged after this fragment), so
# L-V1's EXTEND check holds on the gl-build .config only (plan 5 X-26).
CONFIG_CMDLINE_EXTEND=y

# Initramfs: the pinned ramdisk is xz/CRC32 (T 5.4); gki:48 has RD_XZ off (A:usr/Kconfig:79-82).
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_XZ=y
