# arch/arm64/configs/greatlte_l3.config -- greatlte L3 (USB peripheral mode and adb).
# Values of spec/L3_usb.md 6; one fragment per layer (T 5.3, REWRITE_PLAN.md 2.2); merged after
# greatlte_l2.config. Everything is built in (=y): the recovery ramdisk has no modules to load. L3 adds no
# command-line token. Symbols that gki_defconfig or an earlier fragment already sets are repeated with the
# same value so V1 notices drift (plan 1.2 row "L3 | CONFIG_ANDROID_VENDOR_HOOKS, ZONE_DMA32, SWIOTLB", X-2).
# The L3 debug symbol CONFIG_GREATLTE_USB_DIAG follows CONFIG_GREATLTE_HB (tooling.config) and is not set here.
#
# Controller, glue and PHY (spec 5.1, 5.2). A:drivers/usb/Kconfig:29; A:drivers/usb/gadget/Kconfig:17;
# A:drivers/usb/dwc3/Kconfig:3,68 (USB_DWC3_EXYNOS depends on (ARCH_EXYNOS || COMPILE_TEST) && OF);
# A:drivers/phy/samsung/Kconfig:80-88 (depends on ARCH_EXYNOS && OF, TYPEC || !TYPEC, USB_DWC3_EXYNOS).
# gki:577,580.
CONFIG_USB_SUPPORT=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_PHY_EXYNOS5_USBDRD=y
# Peripheral-only dwc3 (spec 1.1, 6): the mode choice defaults to DUAL_ROLE when USB and USB_GADGET are both
# on (A:drivers/usb/dwc3/Kconfig:27; CONFIG_USB stays y in the trimmed base), which would also select
# USB_ROLE_SWITCH (:8). A:drivers/usb/dwc3/Kconfig:38.
CONFIG_USB_DWC3_GADGET=y

# adb over FunctionFS through configfs (spec 5.5; stock IKC:3740,3752). A:drivers/usb/gadget/Kconfig:232,384
# (USB_CONFIGFS_F_FS selects USB_F_FS); A:fs/configfs/Kconfig:2; gki:581,589. USB_LIBCOMPOSITE is promptless
# and selected by USB_CONFIGFS (A:drivers/usb/gadget/Kconfig:145-148): listed only so V1 checks it landed.
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_CONFIGFS_FS=y
# adbd's FunctionFS I/O uses Linux AIO and eventfd. A:init/Kconfig:1848,1868.
CONFIG_AIO=y
CONFIG_EVENTFD=y
# The legacy FunctionFS gadget would compete for the UDC. A:drivers/usb/gadget/legacy/Kconfig:218.
# CONFIG_USB_FUNCTIONFS is not set

# Orientation GPIO and the three PHY rails (spec 4.2). A:drivers/gpio/Kconfig:9.
CONFIG_GPIOLIB=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y

# The PHY re-tune after every soft-connect CSFTRST rides on the dwc3 vendor hook (spec 5.1.6b, P11):
# A:drivers/android/Kconfig:66-68 (depends on TRACEPOINTS); gki:678.
CONFIG_ANDROID_VENDOR_HOOKS=y
# DMA below 4 GiB for a 32-bit dwc3 mask (spec 5.3 DMA row, O18). A:mm/Kconfig:1168-1171; SWIOTLB is selected
# by ARM64 (A:arch/arm64/Kconfig:276). This controller reports GHWPARAMS0.AWIDTH 64 (Session 0 regdump
# 0x4020400a), so ACK sets a 64-bit mask (A:drivers/usb/dwc3/core.c:2278-2283); both stay as the fallback.
CONFIG_ZONE_DMA32=y
CONFIG_SWIOTLB=y
