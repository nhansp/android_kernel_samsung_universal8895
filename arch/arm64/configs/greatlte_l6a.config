# arch/arm64/configs/greatlte_l6a.config -- greatlte L6A (graphics: legacy ION, Mali-G71 kbase r16p0, the S3CFB
# front-end of the stock composer).
# Values of spec/L6A_graphics.md 6.1 (the spec names the L6 fragment greatlte_l6.config; this tree's fragment for the
# layer is greatlte_l6a.config). One fragment per layer (T 5.3, REWRITE_PLAN.md 2.2), merged after greatlte_l6t.config
# and so after greatlte_l5.config, whose CONFIG_DRM_FBDEV_EMULATION=y it overrides (L6A 6.1, 9.3). Everything is built
# in (=y). Each L6A slice appends its own block; the heartbeat symbols of the DEBUG commits belong to tooling.config's
# images and are not set here.

# S3CFB front-end (L6A 5.3; kill-switch group L6A.2 of 6.2: DRM_EXYNOS8895_S3CFB=n with DRM_FBDEV_EMULATION=y restores
# L5's stage 5b-2). FB and FB_DEVICE: A:drivers/video/fbdev/Kconfig:6, A:drivers/video/fbdev/core/Kconfig:13;
# DRM_FBDEV_EMULATION n so that fb0 is the S3CFB fb_info (REQ-L5-6, A:drivers/gpu/drm/clients/Kconfig:31);
# FRAMEBUFFER_CONSOLE n (its default follows DRM_FBDEV_EMULATION, A:drivers/video/console/Kconfig:73-76): fbcon must
# never draw into the S3CFB fb_info, which has no memory.
CONFIG_FB=y
CONFIG_FB_DEVICE=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
CONFIG_DRM_EXYNOS8895_S3CFB=y
