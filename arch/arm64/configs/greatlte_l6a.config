# arch/arm64/configs/greatlte_l6a.config -- greatlte L6A (graphics: legacy ION, Mali-G71 kbase, S3CFB front-end).
# Values of spec/L6A_graphics.md 6.1 (the spec names the L6 fragment greatlte_l6.config; this tree's fragment for the
# layer is greatlte_l6a.config). One fragment per layer (T 5.3, REWRITE_PLAN.md 2.2), merged after greatlte_l6t.config.
# Everything is built in (=y, L6A 6.1 "plan X-18"). Each slice adds its own block below.

# ---- L6A slice ion: legacy ION ABI shim and the upstream dma-heaps (L6A 5.2, 6.1; kill switch L6A.0 = ION_LEGACY_EXYNOS=n, 6.2)
# /dev/ion legacy ABI (L6A 5.2.2); stock IKC:4137 CONFIG_ION=y, IKC:4140 CONFIG_ION_EXYNOS=y
CONFIG_ION_LEGACY_EXYNOS=y
# upstream heaps system/system-uncached for AOSP consumers (A:drivers/dma-buf/Kconfig:69, heaps/Kconfig:1; gki:625)
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
# the CMA regions have one owner, the ION shim (L6A 5.2.1; A:drivers/dma-buf/heaps/Kconfig:8)
# CONFIG_DMABUF_HEAPS_CMA is not set
# kbase and S3CFB fences (A:drivers/dma-buf/Kconfig:4,20; SYNC_FILE is also selected by DRM, A:drivers/gpu/drm/Kconfig:15)
CONFIG_SYNC_FILE=y
CONFIG_SW_SYNC=y
# pageblock_order 9, so the 350 MiB camera_mem CMA pool (175 x 2 MiB) passes rmem_cma_setup's alignment check
# (L6A 1.2; A:kernel/dma/contiguous.c:487-490; A:mm/Kconfig:817; gki:137)
CONFIG_TRANSPARENT_HUGEPAGE=y
# Heartbeat row ion/ionb (L6A 8.1), DEBUG
CONFIG_GREATLTE_HB_L6A_ION=y

# ---- L6A slice s3cfb: S3CFB front-end (L6A 5.3; kill-switch group L6A.2 of 6.2: DRM_EXYNOS8895_S3CFB=n with DRM_FBDEV_EMULATION=y restores
# L5's stage 5b-2). FB and FB_DEVICE: A:drivers/video/fbdev/Kconfig:6, A:drivers/video/fbdev/core/Kconfig:13;
# DRM_FBDEV_EMULATION n so that fb0 is the S3CFB fb_info (REQ-L5-6, A:drivers/gpu/drm/clients/Kconfig:31);
# FRAMEBUFFER_CONSOLE n (its default follows DRM_FBDEV_EMULATION, A:drivers/video/console/Kconfig:73-76): fbcon must
# never draw into the S3CFB fb_info, which has no memory.
CONFIG_FB=y
CONFIG_FB_DEVICE=y
# CONFIG_DRM_FBDEV_EMULATION is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
CONFIG_DRM_EXYNOS8895_S3CFB=y

# ---- L6A slice gpu: kbase r16p0 (L6A 5.1), devfreq, chip-id revision (L6A 5.4), heartbeat rows (L6A 8.1).
# Stock: MALI_MIDGARD y (IKC:3011). The Samsung symbols MALI_DVFS, RT_PM, PM_QOS, SEC_CL_BOOST, VK_BOOST,
# EXYNOS_SECURE_RENDERING, EXYNOS_TRACE (IKC:2992-3019) do not exist here (platform/exynos is not ported, L6A 5.1.6),
# nor does MALI_KUTF (tests/ removed, L6A 5.1.1). Devfreq replaces Samsung DVFS (stock MALI_DEVFREQ n, IKC:2998);
# MALI_MIDGARD_DVFS depends on !MALI_DEVFREQ, so it is absent from .config. Stock had MIDGARD_ENABLE_TRACE and
# EXPERT y (IKC:2995, IKC:3000); L6A 6.1 turns them off.
CONFIG_MALI_MIDGARD=y
CONFIG_MALI_PLATFORM_THIRDPARTY_NAME="exynos8895"
CONFIG_MALI_DEVFREQ=y
# CONFIG_MALI_DMA_FENCE is not set
# CONFIG_MALI_GATOR_SUPPORT is not set
# CONFIG_MALI_MIDGARD_DVFS is not set
# CONFIG_MALI_MIDGARD_ENABLE_TRACE is not set
# CONFIG_MALI_EXPERT is not set
CONFIG_PM_DEVFREQ=y
CONFIG_DEVFREQ_GOV_SIMPLE_ONDEMAND=y
CONFIG_DEVFREQ_THERMAL=y
# nothing else may bind the GPU (user constraint)
# CONFIG_DRM_PANFROST is not set
CONFIG_EXYNOS_CHIPID_LEGACY_SYSFS=y
# Heartbeat rows (L6A 8.1), DEBUG
CONFIG_GREATLTE_HB_L6A_GPU=y
