# greatlte_release.config - release fragment for ROM builds of the Galaxy Note 8 (greatlte).
#
# Merged last, after gki_defconfig and the greatlte_*.config hardware fragments in their merge order:
#   gki_defconfig greatlte_base greatlte l1 l2 l3 l4 l4b l5 l6com l6t l6a l6f l6d l6e l6c l6b l6g l6i l6k l6l
#   l6m l2b l7 release
# It stands in for the bring-up tooling fragment and boot profile of the development builds: no heartbeat
# instruments, no self-tests, no permissive CFI, and only the command-line tokens the hardware needs.

# Identity of the release string (6.18.y-greatlte-g<sha>; init/Kconfig:266, gki_defconfig has "-4k").
CONFIG_LOCALVERSION="-greatlte"

# S-Boot replaces /chosen/bootargs wholesale, so these come from CONFIG_CMDLINE, extended by the bootloader's
# arguments (arch/arm64/Kconfig:2426,2449). They are the "# gl-cmdline:" tokens of greatlte_l4.config
# (first-stage by-name links on the UFS host) and greatlte_l6d.config (atomic DMA pool for the BCM4361 PCIe
# driver).
CONFIG_CMDLINE="androidboot.boot_devices=soc@0/11120000.ufs coherent_pool=2M"
CONFIG_CMDLINE_EXTEND=y

# Reboot 5 s after a panic, as the stock kernel does (N950NKSU5DZE2 IKCONFIG; lib/Kconfig.debug:1076).
CONFIG_PANIC_TIMEOUT=5

# Bring-up instruments stay out of release builds. GREATLTE_HB gates every GREATLTE_HB_* printer and the
# RAMCON, LASTKMSG, HS, USB_DIAG and CSPC diagnostics (drivers/soc/samsung/Kconfig:79-107).
# CONFIG_GREATLTE_HB is not set
# CONFIG_GREATLTE_L1_SELFTEST is not set

# A CFI violation traps instead of warning (arch/Kconfig:976).
# CONFIG_CFI_PERMISSIVE is not set
# lib/Kconfig.debug:1725
# CONFIG_DEBUG_LIST is not set
# KUnit and its test modules (lib/kunit/Kconfig:5).
# CONFIG_KUNIT is not set
