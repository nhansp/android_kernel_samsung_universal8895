# greatlte_release.config - release fragment for ROM builds of the Galaxy Note 8 (greatlte).
#
# Merged last, after gki_defconfig and the greatlte_*.config hardware fragments in their merge order:
#   gki_defconfig greatlte_base greatlte l1 l2 l3 l4 l4b l5 l6com l6t l6a l6f l6d l6e l6c l6b l6g l6i l6k l6l
#   l6m l2b l7 release
# It stands in for the bring-up tooling fragment and boot profile of the development builds: no heartbeat
# instruments, no self-tests, no permissive CFI, and only the command-line tokens the hardware needs.

# Identity of the release string (6.18.y-greatlte-g<sha>; init/Kconfig:266, gki_defconfig has "-4k").
CONFIG_LOCALVERSION="-greatlte"

# S-Boot replaces /chosen/bootargs wholesale, so these come from CONFIG_CMDLINE, extended by the bootloader's
# arguments (arch/arm64/Kconfig:2426,2449). They are the "# gl-cmdline:" tokens of greatlte_l4.config
# (first-stage by-name links on the UFS host) and greatlte_l6d.config (atomic DMA pool for the BCM4361 PCIe
# driver).
CONFIG_CMDLINE="androidboot.boot_devices=soc@0/11120000.ufs coherent_pool=2M"
CONFIG_CMDLINE_EXTEND=y

# Reboot 5 s after a panic, as the stock kernel does (N950NKSU5DZE2 IKCONFIG; lib/Kconfig.debug:1076).
CONFIG_PANIC_TIMEOUT=5

# Bring-up instruments stay out of release builds. GREATLTE_HB gates every GREATLTE_HB_* printer and the
# RAMCON, LASTKMSG, HS, USB_DIAG and CSPC diagnostics (drivers/soc/samsung/Kconfig:79-107).
# CONFIG_GREATLTE_HB is not set
# CONFIG_GREATLTE_L1_SELFTEST is not set

# A CFI violation traps instead of warning (arch/Kconfig:976).
# CONFIG_CFI_PERMISSIVE is not set
# lib/Kconfig.debug:1725
# CONFIG_DEBUG_LIST is not set
# KUnit and its test modules (lib/kunit/Kconfig:5).
# CONFIG_KUNIT is not set

# Nothing loads kernel modules on this device and the stock kernel is monolithic (N950NKSU5DZE2
# exynos8895-greatlte_defconfig:262, "# CONFIG_MODULES is not set"). The gki_defconfig "=m" options are either
# built in, where the stock kernel has them (same defconfig), or left out.
CONFIG_BT=y
CONFIG_MII=y
CONFIG_PPP=y
CONFIG_PPP_BSDCOMP=y
CONFIG_PPP_DEFLATE=y
CONFIG_PPP_MPPE=y
CONFIG_SLHC=y
CONFIG_USB_ACM=y
CONFIG_USB_NET_DRIVERS=y
CONFIG_USB_USBNET=y
CONFIG_USB_NET_AX8817X=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_USB_NET_CDC_EEM=y
CONFIG_USB_NET_CDC_NCM=y
CONFIG_USB_RTL8150=y
CONFIG_USB_RTL8152=y
CONFIG_USB_RTL8153_ECM=y
CONFIG_USB_SERIAL=y
CONFIG_USB_SERIAL_FTDI_SIO=y
# CONFIG_6LOWPAN is not set
# CONFIG_BT_BCM is not set
# CONFIG_BT_HCIBTSDIO is not set
# CONFIG_BT_HCIUART is not set
# CONFIG_BT_HIDP is not set
# CONFIG_BT_QCA is not set
# CONFIG_BT_RFCOMM is not set
# CONFIG_CAN is not set
# CONFIG_DWC_PCIE_PMU is not set
# CONFIG_GNSS is not set
# CONFIG_HW_RANDOM_CCTRNG is not set
# CONFIG_IEEE802154 is not set
# CONFIG_IKHEADERS is not set
# CONFIG_L2TP is not set
# CONFIG_MACSEC is not set
# CONFIG_MTK_GZVM is not set
# CONFIG_NET_9P is not set
# CONFIG_NFC is not set
# CONFIG_OPEN_DICE is not set
# CONFIG_POWER_SEQUENCING is not set
# CONFIG_PPS is not set
# CONFIG_PPTP is not set
# CONFIG_PTP_1588_CLOCK is not set
# CONFIG_TIPC is not set
# CONFIG_USB4 is not set
# CONFIG_USB_MON is not set
# CONFIG_USB_NET_AQC111 is not set
# CONFIG_VCPU_STALL_DETECTOR is not set
# CONFIG_VIRTIO_BALLOON is not set
# CONFIG_VIRTIO_BLK is not set
# CONFIG_VIRTIO_CONSOLE is not set
# CONFIG_VIRTIO_PCI is not set
# CONFIG_VIRTIO_VSOCKETS is not set
# CONFIG_VLAN_8021Q is not set
# CONFIG_WWAN is not set
