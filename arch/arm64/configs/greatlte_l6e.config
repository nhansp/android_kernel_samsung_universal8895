# arch/arm64/configs/greatlte_l6e.config -- greatlte L6E (audio: CS47L93 codec, MAX98506 amp, ABOX, VTS)
# Values of spec/L6E_audio.md 6 (all =y, plan X-18).

# ---- base ------------------------------------------------------------------------------
# gki:536 (repeat, so V1 catches drift)
CONFIG_SND_SOC=y
# A:sound/soc/samsung/Kconfig:2 (menu for the ABOX/VTS/card entries)
CONFIG_SND_SOC_SAMSUNG=y
# selected by the ABOX entry; comprC0D5 offload node (P-U2)
CONFIG_SND_SOC_COMPRESS=y

# ---- codec (CS47L93 on SPI3) -----------------------------------------------------------
# A:drivers/mfd/Kconfig:345
CONFIG_MFD_MADERA=y
# IKC:2599
CONFIG_MFD_MADERA_SPI=y
# IKC:2604
CONFIG_MFD_CS47L92=y
# IKC:2698 (micvdd)
CONFIG_REGULATOR_ARIZONA_MICSUPP=y
# selected by the card (promptless, A:sound/soc/codecs/Kconfig:1089-1091)
CONFIG_SND_SOC_CS47L92=y
# default y with SND_SOC_MADERA=y (A:sound/soc/codecs/Kconfig:399-404): DSP1 controls
CONFIG_SND_SOC_WM_ADSP=y
# L6COM item (DUPLICATE OF wp/l6f-fp, same value): the codec's SPI controller
CONFIG_SPI_S3C64XX=y

# ---- jack, amp --------------------------------------------------------------------------
# A:drivers/extcon/Kconfig:2
CONFIG_EXTCON=y
# new, 5.5 (stock SWITCH_MADERA IKC:3882 replaced by extcon)
CONFIG_EXTCON_MADERA=y
# new, 5.6; IKC:3329
CONFIG_SND_SOC_MAX98506=y

# ---- ABOX, VTS -------------------------------------------------------------------------
# 5.7; IKC:3290-3291 (SEC_SND_ADAPTATION folded in)
CONFIG_SND_SOC_SAMSUNG_ABOX=y
# selected by ABOX (L6F 5.11)
CONFIG_EXYNOS8895_SMC=y
# 5.8; IKC:3292-3293
CONFIG_SND_SOC_SAMSUNG_MAILBOX=y
CONFIG_SND_SOC_SAMSUNG_VTS=y
# new, 5.9 (stock SND_SOC_SAMSUNG_EXYNOS8895_ASHETON, IKC:3287)
CONFIG_SND_SOC_EXYNOS8895_MADERA=y

# ---- platform ---------------------------------------------------------------------------
# A:drivers/clk/samsung/Kconfig:88 (codec MCLK, 5.10)
CONFIG_EXYNOS_CLKOUT=y
# L5 (repeat): ABOX SysMMU
CONFIG_EXYNOS_IOMMU=y
# gki:796 (repeat)
CONFIG_DMA_CMA=y
# IKC:1177; 12.5 MiB contiguous ABOX buffers (O-E6); 6.18 default 16 (A:kernel/dma/Kconfig:192-196)
CONFIG_CMA_SIZE_MBYTES=20
# gki (repeat): lazy firmware load on first runtime resume (5.7.3)
CONFIG_FW_LOADER=y

# Heartbeat rows (L6E 1.1), DEBUG
CONFIG_GREATLTE_HB_L6E=y
