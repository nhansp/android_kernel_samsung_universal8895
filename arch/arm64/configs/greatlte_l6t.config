# arch/arm64/configs/greatlte_l6t.config -- greatlte L6T (Trustonic Kinibi 400 TEE: MobiCore driver, secure OS
# booster, secure RPMB proxy, secure-world log).
# Values of spec/L6T_tee.md 6 (the spec names the L6 fragment greatlte_l6.config; this tree's fragment for the layer is
# greatlte_l6t.config). One fragment per layer (T 5.3, REWRITE_PLAN.md 2.2), merged after greatlte_l6com.config.
# Everything is built in (=y). Not set because the symbols are not ported: TRUSTONIC_TRUSTED_UI,
# TRUSTONIC_TRUSTED_UI_FB_BLANK, TRUSTED_UI_TOUCH_ENABLE, SECURE_OS_CONTROL (stock y, IKC:4721-4724).
# CONFIG_CRYPTO_SHA1 comes via select (stock IKC:5407). Relied on, owned elsewhere: # CONFIG_SHADOW_CALL_STACK is not set
# (greatlte_base.config; L6T R-T7), CONFIG_HOTPLUG_CPU (PM_SLEEP_SMP), CONFIG_CFI=y is fine (L6T 5.0).

# MobiCore driver (L6T 5.0-5.3): IKC:4718, IKC:4719, IKC:4720; PANIC_ON_HALT is new, off = D-6 (stock panicked,
# S:.../mcp.c:280)
CONFIG_TRUSTONIC_TEE=y
CONFIG_TRUSTONIC_TEE_LPAE=y
# CONFIG_TRUSTONIC_TEE_DEBUG is not set
# CONFIG_TRUSTONIC_TEE_PANIC_ON_HALT is not set

# Secure OS booster (L6T 5.4, 5.8): IKC:4725, IKC:4726
CONFIG_SECURE_OS_BOOSTER_API=y
# CONFIG_SECURE_OS_SUPPORT_MCT_DISABLE is not set

# Secure RPMB proxy (L6T 5.9, 6T-R; stock IKC:1388 CONFIG_UFS_SRPMB=y) and secure-world log (L6T 5.12, 6T-S;
# IKC:4324); both select EXYNOS8895_SMC (L6F 5.11)
CONFIG_EXYNOS_UFS_SRPMB=y
CONFIG_EXYNOS_SECURE_LOG=y

# adb-root test reads of /sys/kernel/debug/trustonic_tee (L6T 1.2 note), not the daemon (IKC:5118)
CONFIG_DEBUG_FS=y

# Heartbeat rows (L6T 5.10), DEBUG
CONFIG_GREATLTE_HB_L6T=y
