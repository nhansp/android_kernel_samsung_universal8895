# arch/arm64/configs/greatlte_l1.config -- greatlte L1 (platform: clocks, pinctrl, PMU, power domains,
# watchdog, restart/reboot mode). Values of spec/L1_platform.md 6; one fragment per layer (T 5.3,
# REWRITE_PLAN.md 2.2); merged after greatlte.config. L1 adds no permanent command-line token: its
# deliverable is running without clk_ignore_unused/pd_ignore_unused, which are test-only --run tokens
# (REWRITE_PLAN.md 5 X-3, X-20). The L1 self-test symbol CONFIG_GREATLTE_L1_SELFTEST is a DEBUG symbol
# (plan 3.1) and is not set here.
#
# Platform (repeated from L0 so V1 checks them, X-2). ARCH_EXYNOS selects COMMON_CLK_SAMSUNG, EXYNOS_PMU,
# PINCTRL_EXYNOS, PM_GENERIC_DOMAINS if PM, EXYNOS_PM_DOMAINS if PM_GENERIC_DOMAINS
# (A:arch/arm64/Kconfig.platforms:128-137).
CONFIG_ARCH_EXYNOS=y
# PM makes PM_GENERIC_DOMAINS selectable; PM_GENERIC_DOMAINS_OF then defaults to y (A:kernel/power/Kconfig:
# 205,357,384), which gives boot-on domains stay_on. Stock IK:560,568.
CONFIG_PM=y
CONFIG_PM_GENERIC_DOMAINS=y
CONFIG_PM_GENERIC_DOMAINS_OF=y
# The providers L1 drives, all selected by the lines above (A:drivers/clk/samsung/Kconfig:75,
# A:drivers/pinctrl/samsung/Kconfig:22, A:drivers/pmdomain/samsung/Kconfig:4, A:drivers/soc/samsung/Kconfig:40;
# EXYNOS_PMU also builds exynos8895-pmu.o).
CONFIG_EXYNOS_ARM64_COMMON_CLK=y
CONFIG_PINCTRL_EXYNOS_ARM64=y
CONFIG_EXYNOS_PM_DOMAINS=y
CONFIG_EXYNOS_PMU=y

# Watchdog, built in so it binds (and stops a bootloader timer) before userspace. Stock IK:2541,2554.
# A:drivers/watchdog/Kconfig:7,568-572 (selects WATCHDOG_CORE, MFD_SYSCON).
CONFIG_WATCHDOG=y
CONFIG_S3C2410_WATCHDOG=y

# Restart (SWRESET), power-off (PS_HOLD bit 8) and the INFORM3 reboot-mode node (spec 4.3, 5.7).
# A:drivers/power/reset/Kconfig:2,286,294,312 (SYSCON_REBOOT_MODE selects REBOOT_MODE, :309).
# gki:490 sets only POWER_RESET_SYSCON.
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
CONFIG_SYSCON_REBOOT_MODE=y

# Lockup detection for the F2 check (spec 1 P10: "Watchdog detected hard LOCKUP", A:kernel/watchdog.c:223).
# Buddy detector: needs no Arm PMU interrupt (A:lib/Kconfig.debug:211,1149,1170). gki:824-825; stock IK:5152.
CONFIG_DEBUG_KERNEL=y
CONFIG_HARDLOCKUP_DETECTOR=y
CONFIG_HARDLOCKUP_DETECTOR_PREFER_BUDDY=y

# Event tracing for the L1-C run tokens "tp_printk trace_event=clk:clk_disable" (spec 5.10, 8.3;
# A:drivers/clk/clk.c:1507 trace_clk_disable). A:kernel/trace/Kconfig:139,194; stock IK:5218,5223.
CONFIG_FTRACE=y
CONFIG_EVENT_TRACING=y
