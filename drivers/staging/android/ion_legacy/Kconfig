config ION_LEGACY_EXYNOS
	bool "Legacy Android ION ABI for the Exynos 8895 blobs (/dev/ion)"
	depends on DMA_SHARED_BUFFER && DMA_CMA && OF_RESERVED_MEM
	select EXYNOS8895_SMC
	help
	  The 4.4 Exynos ION user ABI (client handles, ION_IOC_ALLOC/FREE/
	  SHARE/MAP/IMPORT/SYNC/SYNC_PARTIAL, 32-bit compat) on /dev/ion,
	  as its own dma-buf exporter over the page allocator and the
	  reusable CMA regions named in the "samsung,exynos8895-ion-legacy"
	  DT node. Needed by the prebuilt Samsung graphics and camera blobs
	  (libion_exynos.so, gralloc1, the camera HAL) of the greatlte
	  (Galaxy Note 8) port; spec L6A 5.2. An "ion,secure" region is served
	  as the iris secure_camera heap, protected through EL3 SMCs.
