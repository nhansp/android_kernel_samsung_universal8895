# WP-L4b: Exynos8895 FMP inline encryption (spec L4b_fmp_rng.md 5.3)
config SCSI_UFS_EXYNOS8895_FMP_VERIFIED
	bool "Exynos8895 FMP: advertise inline AES-256-XTS (key layout verified on hardware)"
	depends on SCSI_UFS_EXYNOS && SCSI_UFS_CRYPTO
	default n
	help
	  Switch the Exynos8895 UFS host to 128-byte PRDT entries (FMP
	  DESCTYPE 3) and advertise AES-256-XTS with 4096-byte data units to
	  blk-crypto, so that fscrypt can encrypt inline on "inlinecrypt"
	  mounts.

	  FMP only encrypts requests that carry a blk-crypto key, so an
	  unencrypted filesystem is stored as before; every transfer does use
	  the 128-byte PRDT format, as Samsung's kernel always did.

	  With N the host keeps the 16-byte PRDT and DESCTYPE 0, and fscrypt
	  uses the software fallback on "inlinecrypt" mounts. Both store the
	  same ciphertext, so a filesystem can move between the two.

config SCSI_UFS_EXYNOS8895_FMP_KAT
	bool "DEBUG: Exynos8895 FMP read-only known-answer test"
	depends on SCSI_UFS_EXYNOS=y && SCSI_UFS_CRYPTO && DEBUG_FS
	depends on GREATLTE_HB_L4B && CRYPTO_SKCIPHER=y
	default n
	help
	  Debug only (spec L4b 5.6, test T-L4b-2). Switches the Exynos8895
	  UFS host to 128-byte PRDT entries (FMP DESCTYPE 3) for every
	  transfer and adds the debugfs file greatlte-l4b/fmp_kat, which
	  reads one 4 KiB block through FMP with a test key in each
	  candidate key layout and compares the result with software
	  xts(aes). Only the test's own key is served natively: every other
	  key fails with -EIO while the layout is unverified. Never enable
	  in a release build; the first boot of such a kernel is read-only
	  (T-L4b-1a).
