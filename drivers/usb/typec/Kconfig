	  If you choose to build this driver as a dynamically linked module, the
	  module will be called wusb3801.ko.

source "drivers/usb/typec/mux/Kconfig"

source "drivers/usb/typec/altmodes/Kconfig"

# L6G: Samsung Galaxy Note 8 (greatlte) MUIC and Type-C port controller (spec L6G 6.2)
config TYPEC_MAX77865_MUIC
	bool "Maxim MAX77865 MUIC (D+/D- switch) base driver"
	depends on I2C && OF && TYPEC=y
	select REGMAP_I2C
	select AUXILIARY_BUS
	help
	  The MUIC of the Maxim MAX77865 PMIC (I2C 0x25) as used on the Samsung
	  Galaxy Note 8: routes D+/D- to the application processor's USB or UART
	  and switches BC1.2 charger detection on and off for the S2MM005 port
	  controller driver. Creates the auxiliary device of the AFC/QC module.
	  It writes no high-voltage register. Built in only: it reads the
	  pmic_info= boot parameter from the saved command line.

config TYPEC_S2MM005
	tristate "Samsung S2MM005 USB Type-C / PD port controller"
	depends on I2C && OF && TYPEC && USB_ROLE_SWITCH && TYPEC_MAX77865_MUIC
	help
	  The S2MM005 port controller of the Samsung Galaxy Note 8. Its
	  firmware runs Type-C and USB Power Delivery; the driver reads the
	  attach state and reports it through the Type-C class, the USB role
	  switch and the MAX77865 MUIC. It never selects a PD voltage and never
	  switches VBUS on unless the two options below are set.

config TYPEC_S2MM005_OTG_VBUS
	bool "Switch the OTG VBUS boost on for a USB host session"
	depends on TYPEC_S2MM005
	default n
	help
	  Let the port controller switch the phone's 5 V OTG boost on for a
	  USB host session. Raises VBUS: see spec L6H 1A SAFETY row V1. Enable
	  only with the user present. Say N.

config TYPEC_S2MM005_PD_SELECT
	bool "USB-PD sink voltage selection (charging path, see L6H SAFETY)"
	depends on TYPEC_S2MM005
	default n
	help
	  Lets the charger request USB-PD source voltages above 5 V (PDO
	  selection and the alternate-mode power negotiation command).
	  Charging path: see spec L6H 1A SAFETY. Enable only with the user
	  present. Say N.

endif # TYPEC
