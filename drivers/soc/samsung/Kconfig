# Samsung SoC drivers
#
menuconfig SOC_SAMSUNG
	bool "Samsung SoC driver support" if COMPILE_TEST

if SOC_SAMSUNG

# There is no need to enable these drivers for ARMv8
config EXYNOS_ASV_ARM
	bool "Exynos ASV ARMv7-specific driver extensions" if COMPILE_TEST
	depends on EXYNOS_CHIPID

config EXYNOS_CHIPID
	tristate "Exynos ChipID controller and ASV driver"
	depends on ARCH_EXYNOS || COMPILE_TEST
	default ARCH_EXYNOS
	select EXYNOS_ASV_ARM if ARM && ARCH_EXYNOS
	select MFD_SYSCON
	select SOC_BUS
	help
	  Support for Samsung Exynos SoC ChipID and Adaptive Supply Voltage.
	  This driver can also be built as module (exynos_chipid).

config EXYNOS_USI
	tristate "Exynos USI (Universal Serial Interface) driver"
	default ARCH_EXYNOS && ARM64
	depends on ARCH_EXYNOS || COMPILE_TEST
	select MFD_SYSCON
	help
	  Enable support for USI block. USI (Universal Serial Interface) is an
	  IP-core found in modern Samsung Exynos SoCs, like Exynos850 and
	  ExynosAutoV9. USI block can be configured to provide one of the
	  following serial protocols: UART, SPI or High Speed I2C.

	  This driver allows one to configure USI for desired protocol, which
	  is usually done in USI node in Device Tree.

config EXYNOS_PMU
	bool "Exynos PMU controller driver" if COMPILE_TEST
	depends on ARCH_EXYNOS || ((ARM || ARM64) && COMPILE_TEST)
	select EXYNOS_PMU_ARM_DRIVERS if ARM && ARCH_EXYNOS
	select MFD_CORE
	select REGMAP_MMIO

# There is no need to enable these drivers for ARMv8
config EXYNOS_PMU_ARM_DRIVERS
	bool "Exynos PMU ARMv7-specific driver extensions" if COMPILE_TEST
	depends on EXYNOS_PMU

config SAMSUNG_PM_CHECK
	bool "S3C2410 PM Suspend Memory CRC"
	depends on PM && (ARCH_S3C64XX || ARCH_S5PV210)
	select CRC32
	help
	  Enable the PM code's memory area checksum over sleep. This option
	  will generate CRCs of all blocks of memory, and store them before
	  going to sleep. The blocks are then checked on resume for any
	  errors.

	  Note, this can take several seconds depending on memory size
	  and CPU speed.

config SAMSUNG_PM_CHECK_CHUNKSIZE
	int "S3C2410 PM Suspend CRC Chunksize (KiB)"
	depends on PM && SAMSUNG_PM_CHECK
	default 64
	help
	  Set the chunksize in Kilobytes of the CRC for checking memory
	  corruption over suspend and resume. A smaller value will mean that
	  the CRC data block will take more memory, but will identify any
	  faults with better precision.

config EXYNOS_REGULATOR_COUPLER
	bool "Exynos SoC Regulator Coupler" if COMPILE_TEST
	depends on ARCH_EXYNOS || COMPILE_TEST

config GREATLTE_HB
	bool "Galaxy Note 8 (greatlte) bring-up heartbeat (debug only)"
	depends on ARCH_EXYNOS && PRINTK && OF
	select TRACEPOINTS
	help
	  Prints a fixed-format status snapshot at KERN_ERR every
	  hb.period_ms milliseconds for pstore-based bring-up debugging.
	  Never enable in a release build.

config GREATLTE_RAMCON
	bool "greatlte early RAM console into the ramoops dmesg zone (debug only)"
	depends on GREATLTE_HB
	select SERIAL_CORE
	select SERIAL_EARLYCON

config GREATLTE_LASTKMSG
	bool "greatlte console mirror into TWRP's /proc/last_kmsg (debug only)"
	depends on GREATLTE_HB && OF_RESERVED_MEM

config GREATLTE_HS
	bool "greatlte hand-off snapshot (hs), read-only (debug only)"
	depends on GREATLTE_HB
	help
	  Once, hs.at_ms after boot, reads the PMU, CMU, APM SRAM, DPU, UFS
	  and USB state the bootloader handed over and prints it through
	  the heartbeat printer hook. Nothing is written. For the L0
	  bring-up images only; never enable in a release build.

config GREATLTE_L1_SELFTEST
	bool "greatlte L1 platform self-test and clock gate census (debug only)"
	depends on ARCH_EXYNOS
	help
	  Bring-up diagnostics of the greatlte L1 layer (clocks, PMU, power
	  domains). This symbol first enables the read-only gate census in
	  exynos_arm64_init_clocks() (L1cmu/L1cg0 lines, spec L1 5.2); the
	  L1 self-test driver of spec L1 5.9 builds under the same symbol.
	  Never enable in a release build.

config GREATLTE_USB_DIAG
	bool "greatlte L3 USB diagnostics and heartbeat rows (debug only)"
	depends on GREATLTE_HB
	default GREATLTE_HB
	help
	  Bring-up diagnostics of the greatlte L3 layer (USB peripheral
	  mode, spec L3 8.1): the Exynos8895 USB PHY keeps a read-only
	  snapshot and reads CR[0x1002] before each re-tune, and the L3
	  heartbeat rows and printers ("usb", "usbid") read the dwc3, PHY,
	  CMU_FSYS0 and PMU state. On by default with the heartbeat; never
	  enable in a release build.

config GREATLTE_HB_L5
	bool "greatlte heartbeat: display (L5) printers dpu and dpuc (debug only)"
	depends on GREATLTE_HB
	default GREATLTE_HB
	help
	  Registers the L5 heartbeat printers "dpu" (the DPU registers S-Boot
	  left and their later state) and "dpuc" (the display drivers'
	  counters) once from a built-in initcall (T_tooling 5.7.6 contract
	  item 1). Driver counters are only collected from display drivers
	  that are built in. Never enable in a release build.
endif

config SAMSUNG_SEC_CLASS
	bool "Samsung \"sec\" device class"
	depends on ARCH_EXYNOS
	help
	  The /sys/class/sec class of Samsung stock kernels, whose device nodes
	  (tsp, led, ...) the LineageOS device HALs use. Provides
	  sec_device_create_with_groups() (include/linux/sec_sysfs.h). A prompt
	  rather than select-only, so the greatlte touch fragment can enable it
	  before the L6F LED and key drivers exist (spec L6F 5.9, 6).

config GREATLTE_HB_L6F
	bool "greatlte heartbeat: L6F (power/input/misc)"
	depends on GREATLTE_HB
	default GREATLTE_HB
	help
	  Registers the L6F heartbeat rows.

# L6T (Trustonic TEE): SMC helper of L6F 5.11 (users 6T-R/6T-S), secure RPMB proxy, secure log, heartbeat rows
config EXYNOS8895_SMC
	bool
	help
	  exynos8895_smc(): plain secure monitor calls to Samsung's EL3
	  monitor on the Exynos 8895 (spec L6F 5.11). Selected by its users.

config EXYNOS_UFS_SRPMB
	bool "Exynos secure RPMB proxy for the Trustonic TEE"
	depends on SCSI_UFSHCD && ARCH_EXYNOS
	select EXYNOS8895_SMC
	help
	  Forwards the RPMB requests of the Exynos 8895 secure world to the
	  UFS RPMB well-known LU (stock CONFIG_UFS_SRPMB, spec L6T 5.9).

config EXYNOS_SECURE_LOG
	bool "Exynos Secure Log"
	depends on ARCH_EXYNOS && OF_RESERVED_MEM
	select EXYNOS8895_SMC
	help
	  Support Exynos Secure Log

config GREATLTE_HB_L6T
	bool "greatlte heartbeat: L6T (Trustonic TEE)"
	depends on GREATLTE_HB
	default GREATLTE_HB
	help
	  Registers the L6T heartbeat rows.

# L6A slice ion
config GREATLTE_HB_L6A_ION
	bool "greatlte heartbeat: L6A legacy ION (debug only)"
	depends on GREATLTE_HB && ION_LEGACY_EXYNOS
	default GREATLTE_HB
	help
	  Registers the L6A heartbeat rows "ion" (legacy ION probe result)
	  and "ionb" (live ION buffers). Never enable in a release build.

# L6A S3CFB front-end (spec L6A 8.1): heartbeat rows s3f s3e s3t
config GREATLTE_HB_L6A_S3CFB
	bool "greatlte heartbeat: L6A S3CFB front-end"
	depends on GREATLTE_HB
	default GREATLTE_HB
	help
	  Registers the heartbeat rows of the S3CFB front-end: frames
	  applied, rejected commits and acquire-fence timeouts.

# L6A slice gpu: stock chip-id sysfs revision (L6A 5.4), GPU heartbeat rows (L6A 8.1)
config EXYNOS_CHIPID_LEGACY_SYSFS
	bool "Exynos stock /sys/devices/system/chip-id/revision"
	depends on EXYNOS_CHIPID
	help
	  Registers the "chip-id" system subsystem of the stock 4.4 driver
	  with its "revision" attribute ("%08X\n" of main_rev << 4 |
	  sub_rev), which the Exynos display HAL blob reads (spec L6A 5.4).

config GREATLTE_HB_L6A_GPU
	bool "greatlte heartbeat: L6A GPU"
	depends on GREATLTE_HB
	default GREATLTE_HB
	help
	  Registers the L6A GPU heartbeat rows.

# L6D PCIe RC0 heartbeat
config GREATLTE_HB_L6D_PCIE
	bool "greatlte heartbeat: L6D PCIe RC0"
	depends on GREATLTE_HB
	default GREATLTE_HB
	help
	  Registers the L6D PCIe heartbeat rows 'pcie' and 'pcii'.
# L6D Wi-Fi heartbeat
config GREATLTE_HB_L6D_WIFI
	bool "greatlte heartbeat: L6D Wi-Fi"
	depends on GREATLTE_HB
	default GREATLTE_HB
	help
	  Registers the L6D Wi-Fi heartbeat rows 'wlan' and 'wlw'.

# L6D slice bt
config GREATLTE_HB_L6D_BT
	bool "greatlte heartbeat: L6D Bluetooth (bt, btw)"
	depends on GREATLTE_HB
	default GREATLTE_HB
	help
	  Registers the L6D Bluetooth heartbeat rows.

# DEBUG: CoreSight PC sampling at panic
config GREATLTE_CSPC
	bool "greatlte: sample the other CPUs' PCs at panic (debug only)"
	depends on GREATLTE_HB && ARCH_EXYNOS && OF && ARM64
	default GREATLTE_HB
	help
	  At panic, reads the program counter of every other online CPU
	  through its CoreSight external debug block (EDPCSR), five times,
	  as the stock kernel's EXYNOS_CORESIGHT_PC_INFO did. It names the
	  code a CPU hangs in with its interrupts masked, which an IPI
	  backtrace cannot reach on this GICv2 SoC. Also a debugfs trigger,
	  greatlte-cspc. Never enable in a release build.
# L6F slice fp (WP-6F)
config GREATLTE_HB_L6F_FP
	bool "greatlte heartbeat: L6F fingerprint (fp, fpi)"
	depends on GREATLTE_HB
	default GREATLTE_HB
	help
	  Registers the L6F fingerprint heartbeat rows.
# L6C modem + sensor hub heartbeat
config GREATLTE_HB_L6C
	bool "greatlte heartbeat: L6C modem and sensor hub"
	depends on GREATLTE_HB
	default GREATLTE_HB
	help
	  Registers the L6C heartbeat rows cp, cpmb, hub and l38.
# L7 (power management): system suspend (SLEEP), SICD, PM-DVS; the PMU CPU hooks in exynos8895-pmu.c
config EXYNOS8895_PM
	bool "Exynos 8895 system suspend (SLEEP), PM-DVS and SICD support"
	depends on SOC_SAMSUNG
	depends on ARCH_EXYNOS && ARM64 && EXYNOS_PMU && SUSPEND && ARM_PSCI_FW
	depends on EXYNOS_ACPM_PROTOCOL=y
	help
	  System suspend to the stock SLEEP mode with the PMUCAL sequences,
	  the SICD entry/exit and veto used by the Exynos 8895 cpuidle
	  driver, the BUCK8-11 suspend voltages and the PMU CPU/cluster
	  power hooks for deep idle and CPU hotplug (spec L7 5.3, 5.5).

# L7 heartbeat printers L7, L7t, L7kg (spec L7 5.8)
config GREATLTE_HB_L7
	bool "greatlte heartbeat: L7 deep idle and suspend printers (debug only)"
	depends on GREATLTE_HB && EXYNOS8895_PM
	default GREATLTE_HB
	help
	  Registers the L7 heartbeat printers "L7" (C2/CPD/SICD counters,
	  last SICD veto, PMU core and cluster status) and "L7t" (arch
	  counter and RTC across the last suspend), and the S2MPS17 RTC
	  UPDATE read-back lines. Never enable in a release build.

config GREATLTE_HB_L7_KG
	bool "greatlte heartbeat: L7 kept-gate dump around suspend (debug only)"
	depends on GREATLTE_HB_L7
	help
	  Adds the "L7kg" printer: the 143 L1-kept CMU gate registers that
	  differ before and after the last suspend (spec L7 P17, T7-KG).
	  Only for the T7-KG boot.

# L2b bus DVFS heartbeat rows (DEBUG)
config GREATLTE_HB_L2B
	bool "greatlte heartbeat: L2b bus DVFS (debug only)"
	depends on GREATLTE_HB && ARM_EXYNOS8895_BUS_DEVFREQ
	default GREATLTE_HB
	help
	  Registers the L2b heartbeat rows (bus devices, their ACPM clocks,
	  the bus driver state, the MIF and DISP CMU read-back), the debugfs
	  files exynos8895-bus/mif_hw_khz and disp_hw_khz and the
	  int_test_khz parameter. Never enable in a release build.

# L2b: Exynos8895 bus traffic shaper (BTS, spec L2b 5.5, 6.2)
config EXYNOS8895_BTS_BW
	bool "Exynos8895 bus bandwidth to MIF/INT floors (BTS arithmetic)"
	depends on ARM_EXYNOS8895_BUS_DEVFREQ
	default ARM_EXYNOS8895_BUS_DEVFREQ

config EXYNOS8895_BTS
	bool "Bus traffic shaper support"
	depends on ARCH_EXYNOS && EXYNOS8895_BTS_BW
	help
	  Enable BTS (Bus traffic shaper) support
